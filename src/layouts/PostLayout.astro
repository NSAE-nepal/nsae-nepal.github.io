---
import { Image } from "astro:assets";
import { IconArrowLeft } from "@tabler/icons-astro";
import AvatarGroup from "@/components/astro/AvatarGroup.astro";
import BlogCard from "@/components/astro/Card/BlogCard.astro";
import ClickableCard from "@/components/astro/Card/ClickableCard.astro";
import Categories from "@/components/Categories.astro";
import { formatName } from "@/lib/utils";
import type { Post, PostDetails } from "@/sanity/lib/queries/posts";
import FormattedDate from "../components/FormattedDate.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { articleLd, breadcrumbLd } from "@/lib/structured-data";
import PageLayout from "./PageLayout.astro";
import { sanityImage } from "@/sanity/lib/url-for-image";

type Props = PostDetails & {
  /** Suggested posts for the "Keep reading" section (see getRelatedPosts). */
  related?: Post[];
};

const {
  title,
  subtitle,
  categories,
  description,
  publishedAt,
  heroImage,
  heroImageAlt,
  type,
  showToc,
  related = [],
} = Astro.props;

const relatedHref = (post: Post) =>
  `/${post.type === "notice" ? "notices" : "blog"}/${post.slug}/`;

const backLinkConfig: Record<string, { href: string; label: string }> = {
  blog: { href: "/blog/page/1", label: "Back to All Blogs" },
  notice: { href: "/notices/page/1", label: "Back to All Notices" },
};

const { href: backHref, label: backLabel } =
  backLinkConfig[type] || backLinkConfig.blog;

const site = Astro.site!;
// Skip dangling references (deleted authors come back as null).
const bylineAuthors = (Astro.props.authors ?? []).filter(Boolean);
const section = type === "notice" ? "notices" : "blog";
const structuredData = [
  articleLd(Astro.props, site),
  breadcrumbLd(
    [
      { name: "Home", path: "/" },
      { name: type === "notice" ? "Notices" : "Blog", path: `/${section}/page/1/` },
      { name: title, path: `/${section}/${Astro.props.slug}/` },
    ],
    site,
  ),
];
---

<PageLayout
  title={title}
  description={description || subtitle || title}
  image={heroImage || `/og/${section}/${Astro.props.slug}.png`}
  type="article"
>
  <JsonLd slot="head" data={structuredData} />
  <article class="py-8 space-y-10" data-pagefind-body>
    <header class="space-y-8 border-b border-border pb-10">
      <a
        data-pagefind-ignore
        href={backHref}
        class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors px-4"
      >
        <IconArrowLeft class="size-4" />
        {backLabel}
      </a>
      <div class="space-y-4 text-center">
        <h1
          class="font-sans text-3xl md:text-5xl font-medium tracking-tighter first-letter:capitalize"
          data-pagefind-meta="title"
        >
          {title}
        </h1>
        {
          subtitle && (
            <p
              data-pagefind-meta="sub_title"
              class="font-sans text-lg text-muted-foreground leading-relaxed first-letter:capitalize max-w-3xl mx-auto"
            >
              {subtitle}
            </p>
          )
        }
        {
          bylineAuthors.length > 0 && (
            <div
              class="flex flex-wrap items-center justify-center gap-3 pt-2"
              data-pagefind-ignore
            >
              <AvatarGroup data={bylineAuthors} />
              <p class="font-sans text-sm text-muted-foreground">
                By{" "}
                {bylineAuthors.map((author, index) => (
                  <>
                    {index > 0 &&
                      (index === bylineAuthors.length - 1 ? " and " : ", ")}
                    {author.slug ? (
                      <a
                        href={`/authors/${author.slug}/`}
                        class="font-medium text-foreground underline-offset-4 hover:text-primary hover:underline"
                      >
                        {formatName(author.name, author.prefix)}
                      </a>
                    ) : (
                      <span class="font-medium text-foreground">
                        {formatName(author.name, author.prefix)}
                      </span>
                    )}
                  </>
                ))}
              </p>
            </div>
          )
        }
      </div>

      <div class="flex flex-row justify-around items-center text-xs">
        {
          categories?.length > 0 ? (
            <Categories categories={categories} />
          ) : (
            <div />
          )
        }

        {
          publishedAt && (
            <span
              class="font-mono text-xs text-muted-foreground uppercase tracking-wider border-l border-border/50 pl-6"
              data-pagefind-meta={`date:${publishedAt}`}
              data-pagefind-ignore
            >
              <FormattedDate date={new Date(publishedAt)} />
            </span>
          )
        }
      </div>
    </header>

    {
      heroImage && (
        <div class="flex items-center justify-center overflow-hidden">
          <Image
            data-pagefind-meta="image[src], image_alt[alt]"
            inferSize
            class="object-cover rounded-xl max-h-1/2"
            src={sanityImage(heroImage, { width: 1600 })}
            widths={[640, 1024, 1600]}
            sizes="(min-width: 1280px) 1280px, 100vw"
            loading="eager"
            alt={heroImageAlt ?? ""}
          />
        </div>
      )
    }

    <div class={`mx-auto max-w-7xl ${showToc ? "xl:flex xl:gap-12" : ""}`}>
      <div class="prose w-full min-w-0 max-w-none dark:prose-invert">
        <slot />
      </div>

      {
        showToc && (
          <div class="hidden xl:block xl:w-64 xl:shrink-0">
            <div class="sticky top-24 max-h-[calc(100vh-6rem)] overflow-y-auto">
              <slot name="toc" />
            </div>
          </div>
        )
      }
    </div>

    {
      related.length > 0 && (
        <section
          class="border-t border-border/50 pt-12 space-y-8"
          aria-labelledby="keep-reading"
          data-pagefind-ignore
        >
          <div class="flex flex-col text-center gap-2">
            <h2
              id="keep-reading"
              class="font-sans text-2xl font-medium tracking-tight"
            >
              Keep reading
            </h2>
            <p class="font-sans text-muted-foreground">
              More from NSAE on similar topics
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {related.map((post) => (
              <ClickableCard
                href={relatedHref(post)}
                label={post.title}
                class="group relative rounded-xl border border-border/60 hover:bg-secondary/60 transition-colors"
              >
                <BlogCard data={post} href={relatedHref(post)} />
              </ClickableCard>
            ))}
          </div>
        </section>
      )
    }
  </article>
</PageLayout>
