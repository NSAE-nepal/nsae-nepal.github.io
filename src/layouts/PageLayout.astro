---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  dataPagefindIgnore?: "index" | "all";
}

const { title, description, image, dataPagefindIgnore } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <ClientRouter />
  </head>
  <body class="m-3 lg:m-4" data-pagefind-ignore={dataPagefindIgnore}>
    <Header />
    <main class="min-h-screen">
      <slot />
    </main>
    <Footer />
  </body>
</html>
