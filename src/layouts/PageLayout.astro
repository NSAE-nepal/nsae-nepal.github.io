---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  /** Social preview image: a local import or a Sanity image URL. */
  image?: ImageMetadata | string;
  type?: "website" | "article" | "profile";
  dataPagefindIgnore?: "index" | "all";
}

const { title, description, image, type, dataPagefindIgnore } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
    />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="m-3 lg:m-4" data-pagefind-ignore={dataPagefindIgnore}>
    <Header />
    <main class="min-h-screen">
      <slot />
    </main>
    <Footer />
    <script>
      import "@/scripts/visit-tracker";
    </script>
  </body>
</html>
