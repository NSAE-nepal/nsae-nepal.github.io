---
import { IconArrowLeft } from "@tabler/icons-astro";
import ShareBar from "@/components/ShareBar.astro";
import PageLayout from "./PageLayout.astro";

/**
 * Shared shell for long-form detail pages (blog posts, notices, library
 * resources) so they look and behave the same: back link, centred title and
 * subtitle, meta row, optional hero, prose body with optional table of
 * contents, share bar, "Keep reading" grid and a reading-progress bar.
 *
 * Slots: `head` (JSON-LD), `filters` (hidden Pagefind filters), `byline`,
 * `meta-start` / `meta-end` (the row under the title), `hero`, default (body),
 * `toc`, `related` (cards for the "Keep reading" grid).
 */
interface Props {
  title: string;
  subtitle?: string;
  /** Meta description; falls back to the subtitle, then the title. */
  description?: string;
  /** Social preview image (Sanity URL or /og/... path). */
  image?: string;
  /** Alt text for `image`; defaults to the title. */
  imageAlt?: string;
  backHref: string;
  backLabel: string;
  /** Pagefind `type:` filter value, e.g. "Blog". */
  searchType: string;
  shareLabel: string;
  sharePath: string;
  showToc?: boolean;
  relatedTitle?: string;
  relatedSubtitle?: string;
}

const {
  title,
  subtitle,
  description,
  image,
  imageAlt,
  backHref,
  backLabel,
  searchType,
  shareLabel,
  sharePath,
  showToc = false,
  relatedTitle = "Keep reading",
  relatedSubtitle = "More from NSAE on similar topics",
} = Astro.props;

// A slot passed inside a condition counts as "present" even when it renders
// nothing, so check the rendered output before showing the section.
const relatedCards = Astro.slots.has("related")
  ? (await Astro.slots.render("related")).trim()
  : "";
---

<PageLayout
  title={title}
  description={description || subtitle || title}
  image={image}
  imageAlt={imageAlt}
  type="article"
>
  <slot name="head" slot="head" />
  <div
    class="pointer-events-none fixed inset-x-0 top-0 z-50 h-1 origin-left scale-x-0 bg-primary"
    data-reading-progress
    aria-hidden="true"
  >
  </div>
  <article
    class="space-y-10 py-8"
    data-pagefind-body
    data-pagefind-filter={`type:${searchType}`}
  >
    <slot name="filters" />
    <header class="space-y-8 border-b border-border pb-10">
      <a
        data-pagefind-ignore
        href={backHref}
        class="inline-flex items-center gap-2 px-4 font-mono text-xs tracking-widest text-muted-foreground uppercase transition-colors hover:text-primary"
      >
        <IconArrowLeft class="size-4" />
        {backLabel}
      </a>
      <div class="space-y-4 text-center">
        <h1
          class="font-sans text-3xl font-medium tracking-tighter first-letter:capitalize md:text-5xl"
          data-pagefind-meta="title"
        >
          {title}
        </h1>
        {
          subtitle && (
            <p
              data-pagefind-meta="sub_title"
              class="mx-auto max-w-3xl font-sans text-lg leading-relaxed text-muted-foreground first-letter:capitalize"
            >
              {subtitle}
            </p>
          )
        }
        <slot name="byline" />
      </div>

      <div class="flex flex-row items-center justify-around text-xs">
        <slot name="meta-start"><div></div></slot>
        <slot name="meta-end" />
      </div>
    </header>

    <slot name="hero" />

    <div class={`mx-auto max-w-7xl ${showToc ? "xl:flex xl:gap-12" : ""}`}>
      <div
        class="prose w-full max-w-none min-w-0 dark:prose-invert"
        data-reading-target
      >
        <slot />
      </div>

      {
        showToc && (
          <div class="hidden xl:block xl:w-64 xl:shrink-0">
            <div class="sticky top-24 max-h-[calc(100vh-6rem)] overflow-y-auto">
              <slot name="toc" />
            </div>
          </div>
        )
      }
    </div>

    <ShareBar
      class="justify-center border-t border-border/50 pt-8"
      label={shareLabel}
      title={title}
      text={subtitle || title}
      url={sharePath}
    />

    {
      relatedCards && (
        <section
          class="space-y-8 border-t border-border/50 pt-12"
          aria-labelledby="keep-reading"
          data-pagefind-ignore
        >
          <div class="flex flex-col gap-2 text-center">
            <h2
              id="keep-reading"
              class="font-sans text-2xl font-medium tracking-tight"
            >
              {relatedTitle}
            </h2>
            <p class="font-sans text-muted-foreground">{relatedSubtitle}</p>
          </div>

          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            <Fragment set:html={relatedCards} />
          </div>
        </section>
      )
    }
  </article>
</PageLayout>

<script>
  // Thin bar at the top of article pages that fills as you read the body.
  let cleanup: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = undefined;
    const bar = document.querySelector<HTMLElement>("[data-reading-progress]");
    const target = document.querySelector<HTMLElement>("[data-reading-target]");
    if (!bar || !target) return;

    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = target.getBoundingClientRect();
      const scrollable = rect.height - window.innerHeight;
      const progress =
        scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 1;
      bar.style.transform = `scaleX(${progress})`;
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
    cleanup = () => {
      cancelAnimationFrame(frame);
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", schedule);
    };
  });

  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
