---
import { Image } from "astro:assets";
import {
  IconBuildingBank,
  IconCopy,
  IconHeart,
  IconMicroscope,
  IconSchool,
  IconUsers,
} from "@tabler/icons-astro";
import DonateHeroImage from "@/assets/donate/donate-hero.avif";
import Badge from "@/components/astro/Badge.astro";
import Button from "@/components/astro/Button/Button.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { getDonateDetails } from "@/sanity/lib/queries/donate";
import { sanityImage } from "@/sanity/lib/url-for-image";

const impactAreas = [
  {
    title: "Engineering Professional Development",
    icon: "School",
    description:
      "Conducting various activities for professional development of agricultural engineers.",
  },
  {
    title: "Research and Development",
    icon: "Microscope",
    description:
      "Conducting research for the development of agriculture and engineering to solve the problems of society.",
  },
  {
    title: "Community Outreach",
    icon: "Users",
    description:
      "Organizing workshops and technical training for farmers in rural areas.",
  },
];

const data = await getDonateDetails();

if (!data) {
  throw new Error(
    'Donate page data not found: publish the "donate" document in Sanity.',
  );
}

const iconMap: Record<string, typeof IconSchool> = {
  School: IconSchool,
  Microscope: IconMicroscope,
  Users: IconUsers,
};
---

<PageLayout
  title="Donate"
  description="Support the mission of the Nepalese Society of Agricultural Engineers."
  dataPagefindIgnore="all"
  page="donate"
>
  <section
    class="donate-hero-section relative flex min-h-[60vh] items-center overflow-hidden rounded-2xl px-6 py-20 text-white md:min-h-[70vh] md:px-12 md:py-32"
  >
    <div
      class="anim-hero-vertical-text absolute top-32 left-6 z-20 hidden opacity-0 md:left-12 md:block"
    >
      <span
        class="vertical-lr font-mono text-xs tracking-widest text-white/60 uppercase"
      >
        [ SUPPORT US ]
      </span>
    </div>

    <div class="relative z-20 mt-12 flex max-w-4xl flex-col gap-6 md:gap-8">
      <div class="anim-hero-badge translate-y-4 opacity-0">
        <Badge
          variant="outline"
          class="w-fit border-white/30 font-mono text-xs tracking-widest text-white uppercase"
        >
          Make an Impact
        </Badge>
      </div>

      <h1
        class="font-sans text-5xl leading-[0.9] font-medium tracking-tighter md:text-7xl lg:text-8xl"
      >
        <span class="anim-split-text inline-block">Empower the</span>
        <br />
        <span class="anim-split-text inline-block text-white/80"
          >Engineers of Tomorrow</span
        >
      </h1>

      <p
        class="anim-hero-desc max-w-2xl translate-y-4 font-sans text-lg leading-relaxed text-white/90 opacity-0 md:text-xl"
      >
        Your contribution helps us advance agricultural engineering in Nepal
        through scholarships, research, and community development.
      </p>
    </div>

    <div class="absolute inset-0 z-10">
      <div
        class="absolute inset-0 z-20 bg-gradient-to-r from-black/90 via-black/60 to-black/20"
      >
      </div>
      <div class="absolute inset-0 z-10 bg-black/20"></div>
      <Image
        class="anim-hero-image absolute inset-0 h-full w-full scale-110 object-cover"
        alt="Giving back to the community"
        src={DonateHeroImage}
        loading="eager"
      />
    </div>
  </section>

  <div class="space-y-12 py-24">
    <section class="impact-section border-b border-border/50 pb-12">
      <div
        class="flex flex-col items-start justify-between gap-12 lg:flex-row lg:gap-24"
      >
        <div class="flex flex-col gap-4 lg:sticky lg:top-32 lg:w-1/3">
          <div class="anim-impact-header flex items-center gap-4 opacity-0">
            <Badge
              class="font-mono text-xs tracking-widest uppercase"
              size="sm"
            >
              ( 01 )
            </Badge>
            <span
              class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
            >
              Why Donate?
            </span>
          </div>
          <h2
            class="anim-split-heading font-sans text-4xl leading-tight font-medium tracking-tighter text-balance md:text-5xl"
          >
            Where your money goes.
          </h2>
          <div class="anim-impact-desc translate-y-4 opacity-0">
            <p class="font-sans text-lg leading-relaxed text-muted-foreground">
              NSAE is a non-profit organization. 100% of your donations go
              directly towards our mission-driven initiatives.
            </p>
          </div>
        </div>

        <div class="grid gap-6 lg:w-2/3">
          {
            impactAreas.map((area) => {
              const IconComponent = iconMap[area.icon] || IconHeart;

              return (
                <div class="anim-impact-card flex translate-y-12 flex-col items-center gap-6 rounded-2xl border border-border/50 bg-secondary/30 p-8 opacity-0 transition-colors hover:border-primary/50 md:flex-row">
                  <div class="h-fit shrink-0 rounded-lg bg-primary/10 p-2 text-primary">
                    <IconComponent class="size-6" />
                  </div>

                  <div class="space-y-2">
                    <h3 class="font-sans text-xl font-medium text-foreground">
                      {area.title}
                    </h3>
                    <p class="font-sans leading-relaxed text-muted-foreground">
                      {area.description}
                    </p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="methods-section">
      <div
        class="mb-12 flex flex-col items-end justify-between gap-6 md:flex-row"
      >
        <div class="space-y-4">
          <div
            class="anim-methods-header mb-4 flex items-center gap-4 opacity-0"
          >
            <Badge
              class="font-mono text-xs tracking-widest uppercase"
              size="sm"
            >
              ( 02 )
            </Badge>
            <span
              class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
            >
              Payment Methods
            </span>
          </div>
          <h2
            class="anim-split-heading font-sans text-4xl font-medium tracking-tighter text-balance md:text-5xl"
          >
            Ways to Give
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-8 md:gap-12 lg:grid-cols-2">
        <div
          class="anim-method-card relative translate-y-12 overflow-hidden rounded-3xl border border-border/50 bg-gradient-to-br from-gray-900 to-gray-800 p-8 text-white opacity-0 shadow-xl md:p-10"
        >
          <div class="absolute top-0 right-0 p-8 opacity-10">
            <IconBuildingBank class="size-64 -rotate-12" />
          </div>

          <div class="relative z-10 flex h-full flex-col justify-between gap-8">
            <div class="flex items-start justify-between">
              <div class="space-y-1">
                <p
                  class="font-mono text-xs tracking-widest uppercase opacity-60"
                >
                  Direct Bank Transfer
                </p>
                <h3 class="font-sans text-2xl font-medium">
                  {data.bankDetails?.bankName}
                </h3>
              </div>
              <IconBuildingBank class="size-8 opacity-80" />
            </div>

            <div class="space-y-6">
              <div>
                <p
                  class="mb-2 font-mono text-[10px] tracking-widest uppercase opacity-60"
                >
                  Account Number
                </p>
                <div class="flex items-center gap-4">
                  <p
                    class="font-mono text-2xl font-medium tracking-widest md:text-3xl"
                    id="account-number"
                  >
                    {data.bankDetails?.accountNumber}
                  </p>
                  <button
                    id="copy-btn"
                    class="rounded-full bg-white/10 p-2 transition-colors hover:bg-white/20"
                    aria-label="Copy Account Number"
                  >
                    <IconCopy class="size-4" />
                  </button>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <p
                    class="mb-1 font-mono text-[10px] tracking-widest uppercase opacity-60"
                  >
                    Account Name
                  </p>
                  <p class="font-sans text-sm opacity-90">
                    {data.bankDetails?.accountName}
                  </p>
                </div>
                <div>
                  <p
                    class="mb-1 font-mono text-[10px] tracking-widest uppercase opacity-60"
                  >
                    Branch
                  </p>
                  <p class="font-sans text-sm opacity-90">
                    {data.bankDetails?.branch}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div
          class="anim-method-card flex translate-y-12 flex-col items-center justify-center gap-6 rounded-3xl border border-border/50 bg-secondary/30 p-8 text-center opacity-0 md:p-10"
        >
          <div class="space-y-2">
            <h3 class="font-sans text-2xl font-medium">Scan to Donate</h3>
            <p class="mx-auto max-w-sm text-muted-foreground">
              Use your preferred digital wallet (eSewa, Khalti, Fonepay) to scan
              and donate instantly.
            </p>
          </div>

          <div
            class="flex aspect-square w-full max-w-[250px] items-center justify-center rounded-xl border border-border bg-white p-4 shadow-sm"
          >
            <Image
              src={sanityImage(data.bankDetails?.accountQRCode, { width: 500 })}
              alt="Donation QR Code"
              class="h-full w-full object-contain"
              inferSize
            />
          </div>

          <p
            class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
          >
            Accepted: Fonepay • eSewa • Khalti
          </p>
        </div>
      </div>
    </section>

    <section class="pb-12">
      <div
        class="anim-cta-box flex scale-95 flex-col items-center gap-6 rounded-3xl border border-primary/10 bg-primary/5 p-8 text-center opacity-0 md:p-12"
      >
        <div
          class="flex size-12 items-center justify-center rounded-full text-primary"
        >
          <IconHeart class="size-6" />
        </div>
        <h2 class="font-sans text-2xl font-medium tracking-tight md:text-3xl">
          Thank you for your support
        </h2>
        <p class="max-w-xl text-muted-foreground">
          Have questions about donations or need a receipt? Please contact our
          treasurer directly.
        </p>
        <Button
          href="/contact"
          variant="outline"
          class="rounded-full font-mono text-xs tracking-widest uppercase"
        >
          Contact Us
        </Button>
      </div>
    </section>
  </div>
</PageLayout>

<script>
  import { gsap, SplitText } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-page="donate"]', ({ root, signal, onCleanup }) => {
    const copyBtn = root.querySelector<HTMLElement>("#copy-btn");
    const accountNum = root.querySelector<HTMLElement>("#account-number");

    if (copyBtn && accountNum) {
      const originalIcon = copyBtn.innerHTML;
      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      onCleanup(() => clearTimeout(resetTimer));

      copyBtn.addEventListener(
        "click",
        () => {
          const text = accountNum.innerText.replace(/\s/g, "");
          navigator.clipboard.writeText(text).then(() => {
            copyBtn.innerHTML =
              '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></svg>';
            clearTimeout(resetTimer);
            resetTimer = setTimeout(() => {
              copyBtn.innerHTML = originalIcon;
            }, 2000);
          });
        },
        { signal },
      );
    }

    const heroTl = gsap.timeline({
      defaults: { ease: "power3.out" },
    });

    const heroSplit = SplitText.create(".anim-split-text", {
      type: "lines",
      linesClass: "line-inner overflow-hidden",
    });

    heroTl.from(
      ".anim-hero-image",
      {
        scale: 1.2,
        duration: 2.5,
        ease: "expo.out",
      },
      0,
    );

    heroTl.to(
      ".anim-hero-vertical-text",
      {
        opacity: 1,
        y: 0,
        startAt: { y: -20 },
        duration: 1.5,
      },
      0.2,
    );

    heroTl.to(
      ".anim-hero-badge",
      {
        opacity: 1,
        y: 0,
        duration: 1,
      },
      0.3,
    );

    heroTl.set(".anim-split-text", { autoAlpha: 1 }, 0.4);
    heroTl.from(
      heroSplit.lines,
      {
        yPercent: 100,
        opacity: 0,
        duration: 1.2,
        stagger: 0.1,
        ease: "power4.out",
      },
      0.4,
    );

    heroTl.to(
      ".anim-hero-desc",
      {
        y: 0,
        opacity: 1,
        duration: 1,
      },
      0.8,
    );

    gsap.to(".anim-hero-image", {
      yPercent: 20,
      ease: "none",
      scrollTrigger: {
        trigger: ".donate-hero-section",
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });

    const impactSplit = SplitText.create(
      ".impact-section .anim-split-heading",
      {
        type: "lines, words",
        linesClass: "overflow-hidden",
      },
    );

    const impactTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".impact-section",
        start: "top 75%",
      },
    });

    impactTl
      .to(".anim-impact-header", { opacity: 1, duration: 0.5 })
      .set(".impact-section .anim-split-heading", { autoAlpha: 1 }, "-=0.3")
      .from(
        impactSplit.words,
        {
          yPercent: 100,
          duration: 0.8,
          stagger: 0.02,
          ease: "power4.out",
        },
        "<",
      )
      .to(
        ".anim-impact-desc",
        {
          opacity: 1,
          y: 0,
          duration: 0.5,
        },
        "-=0.4",
      )
      .to(
        ".anim-impact-card",
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.1,
          ease: "power3.out",
        },
        "-=0.3",
      );

    const methodsSplit = SplitText.create(
      ".methods-section .anim-split-heading",
      {
        type: "lines, chars",
        linesClass: "overflow-hidden",
      },
    );

    const methodsTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".methods-section",
        start: "top 70%",
      },
    });

    methodsTl
      .to(".anim-methods-header", { opacity: 1, duration: 0.5 })
      .set(".methods-section .anim-split-heading", { autoAlpha: 1 }, "-=0.3")
      .from(
        methodsSplit.chars,
        {
          opacity: 0,
          y: 20,
          duration: 0.5,
          stagger: 0.02,
          ease: "back.out",
        },
        "<",
      )
      .to(
        ".anim-method-card",
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: "power3.out",
        },
        "-=0.3",
      );

    gsap.to(".anim-cta-box", {
      opacity: 1,
      scale: 1,
      duration: 1,
      ease: "elastic.out(1, 0.75)",
      scrollTrigger: {
        trigger: ".anim-cta-box",
        start: "top 85%",
      },
    });
  });
</script>
