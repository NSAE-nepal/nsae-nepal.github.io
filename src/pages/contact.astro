---
import {
  IconArrowUpRight,
  IconBrandBluesky,
  IconBrandFacebook,
  IconBrandGithub,
  IconBrandLinkedin,
  IconBrandX,
  IconBrandYoutube,
  IconMail,
  IconMap,
  IconPhone,
} from "@tabler/icons-astro";
import Badge from "@/components/astro/Badge.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { getContactsDetails } from "@/sanity/lib/queries/contacts";

const data = await getContactsDetails();
const socials = data?.socials;
const socialIcons: Record<string, typeof IconBrandX> = {
  linkedin: IconBrandLinkedin,
  twitter: IconBrandX,
  x: IconBrandX,
  facebook: IconBrandFacebook,
  youtube: IconBrandYoutube,
  bluesky: IconBrandBluesky,
  github: IconBrandGithub,
};
---

<PageLayout
  title="Contact Us"
  description="Have a question or a project in mind? Get in touch with the Nepalese Society of Agricultural Engineers."
  dataPagefindIgnore="all"
  page="contact"
>
  <header
    class="contact-header flex flex-col items-center justify-center px-4 py-16 text-center md:py-24"
  >
    <div class="anim-header-badge js:scale-50 js:opacity-0">
      <Badge
        variant={"secondary"}
        size={"sm"}
        class="mb-6 font-mono text-xs tracking-widest uppercase"
      >
        Contact us
      </Badge>
    </div>
    <h1
      class="anim-header-title pb-4 font-sans text-5xl font-medium tracking-tighter md:text-7xl js:invisible"
    >
      Get in touch
    </h1>
    <p
      class="anim-header-desc max-w-2xl font-sans text-xl leading-relaxed text-muted-foreground js:translate-y-4 js:opacity-0"
    >
      Have a question or a project in mind? We'd love to hear from you.
    </p>
  </header>

  <section class="grid grid-cols-1 gap-6 px-4 pb-24 lg:grid-cols-3">
    <div
      class="anim-contact-card col-span-1 flex flex-col justify-between gap-12 rounded-2xl border border-border/50 bg-secondary/30 p-8 transition-colors hover:bg-secondary/50 js:translate-y-8 js:opacity-0"
    >
      <div class="space-y-6">
        <span
          class="flex items-center gap-2 font-mono text-xs tracking-widest text-muted-foreground uppercase"
        >
          <IconMail class="size-4" /> Email
        </span>
        {
          data.emails && data.emails.length > 0 && (
            <div class="flex flex-col gap-2">
              {data.emails.map((email) => (
                <a
                  href={`mailto:${email}`}
                  class="block w-fit font-sans text-2xl font-medium tracking-tight transition-colors hover:text-primary"
                >
                  {email}
                </a>
              ))}
            </div>
          )
        }
      </div>
      <span class="font-sans text-sm text-muted-foreground">
        Reach out via email with any questions before our call!
      </span>
    </div>

    <div
      class="anim-contact-card col-span-1 flex flex-col justify-between gap-12 rounded-2xl border border-border/50 bg-secondary/30 p-8 transition-colors hover:bg-secondary/50 js:translate-y-8 js:opacity-0"
    >
      <div class="space-y-6">
        <span
          class="flex items-center gap-2 font-mono text-xs tracking-widest text-muted-foreground uppercase"
        >
          <IconPhone class="size-4" /> Phone
        </span>
        {
          data.phoneNumbers && data.phoneNumbers.length > 0 && (
            <div class="flex flex-col gap-2">
              {data.phoneNumbers.map((phone) => (
                <a
                  href={`tel:${phone}`}
                  class="block w-fit font-sans text-2xl font-medium tracking-tight transition-colors hover:text-primary"
                >
                  {phone}
                </a>
              ))}
            </div>
          )
        }
      </div>
      <span class="font-sans text-sm text-muted-foreground">
        You can reach out to us by phone to discuss your needs.
      </span>
    </div>

    <div
      class="anim-contact-card col-span-1 flex flex-col justify-between gap-12 rounded-2xl border border-border/50 bg-secondary/30 p-8 transition-colors hover:bg-secondary/50 js:translate-y-8 js:opacity-0"
    >
      <div class="space-y-6">
        <span
          class="flex items-center gap-2 font-mono text-xs tracking-widest text-muted-foreground uppercase"
        >
          <IconMap class="size-4" /> Visit us
        </span>
        <div class="font-sans text-2xl font-medium tracking-tight">
          {
            data.addressLink ? (
              <a
                href={data.addressLink}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-start gap-2 transition-colors hover:text-primary"
              >
                {data.address ?? "View on map"}
                <IconArrowUpRight class="mt-1 size-6 shrink-0 text-muted-foreground transition-colors group-hover:text-primary" />
              </a>
            ) : (
              <span>{data.address ?? "Address not provided"}</span>
            )
          }
        </div>
      </div>
      <span class="font-sans text-sm text-muted-foreground">
        Feel free to stop by during office hours with any questions.
      </span>
    </div>

    {
      socials && (
        <div class="anim-socials-wrapper col-span-1 mt-4 flex flex-col items-center justify-between gap-6 rounded-2xl border border-border/50 bg-secondary/30 p-8 md:flex-row lg:col-span-3 js:translate-y-8 js:opacity-0">
          <span class="font-mono text-xs tracking-widest text-muted-foreground uppercase">
            Follow our socials
          </span>
          <div class="flex flex-wrap justify-center gap-4">
            {Object.entries(socials).map(([platform, socialData]) => {
              if (!socialData || !socialData.link) return null;

              const Icon = socialIcons[platform.toLowerCase()];
              return (
                <a
                  href={socialData.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="anim-social-icon rounded-full border border-border/50 bg-background p-3 transition-all duration-300 hover:border-primary hover:text-primary js:scale-50 js:opacity-0"
                  aria-label={`Follow on ${platform}`}
                  title={socialData.handle ? `@${socialData.handle}` : platform}
                >
                  {Icon ? (
                    <Icon class="size-5" />
                  ) : (
                    <span class="font-mono text-xs capitalize">{platform}</span>
                  )}
                </a>
              );
            })}
          </div>
        </div>
      )
    }
  </section>
</PageLayout>

<script>
  import { animateListingHeader } from "@/utils/animations/listing-header";
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-page="contact"]', ({ root }) => {
    animateListingHeader(
      gsap.timeline({ defaults: { ease: "power3.out" } }),
      root,
      {
        badge: { duration: 0.8, ease: "back.out(1.7)" },
        title: { at: "-=0.4", duration: 1, stagger: 0.05 },
        description: { at: "-=0.6", duration: 0.8 },
        sectionTitle: false,
      },
    );

    gsap.to(".anim-contact-card", {
      y: 0,
      opacity: 1,
      duration: 0.8,
      stagger: 0.15,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".anim-contact-card",
        start: "top 85%",
      },
    });

    const socialTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".anim-socials-wrapper",
        start: "top 90%",
      },
    });

    socialTl
      .to(".anim-socials-wrapper", {
        y: 0,
        opacity: 1,
        duration: 0.8,
        ease: "power2.out",
      })
      .to(
        ".anim-social-icon",
        {
          scale: 1,
          opacity: 1,
          duration: 0.5,
          stagger: 0.05,
          ease: "back.out(2)",
        },
        "-=0.4",
      );
  });
</script>
