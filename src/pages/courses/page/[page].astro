---
import { IconArrowRight, IconSchool } from "@tabler/icons-astro";
import type { GetStaticPaths } from "astro";
import Badge from "@/components/astro/Badge.astro";
import ClickableCard from "@/components/astro/Card/ClickableCard.astro";
import CourseCard from "@/components/astro/Card/CourseCard.astro";
import Empty from "@/components/astro/Empty.astro";
import Pagination from "@/components/astro/Pagination.astro";
import ContinueLearning from "@/components/pages/courses/ContinueLearning.astro";
import { COURSE_PAGE_SIZE } from "@/consts";
import PageLayout from "@/layouts/PageLayout.astro";
import { categoryPath, summarizeCategories } from "@/lib/categories";
import { coursePath } from "@/lib/courses";
import { resourcesPath } from "@/lib/resources";
import { getCourses } from "@/sanity/lib/queries/courses";
import { getPosts } from "@/sanity/lib/queries/posts";
import { getResources } from "@/sanity/lib/queries/resources";

export const getStaticPaths = (async ({ paginate }) => {
  const [courses, posts, resources] = await Promise.all([
    getCourses(),
    getPosts("blog"),
    getResources(),
  ]);
  // Short how-tos live on the blog under a "Tutorial(s)" category.
  const tutorials = summarizeCategories(posts ?? []).find((category) =>
    ["tutorial", "tutorials"].includes(category.slug),
  );

  return paginate(courses, {
    pageSize: COURSE_PAGE_SIZE,
    props: { allCourses: courses, tutorials, resourceCount: resources.length },
  });
}) satisfies GetStaticPaths;

const { page, allCourses, tutorials, resourceCount } = Astro.props;
const pageTitle =
  page.currentPage === 1 ? "Courses" : `Courses, page ${page.currentPage}`;
---

<PageLayout
  title={pageTitle}
  description="Free self-paced courses from NSAE for agricultural engineers and students: lessons, videos and quizzes, with progress saved in your browser."
  dataPagefindIgnore="all"
  page="course-listing"
>
  <header
    class="flex flex-col items-center justify-center py-16 text-center md:py-24"
  >
    <div class="anim-header-badge scale-50 opacity-0">
      <Badge
        variant="secondary"
        size="sm"
        class="mb-3 border border-border/50 font-mono text-xs tracking-widest uppercase"
      >
        Learn with NSAE
      </Badge>
    </div>
    <h1
      class="anim-header-title invisible max-w-4xl pt-4 font-sans text-5xl leading-tight font-medium tracking-tighter md:text-7xl"
    >
      Courses for agricultural engineers
    </h1>
    <p
      class="anim-header-desc mt-6 max-w-2xl translate-y-4 text-lg text-muted-foreground opacity-0"
    >
      Free, self-paced lessons with videos and quizzes. Your progress is saved
      in this browser, so you can pick up where you left off.
    </p>
  </header>

  <ContinueLearning courses={allCourses} class="mb-10" />

  <section class="mb-16" aria-labelledby="all-courses">
    <h2
      id="all-courses"
      class="anim-section-title mb-8 translate-y-4 border-b border-border/50 pb-2 font-sans text-xl font-medium tracking-wider uppercase opacity-0 md:text-2xl"
    >
      All courses
    </h2>

    {
      page.data.length > 0 ? (
        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
          {page.data.map((course) => (
            <li class="anim-card translate-y-4 opacity-0">
              <ClickableCard
                href={coursePath(course)}
                label={course.title}
                class="h-full rounded-2xl border border-border/60 bg-secondary/30 transition-colors hover:bg-secondary/70"
              >
                <CourseCard data={course} />
              </ClickableCard>
            </li>
          ))}
        </ul>
      ) : (
        <div class="anim-empty-state scale-95 opacity-0">
          <Empty
            title="Courses are on the way"
            description="We're preparing our first courses. Check back soon, or browse our events for upcoming trainings."
          >
            <IconSchool slot="icon" class="size-8 text-muted-foreground" />
            <a
              href="/events/page/1/"
              class="mt-4 font-mono text-xs tracking-widest text-primary uppercase hover:underline"
            >
              See upcoming events
            </a>
          </Empty>
        </div>
      )
    }

    <Pagination url={page.url} />
  </section>

  {
    (tutorials || resourceCount > 0) && (
      <div class="mb-16 grid gap-4 md:grid-cols-2">
        {tutorials && (
          <a
            href={categoryPath("/blog", tutorials.slug)}
            class="group flex items-center justify-between gap-4 rounded-2xl border border-border/60 p-5 transition-colors hover:border-primary/50 hover:bg-secondary/50"
          >
            <span>
              <span class="block font-medium">Looking for a quick how-to?</span>
              <span class="block text-sm text-muted-foreground">
                Browse {tutorials.count} short tutorial
                {tutorials.count === 1 ? "" : "s"} on the blog.
              </span>
            </span>
            <IconArrowRight class="size-5 shrink-0 text-primary transition-transform group-hover:translate-x-1" />
          </a>
        )}

        {resourceCount > 0 && (
          <a
            href={resourcesPath()}
            class="group flex items-center justify-between gap-4 rounded-2xl border border-border/60 p-5 transition-colors hover:border-primary/50 hover:bg-secondary/50"
          >
            <span>
              <span class="block font-medium">
                Need a standard, manual or template?
              </span>
              <span class="block text-sm text-muted-foreground">
                Browse {resourceCount} free download
                {resourceCount === 1 ? "" : "s"} in the resource library.
              </span>
            </span>
            <IconArrowRight class="size-5 shrink-0 text-primary transition-transform group-hover:translate-x-1" />
          </a>
        )}
      </div>
    )
  }
</PageLayout>

<script>
  import "@/scripts/course-progress";
  import { animateListingHeader } from "@/utils/animations/listing-header";
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-page="course-listing"]', ({ root }) => {
    const tl = animateListingHeader(
      gsap.timeline({ defaults: { ease: "power3.out" } }),
      root,
      { sectionTitle: { at: "-=0.3" } },
    );

    if (root.querySelector(".anim-card")) {
      tl.to(
        ".anim-card",
        { y: 0, opacity: 1, duration: 0.6, stagger: 0.08 },
        "-=0.2",
      );
    } else if (root.querySelector(".anim-empty-state")) {
      tl.to(
        ".anim-empty-state",
        { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.2)" },
        "-=0.2",
      );
    }
  });
</script>
