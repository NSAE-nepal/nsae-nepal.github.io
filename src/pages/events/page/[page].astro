---
import { IconCalendarOff, IconMoodEmpty } from "@tabler/icons-astro";
import type { GetStaticPaths, Page } from "astro";
import Badge from "@/components/astro/Badge.astro";
import ClickableCard from "@/components/astro/Card/ClickableCard.astro";
import EventCard from "@/components/astro/Card/EventCard.astro";
import Pagination from "@/components/astro/Pagination.astro";
import { PAGE_SIZE } from "@/consts";
import PageLayout from "@/layouts/PageLayout.astro";
import { type Event, getEvents } from "@/sanity/lib/queries/events";
import { getEventStatus } from "@/utils/datetime";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPublishedEvents = (await getEvents()) || [];
  const now = new Date();

  // Evaluated at build time; the daily scheduled deploy keeps this current.
  const upcoming = allPublishedEvents
    .filter((event) => !getEventStatus(event, now).hasEnded)
    .sort(
      (a, b) =>
        new Date(a.eventStart).getTime() - new Date(b.eventStart).getTime(),
    );
  const past = allPublishedEvents.filter(
    (event) => getEventStatus(event, now).hasEnded,
  );

  // Only past events are paginated; upcoming ones are all shown on page 1.
  return paginate(past, {
    pageSize: PAGE_SIZE,
    props: { upcoming },
  });
};

interface Props {
  page: Page<Event>;
  upcoming: Event[];
}

const { page, upcoming } = Astro.props;
const isFirstPage = page.currentPage === 1;
const hasAnyEvents = upcoming.length > 0 || page.total > 0;

const pageTitle = isFirstPage
  ? "Events"
  : `Past Events, page ${page.currentPage}`;
const pageDescription =
  "Explore upcoming and past events organized by our community.";
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  dataPagefindIgnore="all"
  page="events-listing"
>
  <header class="flex flex-col items-center justify-center py-16 md:py-24">
    <div class="anim-header-badge scale-50 opacity-0">
      <Badge
        variant={"secondary"}
        size={"sm"}
        class="mb-3 border border-border/50 font-mono text-xs tracking-widest uppercase"
      >
        Events Archive
      </Badge>
    </div>
    <h1
      class="anim-header-title invisible max-w-4xl pt-4 text-center font-sans text-5xl leading-tight font-medium tracking-tighter md:text-7xl"
    >
      Explore our latest events
    </h1>
  </header>

  {
    !hasAnyEvents && (
      <div class="anim-empty-state mb-24 flex scale-95 flex-col items-center justify-center rounded-xl border border-dashed border-border/60 bg-secondary/5 py-16 text-center opacity-0">
        <div class="mb-4 rounded-full bg-secondary p-4">
          <IconMoodEmpty class="size-8 text-muted-foreground" />
        </div>
        <h3 class="mb-2 font-sans text-xl font-medium">No events yet</h3>
        <p class="mx-auto max-w-xs text-muted-foreground">
          Our events will be listed here. Check back later for updates.
        </p>
      </div>
    )
  }

  {
    hasAnyEvents && isFirstPage && (
      <section
        class="mb-16"
        data-manual-card-anim
        aria-labelledby="upcoming-events"
      >
        <h2
          id="upcoming-events"
          class="anim-all-title mb-8 translate-y-4 border-b border-border/50 pb-2 font-sans text-xl font-medium tracking-wider uppercase opacity-0 md:text-2xl"
        >
          Upcoming Events
        </h2>
        {upcoming.length > 0 ? (
          <div class="flex flex-col gap-6">
            {upcoming.map((event) => (
              <ClickableCard
                href={`/events/${event.slug}/`}
                label={event.title}
                class="anim-event-card group translate-y-4 overflow-hidden rounded-2xl bg-secondary text-secondary-foreground opacity-0 transition-colors"
              >
                <EventCard data={event} />
              </ClickableCard>
            ))}
          </div>
        ) : (
          <div class="anim-all-title flex translate-y-4 items-center gap-4 rounded-2xl border border-dashed border-border/60 p-6 text-muted-foreground opacity-0">
            <IconCalendarOff class="size-6 shrink-0" />
            <p>
              No upcoming events are scheduled right now. Follow our{" "}
              <a
                href="/notices/page/1"
                class="underline underline-offset-4 hover:text-primary"
              >
                notices
              </a>{" "}
              for announcements.
            </p>
          </div>
        )}
      </section>
    )
  }

  {
    page.data.length > 0 && (
      <section
        class="mb-24"
        data-manual-card-anim
        aria-labelledby="past-events"
      >
        <h2
          id="past-events"
          class="anim-all-title mb-8 translate-y-4 border-b border-border/50 pb-2 font-sans text-xl font-medium tracking-wider uppercase opacity-0 md:text-2xl"
        >
          Past Events
        </h2>
        <div class="mb-12 flex flex-col gap-6">
          {page.data.map((event) => (
            <ClickableCard
              href={`/events/${event.slug}/`}
              label={event.title}
              class="anim-event-card group translate-y-4 overflow-hidden rounded-2xl bg-secondary text-secondary-foreground opacity-0 transition-colors"
            >
              <EventCard data={event} />
            </ClickableCard>
          ))}
        </div>
        <div class="anim-pagination mt-16 flex justify-center opacity-0">
          <Pagination
            url={page.url}
            class="font-mono text-sm tracking-widest uppercase"
          />
        </div>
      </section>
    )
  }
</PageLayout>

<script>
  import { startCardHover } from "@/utils/animations/cards-split-text-animation";
  import { animateListingHeader } from "@/utils/animations/listing-header";
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-page="events-listing"]', (scope) => {
    const { root } = scope;
    const mainTl = animateListingHeader(
      gsap.timeline({ defaults: { ease: "power3.out" } }),
      root,
      { sectionTitle: { selector: ".anim-all-title", at: "-=0.6" } },
    );

    if (root.querySelector(".anim-event-card")) {
      mainTl
        .to(
          ".anim-event-card",
          {
            y: 0,
            opacity: 1,
            duration: 0.5,
            stagger: 0.08,
            ease: "power2.out",
          },
          "-=0.6",
        )
        .add(startCardHover(scope, ".anim-event-card"), "<");
    }

    if (root.querySelector(".anim-pagination")) {
      mainTl.to(".anim-pagination", { opacity: 1, duration: 0.5 }, "-=0.2");
    }

    if (root.querySelector(".anim-empty-state")) {
      mainTl.to(
        ".anim-empty-state",
        { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.2)" },
        "-=0.4",
      );
    }
  });
</script>
