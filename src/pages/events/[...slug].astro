---
import { IconArrowLeft } from "@tabler/icons-astro";
import PortableText from "@/components/PortableText.astro";
import EventContact from "@/components/pages/events/EventContact.astro";
import EventHeader from "@/components/pages/events/EventHeader.astro";
import EventInstructors from "@/components/pages/events/EventInstructors.astro";
import EventLocation from "@/components/pages/events/EventLocation.astro";
import EventRecap from "@/components/pages/events/EventRecap.astro";
import EventSchedule from "@/components/pages/events/EventSchedule.astro";
import { SITE_DESCRIPTION } from "@/consts";
import JsonLd from "@/components/seo/JsonLd.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { breadcrumbLd, eventLd } from "@/lib/structured-data";
import { getEventStatus } from "@/utils/datetime";
import { getEventDetails, getEvents } from "@/sanity/lib/queries/events";

export async function getStaticPaths() {
  const events = await getEvents();

  return events.map((event) => ({
    params: {
      slug: event.slug,
    },
  }));
}

const { slug } = Astro.params;

const event = await getEventDetails(slug!);
const { hasEnded, isRegistrationOpen } = getEventStatus(event);
// Recap content stays hidden until the event is over, even if added early.
const showRecap = hasEnded && event.hasRecap;
const site = Astro.site!;
---

<PageLayout
  title={event.title}
  description={event.subtitle || SITE_DESCRIPTION}
  image={event.coverImage || `/og/events/${event.slug}.png`}
>
  <JsonLd
    slot="head"
    data={[
      eventLd(event, site, { isRegistrationOpen }),
      breadcrumbLd(
        [
          { name: "Home", path: "/" },
          { name: "Events", path: "/events/page/1/" },
          { name: event.title, path: `/events/${event.slug}/` },
        ],
        site,
      ),
    ]}
  />
  <article
    class="space-y-10 py-8"
    data-pagefind-body
    data-pagefind-filter="type:Event"
  >
    <a
      data-pagefind-ignore
      href="/events/page/1"
      class="inline-flex items-center gap-2 px-4 font-mono text-xs tracking-widest text-muted-foreground uppercase transition-colors hover:text-primary"
    >
      <IconArrowLeft class="size-4" /> Back to All Events
    </a>

    <EventHeader data={event} />

    <hr class="my-8 border-muted" />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[3fr_1.5fr] lg:gap-12">
      <div class="flex flex-col gap-10">
        {showRecap && <EventRecap data={event} />}

        <section>
          <h2 class="mb-4 font-sans text-2xl font-medium tracking-tight">
            About the Event
          </h2>
          <div
            class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-sans prose-p:font-sans"
          >
            <PortableText portableText={event.body} />
          </div>
        </section>

        <EventSchedule schedule={event.eventSchedule} />
      </div>

      <aside
        data-pagefind-ignore
        class="flex h-fit flex-col gap-6 lg:sticky lg:top-24"
      >
        <EventLocation location={event.location} />
        <EventContact contactPersons={event.contactPersons} />
        <EventInstructors instructors={event.instructors} />
      </aside>
    </div>
  </article>
</PageLayout>
