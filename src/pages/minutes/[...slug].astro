---
import {
  IconArrowLeft,
  IconCalendarWeek,
  IconDownload,
  IconMapPin,
  IconPoint,
} from "@tabler/icons-astro";
import Badge from "@/components/astro/Badge.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import PortableText from "@/components/PortableText.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { getMinutes, getMinutesDetails } from "@/sanity/lib/queries/minutes";

export async function getStaticPaths() {
  const minutes = await getMinutes();

  return minutes.map((minute) => ({
    params: {
      slug: minute.slug,
    },
  }));
}

const { slug } = Astro.params;

const minute = await getMinutesDetails(slug!);
const {
  title,
  pubDate,
  type,
  location,
  chairperson,
  secretary,
  attendees,
  downloadUrl,
  body,
} = minute;
---

<PageLayout title={title} description={`Minutes for ${title}`}>
  <article
    class="space-y-10 py-8"
    data-pagefind-body
    data-pagefind-filter="type:Minutes"
  >
    <a
      data-pagefind-ignore
      href="/minutes"
      class="inline-flex items-center gap-2 px-4 font-mono text-xs tracking-widest text-muted-foreground uppercase transition-colors hover:text-primary"
    >
      <IconArrowLeft class="size-4" /> Back to All Minutes
    </a>
    <header class="space-y-8 border-b border-border/50 pb-8">
      <div class="space-y-4 text-center">
        <div class="flex flex-wrap items-center justify-center gap-4">
          <Badge
            variant={"secondary"}
            size={"xs"}
            class={"font-mono text-xs uppercase tracking-wider flex items-center gap-1.5"}
          >
            <IconPoint class="h-2.5 w-2.5 fill-destructive text-destructive" />
            {type}
          </Badge>
          <span
            data-pagefind-meta={`date:${new Date(pubDate).toISOString()}`}
            data-pagefind-ignore
            class="flex flex-row items-center gap-1.5 font-mono text-xs tracking-wider text-muted-foreground uppercase"
          >
            <IconCalendarWeek class={"size-4"} />
            <FormattedDate date={new Date(pubDate)} />
          </span>
          <span
            class="flex flex-row items-center gap-1.5 font-mono text-xs tracking-wider text-muted-foreground uppercase"
          >
            <IconMapPin class={"size-4"} />
            {location}
          </span>
        </div>
        <h1
          data-pagefind-meta="title"
          class="font-sans text-3xl font-medium tracking-tighter first-letter:capitalize md:text-5xl"
        >
          {title}
        </h1>
      </div>

      <div
        class="mx-auto grid max-w-7xl grid-cols-1 gap-6 rounded-xl border border-border/50 bg-secondary/50 p-6 md:grid-cols-2"
      >
        {
          chairperson && (
            <div data-pagefind-ignore>
              <span class="mb-1.5 block font-mono text-xs tracking-wider text-muted-foreground uppercase">
                Chairperson
              </span>
              <span class="font-sans text-lg font-medium text-foreground">
                {chairperson}
              </span>
            </div>
          )
        }
        {
          secretary && (
            <div data-pagefind-ignore>
              <span class="mb-1.5 block font-mono text-xs tracking-wider text-muted-foreground uppercase">
                Secretary
              </span>
              <span class="font-sans text-lg font-medium text-foreground">
                {secretary}
              </span>
            </div>
          )
        }
        {
          attendees && attendees.length > 0 && (
            <div data-pagefind-ignore class="md:col-span-2">
              <span class="mb-1.5 block font-mono text-xs tracking-wider text-muted-foreground uppercase">
                Attendees
              </span>
              <span class="font-sans leading-relaxed text-muted-foreground">
                {attendees.join(", ")}
              </span>
            </div>
          )
        }
      </div>

      {
        downloadUrl && (
          <div class="flex justify-center pt-2">
            <a
              href={downloadUrl}
              target="_blank"
              class="inline-flex items-center gap-2 rounded-md bg-primary px-6 py-3 font-mono text-xs tracking-widest text-primary-foreground uppercase transition-colors hover:bg-primary/90"
            >
              <IconDownload class="size-4" /> Download PDF
            </a>
          </div>
        )
      }
    </header>

    <div class="mx-auto prose max-w-7xl dark:prose-invert">
      <PortableText portableText={body} />
    </div>
  </article>
</PageLayout>
