---
import type { GetStaticPaths } from "astro";
import MinutesListing from "@/components/pages/minutes/MinutesListing.astro";
import { PAGE_SIZE } from "@/consts";
import {
  getMinutes,
  summarizeMinutesTypes,
} from "@/sanity/lib/queries/minutes";

export const getStaticPaths = (async ({ paginate }) => {
  const minutes = (await getMinutes()) ?? [];

  return paginate(minutes, {
    pageSize: PAGE_SIZE,
    props: { types: summarizeMinutesTypes(minutes) },
  });
}) satisfies GetStaticPaths;

const { page, types } = Astro.props;
---

<MinutesListing page={page} types={types} />
