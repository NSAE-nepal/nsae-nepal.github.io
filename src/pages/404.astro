---
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout
  title="Page Not Found"
  description="Page Not Found"
  dataPagefindIgnore="all"
>
  <section
    class="flex min-h-screen w-full flex-col items-center justify-center"
  >
    <div class="p-8 text-center">
      <h1
        class="text-8xl font-bold tracking-tighter text-foreground sm:text-9xl"
        aria-label="404 Error"
      >
        <span class="digit invisible inline-block">4</span>
        <span class="digit invisible inline-block">0</span>
        <span class="digit invisible inline-block">4</span>
      </h1>

      <h2
        class="invisible mt-4 text-2xl font-semibold text-foreground/80 fade-in sm:text-3xl"
      >
        Page Not Found
      </h2>
      <p class="invisible mt-2 text-foreground/60 fade-in">
        Sorry, the page you are looking for seems to have taken a wrong turn.
      </p>

      <div class="invisible mt-8 fade-in">
        <a
          href="/"
          class="rounded-full bg-primary px-8 py-3 text-sm font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black"
        >
          Go Back Home
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  import { gsap } from "@/utils/gsap-init";

  let ctx: gsap.Context | undefined;
  function init404Page() {
    ctx = gsap.context(() => {
      const tl = gsap.timeline();

      gsap.set(".digit", { y: 50 });
      gsap.set(".fade-in", { y: 20 });

      tl.to(
        ".digit",
        {
          y: 0,
          autoAlpha: 1,
          duration: 0.8,
          ease: "back.out(1.7)",
          stagger: 0.2,
        },
        "+=0.2",
      );

      tl.to(
        ".fade-in",
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.6,
          ease: "power3.out",
          stagger: 0.15,
        },
        "-=0.5",
      );
    });
  }
  document.addEventListener("astro:page-load", init404Page);
  document.addEventListener("astro:before-swap", () => ctx?.revert());
</script>
