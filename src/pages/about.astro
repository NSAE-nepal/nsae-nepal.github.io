---
import { formatPrefix } from "@/lib/utils";
import { Image } from "astro:assets";
import {
  IconArrowRight,
  IconBook,
  IconBulb,
  IconGavel,
  IconLeaf,
  IconUsers,
} from "@tabler/icons-astro";
import Badge from "@/components/astro/Badge.astro";
import Button from "@/components/astro/Button/Button.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { getLatestCommitteeDetails } from "@/sanity/lib/queries/committee";
import { sanityImage } from "@/sanity/lib/url-for-image";

const latestCommittee = await getLatestCommitteeDetails();
const featuredMembers = latestCommittee?.committeeMembers.slice(0, 4) || [];

const values = [
  {
    title: "Innovation",
    icon: IconBulb,
    description: "Pushing the boundaries of agricultural technology.",
  },
  {
    title: "Sustainability",
    icon: IconLeaf,
    description: "Promoting practices that ensure long-term health.",
  },
  {
    title: "Community",
    icon: IconUsers,
    description: "Building a strong network of engineers and farmers.",
  },
];

const focusAreas = [
  {
    title: "Policy Advocacy",
    icon: IconGavel,
    content:
      "Working with government bodies to shape agricultural policies that benefit the nation and the engineering profession.",
  },
  {
    title: "Professional Development",
    icon: IconUsers,
    content:
      "Organizing workshops, trainings, and conferences to enhance the skills and knowledge of our members.",
  },
  {
    title: "Research & Development",
    icon: IconBulb,
    content:
      "Promoting and publishing innovative research to solve real-world agricultural challenges in Nepal.",
  },
  {
    title: "Education Support",
    icon: IconBook,
    content:
      "Collaborating with universities to improve curriculum and support student engineers.",
  },
];

const AboutHeroImg = "/about-hero.avif";

function formatPosition(position: string) {
  return position
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}
---

<PageLayout
  title="About Us"
  description="Engineering the Future of Agriculture in Nepal."
  dataPagefindIgnore="all"
  page="about"
>
  <section
    class="about-hero-section relative flex min-h-[60vh] items-center overflow-hidden rounded-2xl px-6 py-20 text-white md:min-h-[90vh] md:px-12 md:py-32"
  >
    <div
      class="about-est-text absolute top-32 left-6 z-20 hidden md:left-12 md:block js:opacity-0"
    >
      <span
        class="vertical-lr font-mono text-xs tracking-widest text-white/60 uppercase"
      >
        [ EST. 1990 ]
      </span>
    </div>

    <div class="relative z-20 mt-12 flex max-w-4xl flex-col gap-6 md:gap-8">
      <div class="anim-hero-badge js:translate-y-4 js:opacity-0">
        <Badge
          variant="outline"
          class="w-fit border-white/30 font-mono text-xs tracking-widest text-white uppercase"
        >
          Who We Are
        </Badge>
      </div>

      <h1
        class="font-sans text-5xl leading-[1.02] font-medium tracking-tighter md:text-7xl lg:text-8xl js:invisible"
      >
        <span class="anim-split-text inline-block">Engineering the</span>
        <br />
        <span class="anim-split-text inline-block text-white/80"
          >Future of Agriculture</span
        >
      </h1>

      <p
        class="anim-hero-desc max-w-2xl font-sans text-lg leading-relaxed text-white/90 md:text-xl js:translate-y-4 js:opacity-0"
      >
        The Nepal Society of Agricultural Engineers (NSAE) is dedicated to
        advancing the profession and promoting sustainable agricultural
        practices across the nation.
      </p>
    </div>

    <div class="absolute inset-0 z-10">
      <div
        class="absolute inset-0 z-20 bg-gradient-to-r from-black/90 via-black/60 to-black/20"
      >
      </div>
      <div class="absolute inset-0 z-10 bg-black/20"></div>
      <img
        class="anim-hero-image absolute inset-0 h-full w-full scale-110 object-cover"
        alt="Agricultural Engineering Field"
        src={AboutHeroImg}
      />
    </div>
  </section>

  <div class="mb-0 space-y-12 pt-24 md:pt-32">
    <section class="mission-section border-b border-border/50 pb-12">
      <div
        class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:gap-24"
      >
        <div class="flex flex-col gap-4 lg:sticky lg:top-32 lg:w-1/2">
          <div class="anim-mission-header flex items-center gap-4 js:opacity-0">
            <Badge
              class="font-mono text-xs tracking-widest uppercase"
              size="sm"
            >
              ( 01 )
            </Badge>
            <span
              class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
            >
              Our Mission
            </span>
          </div>
          <h2
            class="anim-split-heading font-sans text-4xl leading-tight font-medium tracking-tighter md:text-6xl js:invisible"
          >
            Bridging traditional farming with modern engineering.
          </h2>

          <div class="grid gap-6">
            {
              values.map((val) => (
                <div class="anim-value-card group flex gap-4 rounded-xl border border-border/50 bg-card/50 p-5 transition-colors hover:bg-secondary/40 js:translate-y-8 js:opacity-0">
                  <div class="h-fit shrink-0 rounded-lg bg-primary/10 p-2 text-primary">
                    <val.icon class="size-6" />
                  </div>
                  <div>
                    <h3 class="mb-1 font-sans text-lg font-medium text-foreground">
                      {val.title}
                    </h3>
                    <p class="font-sans text-sm leading-relaxed text-foreground/70">
                      {val.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="prose prose-lg lg:w-1/2 dark:prose-invert prose-headings:font-sans prose-p:font-sans"
        >
          <div class="anim-mission-text js:translate-y-8 js:opacity-0">
            <p class="lead text-xl font-medium text-foreground">
              Our mission is to unite agricultural engineers under a common
              umbrella to foster professional growth, ethical standards, and
              technological advancement.
            </p>
          </div>
          <div class="anim-mission-text js:translate-y-8 js:opacity-0">
            <p class="text-foreground/80">
              By collaborating with governmental bodies, educational
              institutions, and the private sector, we strive to influence
              policies that enhance food security and rural development.
            </p>
          </div>
          <div class="anim-mission-text js:translate-y-8 js:opacity-0">
            <p class="text-foreground/80">
              We believe that engineering solutions are the key to unlocking
              Nepal's agricultural potential. From irrigation systems to
              post-harvest technology, our members are at the forefront of
              innovation.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="focus-section border-b border-border/50 pb-12">
      <div
        class="flex flex-col items-start justify-between gap-12 pb-12 md:flex-row lg:gap-24"
      >
        <div class="space-y-4">
          <div
            class="anim-focus-header mb-4 flex items-center gap-4 js:opacity-0"
          >
            <Badge
              class="font-mono text-xs tracking-widest uppercase"
              size="sm"
            >
              ( 02 )
            </Badge>
            <span
              class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
            >
              What We Do
            </span>
          </div>
          <h2
            class="anim-split-heading font-sans text-4xl font-medium tracking-tighter text-balance md:text-5xl js:invisible"
          >
            Strategic Focus
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          focusAreas.map((area) => (
            <div class="anim-focus-card group rounded-2xl border border-border/50 bg-secondary/30 p-8 transition-colors hover:border-primary/50 js:translate-y-12 js:opacity-0">
              <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-full border border-border bg-background text-muted-foreground transition-colors group-hover:border-primary/50 group-hover:text-primary">
                <area.icon class="size-6" />
              </div>
              <h3 class="mb-3 font-sans text-2xl font-medium text-foreground">
                {area.title}
              </h3>
              <p class="font-sans leading-relaxed text-foreground/70">
                {area.content}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="team-section mb-0">
      <div
        class="flex flex-col items-start justify-between gap-6 pb-12 md:flex-row"
      >
        <div class="space-y-4">
          <div
            class="anim-team-header mb-4 flex items-center gap-4 js:opacity-0"
          >
            <Badge
              class="font-mono text-xs tracking-widest uppercase"
              size="sm"
            >
              ( 03 )
            </Badge>
            <span
              class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
            >
              Leadership
            </span>
          </div>
          <h2
            class="anim-split-heading font-sans text-4xl font-medium tracking-tighter text-balance md:text-5xl"
          >
            Executive Committee
          </h2>
          {
            latestCommittee && (
              <p class="anim-team-iter font-mono text-sm tracking-widest text-muted-foreground uppercase js:opacity-0">
                Current Iteration: {latestCommittee.committeeIteration}
              </p>
            )
          }
        </div>
        <div class="anim-team-btn js:opacity-0">
          <Button
            href={`/past-committee/${latestCommittee?.committeeIteration}`}
            variant="ghost"
            class="hidden gap-2 font-mono text-xs tracking-widest uppercase md:flex"
          >
            View Full Committee <IconArrowRight class="size-4" />
          </Button>
        </div>
      </div>

      {
        latestCommittee ? (
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {featuredMembers.map((member) => (
              <div class="anim-member-card group relative overflow-hidden rounded-lg shadow-lg js:translate-y-12 js:opacity-0">
                {member.profileImage ? (
                  <Image
                    src={sanityImage(member.profileImage, { width: 600 })}
                    inferSize
                    alt={`Profile picture of ${member.name}`}
                    class="aspect-3/4 w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                ) : (
                  <div class="flex aspect-3/4 w-full items-center justify-center bg-secondary" />
                )}

                <div class="absolute right-4 bottom-4 rounded-md bg-black/70 p-3 text-white">
                  <span class="block text-sm font-semibold capitalize">
                    {member.prefix?.length
                      ? `${formatPrefix(member.prefix)} `
                      : null}
                    {member.name}
                  </span>
                  <span class="block text-xs">
                    {formatPosition(member.position)}
                  </span>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="rounded-xl border border-dashed border-border py-12 text-center">
            <p class="text-muted-foreground">
              Committee information unavailable.
            </p>
          </div>
        )
      }

      <div class="mt-8 flex justify-center md:hidden">
        <Button
          href={`/past-committee/${latestCommittee?.committeeIteration}`}
          variant="outline"
          class="font-mono text-xs tracking-widest uppercase"
        >
          View Full Committee
        </Button>
      </div>
    </section>

    <section class="py-24 md:py-32">
      <div
        class="anim-cta-box relative flex flex-col items-center gap-8 overflow-hidden rounded-3xl bg-secondary p-8 text-center text-secondary-foreground md:p-16 js:scale-95 js:opacity-0"
      >
        <div class="relative z-10 flex flex-col items-center gap-6">
          <h2
            class="max-w-2xl font-sans text-3xl font-medium tracking-tighter md:text-5xl"
          >
            Ready to shape the future of agriculture?
          </h2>
          <p class="max-w-xl font-sans text-lg text-secondary-foreground/80">
            Join a community of innovators, researchers, and engineers working
            towards a sustainable future.
          </p>
          <Button
            href="/contact"
            variant="outline"
            class="rounded-full px-8 py-6 font-sans text-lg font-medium"
          >
            Join us
          </Button>
        </div>

        <div
          class="pointer-events-none absolute top-0 left-0 h-full w-full bg-gradient-to-br from-white/10 to-transparent"
        >
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<script>
  import { gsap, SplitText } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-page="about"]', () => {
    const heroTl = gsap.timeline({
      defaults: { ease: "power3.out" },
    });

    const heroSplit = SplitText.create(".anim-split-text", {
      type: "lines",
      linesClass: "line-inner overflow-hidden",
    });

    heroTl.from(
      ".anim-hero-image",
      {
        scale: 1.2,
        duration: 2.5,
        ease: "expo.out",
      },
      0,
    );

    heroTl.to(
      ".about-est-text",
      {
        opacity: 1,
        y: 0,
        startAt: { y: -20 },
        duration: 1.5,
      },
      0.2,
    );

    heroTl.to(
      ".anim-hero-badge",
      {
        opacity: 1,
        y: 0,
        duration: 1,
      },
      0.3,
    );

    heroTl.set(".about-hero-section h1", { autoAlpha: 1 }, 0.4).from(
      heroSplit.lines,
      {
        yPercent: 100,
        opacity: 0,
        duration: 1.2,
        stagger: 0.1,
        ease: "power4.out",
      },
      "<",
    );

    heroTl.to(
      ".anim-hero-desc",
      {
        y: 0,
        opacity: 1,
        duration: 1,
      },
      0.8,
    );

    gsap.to(".anim-hero-image", {
      yPercent: 20,
      ease: "none",
      scrollTrigger: {
        trigger: ".about-hero-section",
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });

    // 1. Mission Section Animation (Updated to character-by-character back pop)
    const missionSplit = SplitText.create(
      ".mission-section .anim-split-heading",
      {
        type: "lines, chars",
        linesClass: "overflow-hidden",
      },
    );

    const missionTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".mission-section",
        start: "top 75%",
      },
    });

    missionTl
      .to(".anim-mission-header", { opacity: 1, duration: 0.5 })
      .set(".mission-section .anim-split-heading", { autoAlpha: 1 }, "-=0.3")
      .from(
        missionSplit.chars,
        {
          opacity: 0,
          y: 20,
          duration: 0.5,
          stagger: 0.02,
          ease: "back.out",
        },
        "<",
      )
      .to(
        [".anim-value-card", ".anim-mission-text"],
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.1,
          ease: "power3.out",
        },
        "-=0.3",
      );

    // 2. Focus Section Animation (Original character pop style)
    const focusSplit = SplitText.create(".focus-section .anim-split-heading", {
      type: "lines, chars",
      linesClass: "overflow-hidden",
    });

    const focusTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".focus-section",
        start: "top 70%",
      },
    });

    focusTl
      .to(".anim-focus-header", { opacity: 1, duration: 0.5 })
      .set(".focus-section .anim-split-heading", { autoAlpha: 1 }, "-=0.3")
      .from(
        focusSplit.chars,
        {
          opacity: 0,
          y: 20,
          duration: 0.5,
          stagger: 0.02,
          ease: "back.out",
        },
        "<",
      )
      .to(
        ".anim-focus-card",
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.1,
          ease: "power3.out",
        },
        "-=0.3",
      );

    // 3. Team Section Animation (Updated to character-by-character back pop)
    const teamSplit = SplitText.create(".team-section .anim-split-heading", {
      type: "lines, chars",
      linesClass: "overflow-hidden",
    });

    const teamTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".team-section",
        start: "top 70%",
      },
    });

    teamTl
      .to([".anim-team-header", ".anim-team-iter", ".anim-team-btn"], {
        opacity: 1,
        duration: 0.5,
        stagger: 0.1,
      })
      .set(".team-section .anim-split-heading", { autoAlpha: 1 }, "-=0.3")
      .from(
        teamSplit.chars,
        {
          opacity: 0,
          y: 20,
          duration: 0.5,
          stagger: 0.02,
          ease: "back.out",
        },
        "<",
      )
      .to(
        ".anim-member-card",
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.1,
          ease: "power3.out",
        },
        "-=0.3",
      );

    gsap.to(".anim-cta-box", {
      opacity: 1,
      scale: 1,
      duration: 1,
      ease: "elastic.out(1, 0.75)",
      scrollTrigger: {
        trigger: ".anim-cta-box",
        start: "top 85%",
      },
    });
  });
</script>
