---
import { IconUserStar } from "@tabler/icons-astro";
import type { GetStaticPaths } from "astro";
import Badge from "@/components/astro/Badge.astro";
import ClickableCard from "@/components/astro/Card/ClickableCard.astro";
import SpotlightCard from "@/components/astro/Card/SpotlightCard.astro";
import Empty from "@/components/astro/Empty.astro";
import Pagination from "@/components/astro/Pagination.astro";
import { PAGE_SIZE } from "@/consts";
import PageLayout from "@/layouts/PageLayout.astro";
import { getSpotlights, spotlightPath } from "@/sanity/lib/queries/spotlight";

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getSpotlights(), { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const pageTitle =
  page.currentPage === 1
    ? "Member Spotlight"
    : `Member Spotlight, page ${page.currentPage}`;
const pageDescription =
  "Meet NSAE members and the work they do: irrigation, farm machinery, post-harvest, renewable energy and more.";
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  dataPagefindIgnore="all"
  page="spotlight-listing"
>
  <header
    class="flex flex-col items-center justify-center py-16 text-center md:py-24"
  >
    <div class="anim-header-badge js:scale-50 js:opacity-0">
      <Badge
        variant="secondary"
        size="sm"
        class="mb-3 border border-border/50 font-mono text-xs tracking-widest uppercase"
      >
        Member Spotlight
      </Badge>
    </div>
    <h1
      class="anim-header-title max-w-4xl pt-4 font-sans text-5xl leading-tight font-medium tracking-tighter md:text-7xl js:invisible"
    >
      The engineers behind the work
    </h1>
    <p
      class="anim-header-desc mt-6 max-w-2xl font-sans text-lg text-muted-foreground js:translate-y-4 js:opacity-0"
    >
      {pageDescription}
    </p>
  </header>

  <section class="mb-16" aria-labelledby="spotlight-heading">
    <h2
      id="spotlight-heading"
      class="anim-section-title mb-8 border-b border-border/50 pb-2 font-sans text-xl font-medium tracking-wider uppercase md:text-2xl js:translate-y-4 js:opacity-0"
    >
      All spotlights
    </h2>

    {
      page.data.length > 0 ? (
        <>
          <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
            {page.data.map((spotlight) => (
              <li class="anim-card js:translate-y-4 js:opacity-0">
                <ClickableCard
                  href={spotlightPath(spotlight)}
                  label={spotlight.headline}
                  class="h-full overflow-hidden rounded-2xl border border-border/60 bg-secondary/30 transition-colors hover:bg-secondary/70"
                >
                  <SpotlightCard data={spotlight} />
                </ClickableCard>
              </li>
            ))}
          </ul>
          <div class="anim-pagination mt-16 flex justify-center js:opacity-0">
            <Pagination
              url={page.url}
              class="font-mono text-sm tracking-widest uppercase"
            />
          </div>
        </>
      ) : (
        <div class="anim-empty-state js:scale-95 js:opacity-0">
          <Empty
            title="Spotlights are coming"
            description="We'll soon be sharing the stories of NSAE members and their work. Please check back."
          >
            <IconUserStar slot="icon" class="size-8 text-muted-foreground" />
          </Empty>
        </div>
      )
    }
  </section>
</PageLayout>

<script>
  import { animateListingHeader } from "@/utils/animations/listing-header";
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-page="spotlight-listing"]', ({ root }) => {
    const tl = animateListingHeader(
      gsap.timeline({ defaults: { ease: "power3.out" } }),
      root,
    );

    if (root.querySelector(".anim-card")) {
      tl.to(
        ".anim-card",
        { y: 0, opacity: 1, duration: 0.6, stagger: 0.08 },
        "-=0.2",
      );
    } else {
      tl.to(
        ".anim-empty-state",
        { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.2)" },
        "-=0.2",
      );
    }

    if (root.querySelector(".anim-pagination")) {
      tl.to(".anim-pagination", { opacity: 1, duration: 0.5 }, "-=0.2");
    }
  });
</script>
