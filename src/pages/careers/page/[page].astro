---
import type { GetStaticPaths } from "astro";
import CareersListing from "@/components/pages/careers/CareersListing.astro";
import { PAGE_SIZE } from "@/consts";
import { summarizeOpportunityTypes } from "@/lib/opportunities";
import { getVacancies } from "@/sanity/lib/queries/careers";

export const getStaticPaths = (async ({ paginate }) => {
  const opportunities = (await getVacancies()) ?? [];

  return paginate(opportunities, {
    pageSize: PAGE_SIZE,
    props: { types: summarizeOpportunityTypes(opportunities) },
  });
}) satisfies GetStaticPaths;

const { page, types } = Astro.props;
---

<CareersListing page={page} types={types} />
