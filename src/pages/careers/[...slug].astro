---
import {
  IconArrowLeft,
  IconArrowUpRight,
  IconBuilding,
  IconCalendarWeek,
  IconCoin,
  IconMapPin,
  IconPoint,
} from "@tabler/icons-astro";
import Badge from "@/components/astro/Badge.astro";
import Button from "@/components/astro/Button/Button.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import PortableText from "@/components/PortableText.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import ShareBar from "@/components/ShareBar.astro";
import {
  opportunitiesPath,
  opportunityPath,
  opportunityTypeLabel,
} from "@/lib/opportunities";
import { breadcrumbLd, jobPostingLd } from "@/lib/structured-data";
import { getVacancies, getVacancyDetails } from "@/sanity/lib/queries/careers";
import { getOpportunityStatus } from "@/utils/datetime";

export async function getStaticPaths() {
  const allVacancies = await getVacancies();

  return allVacancies.map((vacancy) => ({
    params: {
      slug: vacancy.slug,
    },
  }));
}

const { slug } = Astro.params;

const vacancy = await getVacancyDetails(slug!);

const {
  title,
  description,
  type,
  opportunityType,
  company,
  location,
  postedDate,
  closingDate,
  value,
  applyUrl,
} = vacancy;

const { isClosed, isClosingSoon } = getOpportunityStatus(vacancy);
const isJob = opportunityType === "job";
const kindLabel = opportunityTypeLabel(opportunityType);
const site = Astro.site!;

// Only advertise open jobs to job search engines (JobPosting is jobs-only).
const structuredData = [
  ...(isJob && !isClosed ? [jobPostingLd(vacancy, site)] : []),
  breadcrumbLd(
    [
      { name: "Home", path: "/" },
      { name: "Opportunities", path: opportunitiesPath() },
      { name: title, path: opportunityPath(vacancy) },
    ],
    site,
  ),
];
---

<PageLayout
  title={title}
  description={description ?? title}
  image={`/og/careers/${vacancy.slug}.png`}
>
  <JsonLd slot="head" data={structuredData} />
  <article
    class="space-y-10 py-8"
    data-pagefind-body
    data-pagefind-filter="type:Opportunity"
  >
    <a
      data-pagefind-ignore
      href={opportunitiesPath()}
      class="inline-flex items-center gap-2 px-4 font-mono text-xs tracking-widest text-muted-foreground uppercase transition-colors hover:text-primary"
    >
      <IconArrowLeft class="size-4" /> Back to all opportunities
    </a>
    <header class="space-y-6 border-b pb-8 text-center">
      <div class="flex flex-wrap justify-center gap-2">
        {isClosed && <Badge variant={"destructive"}>Closed</Badge>}
        {
          isClosingSoon && (
            <Badge
              variant="outline"
              class="border-destructive/50 text-destructive"
            >
              Closing soon
            </Badge>
          )
        }
        <a href={opportunitiesPath(opportunityType)} data-pagefind-ignore>
          <Badge variant={"secondary"} class="hover:bg-secondary/80"
            >{kindLabel}</Badge
          >
        </a>
        {isJob && type && <Badge variant={"secondary"}>{type}</Badge>}
        {
          company?.name && (
            <Badge variant="outline" data-pagefind-meta="sub_title">
              {company.name}
            </Badge>
          )
        }
      </div>

      <h1
        data-pagefind-meta="title"
        class="text-3xl font-bold tracking-tight text-balance md:text-4xl"
      >
        {title}
      </h1>

      <div
        class="flex flex-row flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground"
      >
        {
          company && (
            <div data-pagefind-ignore class="flex items-center gap-1.5">
              <IconBuilding class="size-4" />
              {company.website ? (
                <a
                  href={company.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 hover:underline"
                >
                  {company.name}
                </a>
              ) : (
                <span>{company.name}</span>
              )}
            </div>
          )
        }

        {
          location && (
            <div data-pagefind-ignore class="flex items-center gap-1.5">
              <IconMapPin class="size-4" />
              <span>{location}</span>
            </div>
          )
        }

        {
          value && (
            <div class="flex items-center gap-1.5">
              <IconCoin class="size-4" />
              <span>{value}</span>
            </div>
          )
        }

        <div class="flex items-center gap-1.5">
          <IconCalendarWeek class="size-4" />
          <span
            data-pagefind-meta={`date:${new Date(postedDate).toISOString()}`}
            data-pagefind-ignore
          >
            Posted: <FormattedDate date={new Date(postedDate)} />
          </span>
        </div>

        {
          closingDate && !isClosed && (
            <span
              data-pagefind-ignore
              class="flex items-center gap-1 font-medium text-foreground italic hover:underline hover:underline-offset-1"
            >
              <IconPoint class="h-3 w-3 fill-destructive text-destructive" />
              Closes: <FormattedDate date={new Date(closingDate)} />
            </span>
          )
        }
      </div>
    </header>

    <div class="mx-auto prose max-w-6xl dark:prose-invert">
      <PortableText portableText={vacancy.body} />
    </div>

    <ShareBar
      class="justify-center"
      label="Share this opportunity"
      title={vacancy.title}
      url={opportunityPath(vacancy)}
    />

    <div class="space-y-4 border-t pt-8" data-pagefind-ignore>
      {
        isClosed ? (
          <div class="rounded-lg bg-destructive/10 p-4 text-center text-destructive">
            <p class="font-medium">
              This {isJob ? "position" : "opportunity"} is closed.
            </p>
          </div>
        ) : (
          <div class="flex flex-col items-center gap-4 text-center">
            <h3 class="text-xl font-semibold">
              Interested in this {isJob ? "role" : kindLabel.toLowerCase()}?
            </h3>
            <p class="text-sm text-muted-foreground">
              {applyUrl
                ? "Review the details above, then apply before the deadline."
                : "Please review the details above and apply via the method described."}
            </p>
            {applyUrl && (
              <Button
                href={applyUrl}
                target="_blank"
                rel="noopener noreferrer"
                size="lg"
                class="rounded-full"
              >
                {isJob ? "Apply now" : "Apply / learn more"}
                <IconArrowUpRight />
              </Button>
            )}
          </div>
        )
      }
    </div>
  </article>
</PageLayout>
