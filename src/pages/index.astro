---
import AnnouncementRibbon, {
  type Announcement,
} from "@/components/astro/AnnouncementRibbon.astro";
import BannersArchive from "@/components/sections/BannersArchive.astro";
import BlogsArchive from "@/components/sections/BlogsArchive.astro";
import Faq from "@/components/sections/Faq.astro";
import HeroCarousel from "@/components/sections/HeroCarousel.astro";
import MemberSpotlight from "@/components/sections/MemberSpotlight.astro";
import Memberships from "@/components/sections/Memberships.astro";
import MissionBrief from "@/components/sections/MissionBrief.astro";
import UpcomingEvents from "@/components/sections/UpcomingEvents.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { organizationLd } from "@/lib/structured-data";
import { getContactsDetails } from "@/sanity/lib/queries/contacts";
import { getHomePage } from "@/sanity/lib/queries/home";
import { getPosts } from "@/sanity/lib/queries/posts";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const allNotices = (await getPosts("notice")) || [];
const latestNotice = allNotices?.[0];
// The latest notice gets its own slot, so don't repeat it if it's also featured.
const featuredNotices = allNotices.filter(
  (post) => post.featured && post._id !== latestNotice?._id,
);
const homePage = await getHomePage();
const contacts = await getContactsDetails();

const announcements: Announcement[] = [
  ...(latestNotice
    ? [
        {
          label: "Latest Update",
          message: latestNotice.title,
          href: `/notices/${latestNotice.slug}/`,
          linkText: "Read more",
        },
      ]
    : []),
  ...featuredNotices.map((notice) => ({
    label: "Notice",
    message: notice.title,
    href: `/notices/${notice.slug}/`,
    linkText: "Read more",
  })),
];
---

<PageLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  dataPagefindIgnore="all"
>
  <JsonLd slot="head" data={organizationLd(Astro.site!, contacts)} />
  {
    announcements.length > 0 && (
      <AnnouncementRibbon
        id="home-announcements"
        announcements={announcements}
        rotationInterval={6}
        dismissDuration={12}
      />
    )
  }
  <HeroCarousel slides={homePage.carousel} />
  <UpcomingEvents />

  <MissionBrief objective={homePage.objective} bylaws={homePage.bylaws} />
  <Memberships membership={homePage.membership} />
  <MemberSpotlight />
  <BannersArchive />
  <BlogsArchive />
  <Faq />
</PageLayout>
