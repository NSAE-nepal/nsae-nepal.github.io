---
import AnnouncementRibbon, {
  type Announcement,
} from "@/components/astro/AnnouncementRibbon.astro";
import BannersArchive from "@/components/sections/BannersArchive.astro";
import BlogsArchive from "@/components/sections/BlogsArchive.astro";
import Faq from "@/components/sections/Faq.astro";
import HeroCarousel from "@/components/sections/HeroCarousel.astro";
import Memberships from "@/components/sections/Memberships.astro";
import MissionBrief from "@/components/sections/MissionBrief.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { getHomePage } from "@/sanity/lib/queries/home";
import { getPosts } from "@/sanity/lib/queries/posts";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

const allNotices = (await getPosts("notice")) || [];
const featuredNotices = allNotices.filter((post) => post.featured);
const latestNotice = allNotices?.[0];
const homePage = await getHomePage();

const announcements: Announcement[] = [
  ...(latestNotice
    ? [
        {
          label: "Latest Update",
          message: latestNotice.title,
          href: `/notices/${latestNotice.slug}/`,
          linkText: "Read more",
        },
      ]
    : []),
  ...featuredNotices.map((notice) => ({
    label: "Notice",
    message: notice.title,
    href: `/notices/${notice.slug}/`,
    linkText: "Read more",
  })),
];
---

<PageLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  dataPagefindIgnore="all"
>
  {
    announcements.length > 0 && (
      <AnnouncementRibbon
        id="home-announcements"
        announcements={announcements}
        rotationInterval={6}
        dismissDuration={12}
      />
    )
  }
  <HeroCarousel slides={homePage.carousel} />

  <MissionBrief objective={homePage.objective} bylaws={homePage.bylaws} />
  <Memberships membership={homePage.membership} />
  <BannersArchive />
  <BlogsArchive />
  <Faq />
</PageLayout>
