---
import type { GetStaticPaths } from "astro";
import BlogListing from "@/components/pages/blog/BlogListing.astro";
import { PAGE_SIZE } from "@/consts";
import { summarizeCategories } from "@/lib/categories";
import { getPosts } from "@/sanity/lib/queries/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getPosts("blog")) ?? [];

  return paginate(
    posts.filter((post) => !post.featured),
    {
      pageSize: PAGE_SIZE,
      props: {
        featuredPosts: posts.filter((post) => post.featured),
        categories: summarizeCategories(posts),
      },
    },
  );
}) satisfies GetStaticPaths;

const { page, featuredPosts, categories } = Astro.props;
---

<BlogListing page={page} featuredPosts={featuredPosts} categories={categories} />
