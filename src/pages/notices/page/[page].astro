---
import type { GetStaticPaths } from "astro";
import NoticeListing from "@/components/pages/notices/NoticeListing.astro";
import { PAGE_SIZE } from "@/consts";
import { summarizeCategories } from "@/lib/categories";
import { getPosts } from "@/sanity/lib/queries/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const notices = (await getPosts("notice")) ?? [];

  return paginate(notices, {
    pageSize: PAGE_SIZE,
    props: { categories: summarizeCategories(notices) },
  });
}) satisfies GetStaticPaths;

const { page, categories } = Astro.props;
---

<NoticeListing page={page} categories={categories} />
