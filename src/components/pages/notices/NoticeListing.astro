---
import { Image } from "astro:assets";
import type { Page } from "astro";
import Badge from "@/components/astro/Badge.astro";
import BlogCard from "@/components/astro/Card/BlogCard.astro";
import ClickableCard from "@/components/astro/Card/ClickableCard.astro";
import Empty from "@/components/astro/Empty.astro";
import Pagination from "@/components/astro/Pagination.astro";
import FilterChips from "@/components/FilterChips.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { type CategorySummary, categoryPath } from "@/lib/categories";
import type { Post } from "@/sanity/lib/queries/posts";
import { sanityImage } from "@/sanity/lib/url-for-image";

/**
 * Notices listing, shared by /notices/page/[page] and
 * /notices/category/[category]/page/[page].
 */
interface Props {
  page: Page<Post>;
  categories: CategorySummary[];
  activeCategory?: CategorySummary;
}

const { page, categories, activeCategory } = Astro.props;
const pageTitle = activeCategory
  ? `${activeCategory.title} – Notices`
  : "Notices";
const pageDescription = activeCategory
  ? `NSAE notices about ${activeCategory.title}.`
  : "Updates, announcements, and official notices.";
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  dataPagefindIgnore="all"
  page="notice-listing"
>
  <header class="flex flex-col items-center justify-center py-16 md:py-24">
    <div class="anim-header-badge scale-50 opacity-0">
      <Badge
        variant={"secondary"}
        size={"sm"}
        class="mb-3 border border-border/50 font-mono text-xs tracking-widest uppercase"
      >
        Announcements
      </Badge>
    </div>
    <h1
      class="anim-header-title invisible max-w-4xl pt-4 text-center font-sans text-5xl leading-tight font-medium tracking-tighter md:text-7xl"
    >
      Notices & Updates
    </h1>
  </header>

  <section class="mb-12" data-manual-card-anim>
    <h2
      class="anim-section-title mb-8 translate-y-4 border-b border-border/50 pb-2 font-sans text-xl font-medium tracking-wider uppercase opacity-0 md:text-2xl"
    >
      {activeCategory ? activeCategory.title : "Latest Notices"}
    </h2>
    <FilterChips
      label="Filter notices by category"
      allHref={categoryPath("/notices")}
      options={categories.map((category) => ({
        href: categoryPath("/notices", category.slug),
        label: category.title,
        count: category.count,
        active: category.slug === activeCategory?.slug,
      }))}
    />

    {
      page.data.length > 0 ? (
        <>
          <div class="grid grid-cols-2">
            {page.data.map((post: Post, index) => (
              <>
                <ClickableCard
                  class="anim-card group relative col-span-2 translate-y-4 opacity-0 transition-colors hover:bg-secondary/60"
                  href={`/notices/${post.slug}/`}
                  label={post.title}
                >
                  <BlogCard data={post} href={`/notices/${post.slug}/`} />

                  {post.heroImage && (
                    <Image
                      inferSize
                      class="absolute top-0 right-0 z-0 hidden h-full w-1/4 object-cover opacity-40 grayscale transition-all duration-500 group-hover:block group-hover:grayscale-0"
                      src={sanityImage(post.heroImage, { width: 480 })}
                      alt={post.heroImageAlt ?? ""}
                    />
                  )}
                </ClickableCard>
                {index < page.data.length - 1 && (
                  <div class="anim-divider col-span-2 my-6 translate-y-4 border-b-2 border-dashed border-secondary-foreground opacity-0" />
                )}
              </>
            ))}
          </div>
          <div class="anim-pagination mt-16 flex justify-center opacity-0">
            <Pagination
              url={page.url}
              class="font-mono text-sm tracking-widest uppercase"
            />
          </div>
        </>
      ) : (
        <div class="anim-empty-state scale-95 opacity-0">
          <Empty
            description="We haven't published any official notices yet. Please check back later."
            title="No notices found"
          />
        </div>
      )
    }
  </section>
</PageLayout>
<script>
  import { startCardHover } from "@/utils/animations/cards-split-text-animation";
  import { animateListingHeader } from "@/utils/animations/listing-header";
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-page="notice-listing"]', (scope) => {
    const { root } = scope;
    const mainTl = animateListingHeader(
      gsap.timeline({ defaults: { ease: "power3.out" } }),
      root,
      { sectionTitle: { at: "-=0.7", ease: "power2.out" } },
    );

    if (root.querySelector(".anim-card")) {
      mainTl
        .to(
          ".anim-card, .anim-divider",
          {
            y: 0,
            opacity: 1,
            duration: 0.5,
            stagger: 0.08,
            ease: "power2.out",
          },
          "-=0.4",
        )
        .add(startCardHover(scope), "<");
    }

    if (root.querySelector(".anim-pagination")) {
      mainTl.to(".anim-pagination", { opacity: 1, duration: 0.5 }, "-=0.2");
    }

    if (root.querySelector(".anim-empty-state")) {
      mainTl.to(
        ".anim-empty-state",
        { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.2)" },
        "-=0.3",
      );
    }
  });
</script>
