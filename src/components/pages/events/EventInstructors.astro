---
import { Image } from "astro:assets";
import { IconBuilding, IconUser, IconWorld } from "@tabler/icons-astro";

import type {
  EventDetails,
  Instructor,
  Representative,
} from "@/sanity/lib/queries/events";
import { sanityImage } from "@/sanity/lib/url-for-image";

interface Props {
  instructors: EventDetails["instructors"];
}

const { instructors: rawInstructors } = Astro.props;
const instructors: Instructor[] = rawInstructors ?? [];

interface DisplayProfile {
  id: string;
  name: string;
  role: string;
  position?: string;
  company?: string;
  website?: string;
  image?: string;
  isOrg: boolean;
  representatives?: Representative[];
}

const displayProfiles: DisplayProfile[] = instructors.map((inst, index) => {
  const uniqueId = `inst-${index}`;

  if (inst._type === "instructorNsaeMember") {
    return {
      id: uniqueId,
      name: inst.nsaeMember?.name || "Unknown Member",
      role: inst.eventRole || "Instructor",
      position: inst.nsaeMember?.position || "NSAE Member",
      company: inst.nsaeMember?.company,
      image: inst.nsaeMember?.profileImage,
      isOrg: false,
    };
  }

  if (inst._type === "instructorOrganization") {
    return {
      id: uniqueId,
      name: inst.organizationName,
      role: "Partner Organization",
      position: inst.description,
      website: inst.website,
      company: undefined,
      image: inst.logo,
      isOrg: true,
      representatives: inst.representatives,
    };
  }

  return {
    id: uniqueId,
    name: inst.name,
    role: inst.eventRole || "Instructor",
    position: inst.position,
    company: inst.company,
    image: inst.profileImage,
    isOrg: false,
  };
});
---

{
  displayProfiles.length > 0 && (
    <div class="rounded-lg border bg-card text-card-foreground">
      <div class="p-6">
        <h3 class="mb-6 font-sans text-xl font-medium tracking-tight">
          Instructors & Speakers
        </h3>

        <div class="flex flex-col gap-8">
          {displayProfiles.map((profile) => {
            if (profile.isOrg) {
              return (
                <div>
                  <div class="group flex items-start gap-4">
                    <div class="relative flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full border border-border/50 bg-background">
                      {profile.image ? (
                        <Image
                          src={sanityImage(profile.image, {
                            width: 96,
                            height: 96,
                          })}
                          alt={profile.name}
                          inferSize
                          class="h-full w-full object-contain p-1.5 transition-transform duration-300 group-hover:scale-110"
                        />
                      ) : (
                        <IconBuilding class="size-6 text-muted-foreground/50" />
                      )}
                    </div>

                    <div class="min-w-0 flex-1 pt-0.5">
                      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                        <h4 class="font-sans text-sm leading-none font-medium">
                          {profile.name}
                        </h4>
                        <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] font-medium tracking-wider text-muted-foreground uppercase">
                          Organization
                        </span>
                      </div>

                      <div class="mt-1 flex flex-col gap-1">
                        {profile.position && (
                          <p class="line-clamp-2 font-sans text-xs text-muted-foreground">
                            {profile.position}
                          </p>
                        )}
                        {profile.website && (
                          <a
                            href={profile.website}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex w-fit items-center gap-1 text-xs text-primary/80 hover:text-primary hover:underline"
                          >
                            <IconWorld class="size-3" />
                            <span>Visit Website</span>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>

                  {profile.representatives &&
                    profile.representatives.length > 0 && (
                      <div class="mt-4 ml-6 flex flex-col gap-3 border-l-2 border-muted pl-6">
                        {profile.representatives.map((rep) => (
                          <div class="group/rep flex items-start gap-3">
                            <div class="relative flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-full border border-border/50 bg-background">
                              {rep.profileImage ? (
                                <Image
                                  src={sanityImage(rep.profileImage, {
                                    width: 64,
                                    height: 64,
                                  })}
                                  alt={rep.name}
                                  inferSize
                                  class="h-full w-full object-cover transition-transform duration-300 group-hover/rep:scale-110"
                                />
                              ) : (
                                <IconUser class="size-4 text-muted-foreground/50" />
                              )}
                            </div>

                            <div class="min-w-0 flex-1 pt-0.5">
                              <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
                                <p class="text-sm leading-tight font-medium">
                                  {rep.name}
                                </p>
                                <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] font-medium tracking-wider text-muted-foreground uppercase">
                                  {rep.eventRole || "Representative"}
                                </span>
                              </div>
                              {rep.position && (
                                <p class="mt-0.5 line-clamp-1 font-sans text-xs text-muted-foreground">
                                  {rep.position}
                                </p>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>
                    )}
                </div>
              );
            }

            return (
              <div class="group flex items-start gap-4">
                <div class="relative flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full border border-border/50 bg-muted">
                  {profile.image ? (
                    <Image
                      src={sanityImage(profile.image, {
                        width: 96,
                        height: 96,
                      })}
                      alt={profile.name}
                      inferSize
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-110"
                    />
                  ) : (
                    <IconUser class="size-6 text-muted-foreground/50" />
                  )}
                </div>

                <div class="min-w-0 flex-1 pt-0.5">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <p class="font-sans text-sm leading-none font-medium">
                      {profile.name}
                    </p>
                    <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] font-medium tracking-wider text-muted-foreground uppercase">
                      {profile.role}
                    </span>
                  </div>

                  <div class="mt-1 flex flex-col">
                    <p class="line-clamp-1 font-sans text-xs text-muted-foreground">
                      {profile.position && (
                        <span class="capitalize">{profile.position}</span>
                      )}
                      {profile.company && profile.position && (
                        <span class="mx-1.5 opacity-40">•</span>
                      )}
                      {profile.company && (
                        <span class="font-medium text-foreground/80">
                          {profile.company}
                        </span>
                      )}
                    </p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  )
}
