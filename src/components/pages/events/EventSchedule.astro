---
import { IconClock, IconMapPin, IconUser } from "@tabler/icons-astro";

import type { EventDetails } from "@/sanity/lib/queries/events";
import { formatDate, formatTime } from "@/utils/datetime";

interface Props {
  schedule: EventDetails["eventSchedule"];
}
const { schedule } = Astro.props;

const sessionsByDay: Record<string, typeof schedule> = {};

if (schedule) {
  schedule.forEach((session) => {
    const dayLabel =
      session.dayLabel ||
      formatDate(new Date(session.day), {
        weekday: "long",
        month: "short",
        day: "numeric",
      });
    if (!sessionsByDay[dayLabel]) {
      sessionsByDay[dayLabel] = [];
    }
    sessionsByDay[dayLabel]?.push(session);
  });
}
---

{
  Object.keys(sessionsByDay).length > 0 && (
    <section>
      <h2 class="mb-6 font-sans text-2xl font-medium tracking-tight">
        Schedule
      </h2>
      <div class="flex flex-col gap-8">
        {Object.entries(sessionsByDay).map(([dayLabel, sessions]) => (
          <div class="rounded-xl border bg-card p-4 text-card-foreground">
            <h3 class="text-center font-sans text-lg leading-none font-medium tracking-tight">
              {dayLabel}
            </h3>
            <div class="mt-4 flex flex-col gap-4 pt-0">
              {sessions?.map((session) => (
                <div class="group relative grid gap-1 border-l-2 border-muted pb-4 pl-4 transition-colors last:pb-0 hover:border-primary">
                  <p class="flex flex-row items-center gap-1 font-mono text-xs leading-none tracking-wide text-muted-foreground uppercase">
                    <IconClock class="size-4 shrink-0" />
                    {formatTime(new Date(session.startTime))} –{" "}
                    {formatTime(new Date(session.endTime))}
                  </p>
                  <p class="font-sans text-lg leading-none font-medium">
                    {session.sessionTitle}
                  </p>
                  <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 font-sans text-sm text-muted-foreground">
                    {session.location && (
                      <span class="flex items-center gap-1">
                        <IconMapPin class="h-3.5 w-3.5" /> {session.location}
                      </span>
                    )}
                    {session.speaker && (
                      <span class="flex items-center gap-1">
                        <IconUser class="size-4" /> {session.speaker}
                      </span>
                    )}
                  </div>
                  {session.description && (
                    <p class="mt-2 font-sans text-sm text-muted-foreground">
                      {session.description}
                    </p>
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  )
}
