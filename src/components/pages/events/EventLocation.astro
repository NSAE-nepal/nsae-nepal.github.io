---
import { IconLink, IconMap } from "@tabler/icons-astro";
import type { LocationDetails } from "@/sanity/lib/queries/events";

interface Props {
  location?: LocationDetails;
}
const { location } = Astro.props;
---

{
  location && (
    <div class="rounded-lg border bg-card text-card-foreground">
      <div class="p-6">
        <h3 class="mb-4 font-sans text-xl font-medium tracking-tight">
          Event Details
        </h3>
        <div class="flex flex-col gap-3 text-sm">
          {location.type !== "online" && (
            <>
              {location.venueName && (
                <span class="font-sans text-base font-medium">
                  {location.venueName}
                </span>
              )}
              {(location.address || location.city) && (
                <span class="font-sans text-muted-foreground">
                  {[location.address, location.city, location.state]
                    .filter(Boolean)
                    .join(", ")}
                </span>
              )}
              {location.mapsLink && (
                <a
                  href={location.mapsLink}
                  target="_blank"
                  class="mt-1 flex items-center gap-2 font-mono text-xs tracking-widest text-primary uppercase hover:underline"
                >
                  <IconMap class="h-4 w-4" /> View on Map
                </a>
              )}
            </>
          )}
          {location.type !== "in_person" && (
            <div class="mt-2 flex flex-col gap-2 border-t border-dashed pt-2">
              {location.meetingUrl && (
                <a
                  href={location.meetingUrl}
                  target="_blank"
                  class="flex items-center gap-2 font-mono text-xs tracking-widest text-primary uppercase hover:underline"
                >
                  <IconLink class="h-4 w-4" /> Join Online Meeting
                </a>
              )}
              {location.meetingId && (
                <p class="font-sans">
                  Meeting ID:{" "}
                  <span class="ml-1 rounded bg-muted px-1 font-mono">
                    {location.meetingId}
                  </span>
                </p>
              )}
              {location.meetingPassword && (
                <p class="font-sans">
                  Password:{" "}
                  <span class="ml-1 rounded bg-muted px-1 font-mono">
                    {location.meetingPassword}
                  </span>
                </p>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  )
}
