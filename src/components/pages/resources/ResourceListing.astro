---
import type { Page } from "astro";
import { IconBooks } from "@tabler/icons-astro";
import Badge from "@/components/astro/Badge.astro";
import ClickableCard from "@/components/astro/Card/ClickableCard.astro";
import ResourceCard from "@/components/astro/Card/ResourceCard.astro";
import Empty from "@/components/astro/Empty.astro";
import Pagination from "@/components/astro/Pagination.astro";
import FilterChips from "@/components/FilterChips.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import {
  type ResourceTypeSummary,
  resourcePath,
  resourcesPath,
} from "@/lib/resources";
import type { Resource } from "@/sanity/lib/queries/resources";

/**
 * Resource library listing, shared by /resources/page/[page] and
 * /resources/type/[type]/page/[page].
 */
interface Props {
  page: Page<Resource>;
  types: ResourceTypeSummary[];
  activeType?: ResourceTypeSummary;
}

const { page, types, activeType } = Astro.props;

const pageTitle = [
  activeType ? `${activeType.label} resources` : "Resource library",
  page.currentPage > 1 ? `page ${page.currentPage}` : "",
]
  .filter(Boolean)
  .join(", ");
const pageDescription =
  "Standards, manuals, guidelines, reports, templates and tools for agricultural engineers, free to download.";
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  dataPagefindIgnore="all"
  page="resource-listing"
>
  <header
    class="flex flex-col items-center justify-center py-16 text-center md:py-24"
  >
    <div class="anim-header-badge js:scale-50 js:opacity-0">
      <Badge
        variant="secondary"
        size="sm"
        class="mb-3 border border-border/50 font-mono text-xs tracking-widest uppercase"
      >
        Resource library
      </Badge>
    </div>
    <h1
      class="anim-header-title max-w-4xl pt-4 font-sans text-5xl leading-tight font-medium tracking-tighter md:text-7xl js:invisible"
    >
      Tools of the trade
    </h1>
    <p
      class="anim-header-desc mt-6 max-w-2xl font-sans text-lg text-muted-foreground js:translate-y-4 js:opacity-0"
    >
      {pageDescription}
    </p>
  </header>

  <section class="mb-16" aria-labelledby="resources-heading">
    <h2
      id="resources-heading"
      class="anim-section-title mb-8 border-b border-border/50 pb-2 font-sans text-xl font-medium tracking-wider uppercase md:text-2xl js:translate-y-4 js:opacity-0"
    >
      {activeType ? activeType.label : "All resources"}
    </h2>
    {
      types.length > 1 && (
        <FilterChips
          label="Filter resources by type"
          allHref={resourcesPath()}
          options={types.map((type) => ({
            href: resourcesPath(type.value),
            label: type.label,
            count: type.count,
            active: type.value === activeType?.value,
          }))}
        />
      )
    }

    {
      page.data.length > 0 ? (
        <>
          <ul class="grid gap-6 md:grid-cols-2" role="list">
            {page.data.map((resource) => (
              <li class="anim-card js:translate-y-4 js:opacity-0">
                <ClickableCard
                  href={resourcePath(resource)}
                  label={resource.title}
                  class="h-full rounded-2xl border border-border/60 bg-secondary/30 transition-colors hover:bg-secondary/70"
                >
                  <ResourceCard data={resource} />
                </ClickableCard>
              </li>
            ))}
          </ul>
          <div class="anim-pagination mt-16 flex justify-center js:opacity-0">
            <Pagination
              url={page.url}
              class="font-mono text-sm tracking-widest uppercase"
            />
          </div>
        </>
      ) : (
        <div class="anim-empty-state js:scale-95 js:opacity-0">
          <Empty
            title="The library is being stocked"
            description="We're collecting standards, manuals and guidelines for members. Please check back soon."
          >
            <IconBooks slot="icon" class="size-8 text-muted-foreground" />
          </Empty>
        </div>
      )
    }
  </section>
</PageLayout>

<script>
  import { animateListingHeader } from "@/utils/animations/listing-header";
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-page="resource-listing"]', ({ root }) => {
    const tl = animateListingHeader(
      gsap.timeline({ defaults: { ease: "power3.out" } }),
      root,
    );

    if (root.querySelector(".anim-card")) {
      tl.to(
        ".anim-card",
        { y: 0, opacity: 1, duration: 0.6, stagger: 0.08 },
        "-=0.2",
      );
    } else {
      tl.to(
        ".anim-empty-state",
        { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.2)" },
        "-=0.2",
      );
    }

    if (root.querySelector(".anim-pagination")) {
      tl.to(".anim-pagination", { opacity: 1, duration: 0.5 }, "-=0.2");
    }
  });
</script>
