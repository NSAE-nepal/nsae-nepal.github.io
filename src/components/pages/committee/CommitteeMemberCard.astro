---
import { Image } from "astro:assets";
import { IconArrowUpRight, IconUserCircle } from "@tabler/icons-astro";
import { cn, formatName } from "@/lib/utils";
import { type CommitteeMember, positionLabel } from "@/sanity/lib/queries/committee";
import { sanityImage } from "@/sanity/lib/url-for-image";

/** One committee member: photo, role, name, membership and registration. */
interface Props {
  member: CommitteeMember;
  class?: string;
}

const { member, class: className } = Astro.props;
const name = formatName(member.name, member.prefix);
const registrations = [
  member.neaRegNo && `NEA ${member.neaRegNo}`,
  member.necRegNo && `NEC ${member.necRegNo}`,
].filter(Boolean);
---

<article
  class={cn(
    "flex h-full flex-col overflow-hidden rounded-2xl border border-border/60 bg-secondary/30",
    className,
  )}
>
  <div class="aspect-[4/5] overflow-hidden bg-muted">
    {
      member.profileImage ? (
        <Image
          src={sanityImage(member.profileImage, { width: 480, height: 600 })}
          width={480}
          height={600}
          widths={[240, 480]}
          sizes="(min-width: 1024px) 20vw, (min-width: 768px) 33vw, 50vw"
          alt=""
          class="size-full object-cover"
        />
      ) : (
        <div class="flex size-full items-center justify-center" aria-hidden="true">
          <IconUserCircle class="size-16 text-muted-foreground/50" />
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-1 p-4">
    <p class="font-mono text-[11px] uppercase tracking-wider text-primary">
      {positionLabel(member.position)}
    </p>
    <h3 class="font-sans font-medium leading-snug">{name}</h3>
    {
      member.membership && member.membership !== member.position && (
        <p class="text-xs text-muted-foreground">{positionLabel(member.membership)}</p>
      )
    }
    {
      registrations.length > 0 && (
        <p class="font-mono text-[11px] uppercase tracking-wider text-muted-foreground" data-pagefind-ignore>
          {registrations.join(" · ")}
        </p>
      )
    }
    {
      member.portfolio && (
        <a
          href={member.portfolio}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-auto inline-flex items-center gap-1 pt-2 font-mono text-xs uppercase tracking-wider text-primary hover:underline"
          data-pagefind-ignore
        >
          Profile <IconArrowUpRight class="size-3.5" aria-hidden="true" />
          <span class="sr-only">of {name} (opens in a new tab)</span>
        </a>
      )
    }
  </div>
</article>
