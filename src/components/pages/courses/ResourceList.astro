---
import { IconDownload, IconFile } from "@tabler/icons-astro";
import { formatFileSize } from "@/lib/courses";
import type { CourseResource } from "@/sanity/lib/queries/courses";

interface Props {
  resources: CourseResource[];
  title?: string;
  headingLevel?: "h2" | "h3";
}

const {
  resources,
  title = "Resources",
  headingLevel: Heading = "h2",
} = Astro.props;
---

{
  resources.length > 0 && (
    <section class="space-y-3" data-pagefind-ignore>
      <Heading class="font-sans text-lg font-medium tracking-tight">
        {title}
      </Heading>
      <ul class="space-y-2">
        {resources.map((resource) => (
          <li>
            <a
              href={`${resource.url}?dl=${encodeURIComponent(resource.filename ?? "")}`}
              class="group flex items-center gap-3 rounded-xl border border-border/60 p-3 transition-colors hover:border-primary/50 hover:bg-secondary/50"
            >
              <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-secondary">
                <IconFile class="size-4 text-primary" aria-hidden="true" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-medium">
                  {resource.title}
                </span>
                {resource.size && (
                  <span class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">
                    {formatFileSize(resource.size)}
                  </span>
                )}
              </span>
              <IconDownload
                class="size-4 text-muted-foreground transition-colors group-hover:text-primary"
                aria-hidden="true"
              />
              <span class="sr-only">Download</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
