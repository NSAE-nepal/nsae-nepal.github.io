---
import type { Page } from "astro";
import Badge from "@/components/astro/Badge.astro";
import CareersCard from "@/components/astro/Card/CareersCard.astro";
import ClickableCard from "@/components/astro/Card/ClickableCard.astro";
import Empty from "@/components/astro/Empty.astro";
import Pagination from "@/components/astro/Pagination.astro";
import FilterChips from "@/components/FilterChips.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import {
  type OpportunityTypeSummary,
  opportunitiesPath,
  opportunityPath,
} from "@/lib/opportunities";
import type { Vacancy } from "@/sanity/lib/queries/careers";

/**
 * Opportunities listing (jobs, scholarships, grants, trainings, …), shared by
 * /careers/page/[page] and /careers/type/[type]/page/[page].
 */
interface Props {
  page: Page<Vacancy>;
  types: OpportunityTypeSummary[];
  activeType?: OpportunityTypeSummary;
}

const { page, types, activeType } = Astro.props;

const pageTitle = [
  activeType ? `${activeType.label} opportunities` : "Opportunities",
  page.currentPage > 1 ? `page ${page.currentPage}` : "",
]
  .filter(Boolean)
  .join(", ");
const pageDescription =
  "Jobs, scholarships, fellowships, grants, trainings and calls for papers for agricultural engineers in Nepal.";
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  dataPagefindIgnore="all"
  page="opportunities-listing"
>
  <header
    class="flex flex-col items-center justify-center py-16 text-center md:py-24"
  >
    <div class="anim-header-badge scale-50 opacity-0">
      <Badge
        variant={"secondary"}
        size={"sm"}
        class="mb-3 border border-border/50 font-mono text-xs tracking-widest uppercase"
      >
        Opportunities
      </Badge>
    </div>
    <h1
      class="anim-header-title invisible max-w-4xl pt-4 font-sans text-5xl leading-tight font-medium tracking-tighter md:text-7xl"
    >
      Your Next Chapter Starts Here
    </h1>
    <p
      class="anim-header-desc mt-6 max-w-2xl translate-y-4 font-sans text-lg text-muted-foreground opacity-0"
    >
      {pageDescription}
    </p>
  </header>

  <section class="mb-12" data-manual-card-anim>
    <h2
      class="anim-section-title mb-8 translate-y-4 border-b border-border/50 pb-2 font-sans text-xl font-medium tracking-wider uppercase opacity-0 md:text-2xl"
    >
      {activeType ? activeType.label : "All opportunities"}
    </h2>
    {
      types.length > 1 && (
        <FilterChips
          label="Filter opportunities by type"
          allHref={opportunitiesPath()}
          options={types.map((type) => ({
            href: opportunitiesPath(type.value),
            label: type.label,
            count: type.count,
            active: type.value === activeType?.value,
          }))}
        />
      )
    }
    {
      page.data.length > 0 ? (
        <>
          <div class="grid grid-cols-2">
            {page.data.map((vacancy, index) => (
              <>
                <ClickableCard
                  class="anim-card group relative col-span-2 translate-y-4 opacity-0 transition-colors hover:bg-secondary/60"
                  href={opportunityPath(vacancy)}
                  label={vacancy.title}
                >
                  <CareersCard data={vacancy} />
                </ClickableCard>
                {index < page.data.length - 1 && (
                  <div class="anim-divider col-span-2 my-6 translate-y-4 border-b-2 border-dashed border-secondary-foreground opacity-0" />
                )}
              </>
            ))}
          </div>
          <div class="anim-pagination mt-16 flex justify-center opacity-0">
            <Pagination
              url={page.url}
              class="font-mono text-sm tracking-widest uppercase"
            />
          </div>
        </>
      ) : (
        <div class="anim-empty-state scale-95 opacity-0">
          <Empty
            title="No opportunities right now"
            description="We don't have any open jobs, scholarships or calls right now. Please check back later."
          />
        </div>
      )
    }
  </section>
</PageLayout>

<script>
  import { startCardHover } from "@/utils/animations/cards-split-text-animation";
  import { animateListingHeader } from "@/utils/animations/listing-header";
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-page="opportunities-listing"]', (scope) => {
    const { root } = scope;
    const tl = animateListingHeader(
      gsap.timeline({ defaults: { ease: "power3.out" } }),
      root,
      { sectionTitle: { ease: "power2.out" } },
    );

    if (root.querySelector(".anim-card")) {
      tl.to(
        ".anim-card, .anim-divider",
        { y: 0, opacity: 1, duration: 0.5, stagger: 0.08, ease: "power2.out" },
        "-=0.3",
      ).add(startCardHover(scope), "<");
    } else {
      tl.to(
        ".anim-empty-state",
        { scale: 1, opacity: 1, duration: 0.6, ease: "back.out(1.2)" },
        "-=0.2",
      );
    }

    if (root.querySelector(".anim-pagination")) {
      tl.to(".anim-pagination", { opacity: 1, duration: 0.5 }, "-=0.2");
    }
  });
</script>
