---
import { IconMoodEmpty } from "@tabler/icons-astro";
import type { Page } from "astro";
import Badge from "@/components/astro/Badge.astro";
import BlogFeaturedCard from "@/components/astro/Card/BlogFeaturedCard.astro";
import ClickableCard from "@/components/astro/Card/ClickableCard.astro";
import Pagination from "@/components/astro/Pagination.astro";
import PostGrid from "@/components/astro/PostGrid.astro";
import FilterChips from "@/components/FilterChips.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { type CategorySummary, categoryPath } from "@/lib/categories";
import type { Post } from "@/sanity/lib/queries/posts";

/**
 * Blog listing, shared by /blog/page/[page] and
 * /blog/category/[category]/page/[page].
 */
interface Props {
  page: Page<Post>;
  featuredPosts?: Post[];
  categories: CategorySummary[];
  activeCategory?: CategorySummary;
}

const { page, featuredPosts = [], categories, activeCategory } = Astro.props;
const pageTitle = activeCategory ? `${activeCategory.title} – Blog` : "Blog";
const pageDescription = activeCategory
  ? `Articles about ${activeCategory.title} from the Nepalese Society of Agricultural Engineers.`
  : "Read the latest articles and insights from our community.";
---

<PageLayout
  title={pageTitle}
  description={pageDescription}
  dataPagefindIgnore="all"
>
  <header class="flex flex-col items-center justify-center py-16 md:py-24">
    <div class="anim-header-badge scale-50 opacity-0">
      <Badge
        variant={"secondary"}
        size={"sm"}
        class="mb-3 border border-border/50 font-mono text-xs tracking-widest uppercase"
      >
        Blog & Articles
      </Badge>
    </div>
    <h1
      class="anim-header-title invisible max-w-4xl pt-4 text-center font-sans text-5xl leading-tight font-medium tracking-tighter md:text-7xl"
    >
      Read our latest articles
    </h1>
  </header>

  {
    featuredPosts.length > 0 && page.currentPage === 1 && (
      <section class="mb-12">
        <div class="mb-6 flex items-center justify-between border-b border-border/50 pb-2">
          <h2 class="anim-featured-title translate-y-4 font-sans text-xl font-medium tracking-wider uppercase opacity-0 md:text-2xl">
            Featured Posts
          </h2>
          {featuredPosts.length > 1 && (
            <div class="anim-featured-title flex translate-y-4 gap-2 opacity-0">
              <button
                type="button"
                class="featured-prev flex size-8 cursor-pointer items-center justify-center rounded-full border border-border/60 bg-secondary text-secondary-foreground transition-colors hover:bg-secondary/40 disabled:pointer-events-none disabled:opacity-30"
                aria-label="Previous featured post"
              >
                ‹
              </button>
              <button
                type="button"
                class="featured-next flex size-8 cursor-pointer items-center justify-center rounded-full border border-border/60 bg-secondary text-secondary-foreground transition-colors hover:bg-secondary/40 disabled:pointer-events-none disabled:opacity-30"
                aria-label="Next featured post"
              >
                ›
              </button>
            </div>
          )}
        </div>

        <div class="anim-featured-carousel flex snap-x snap-mandatory [scrollbar-width:none] gap-8 overflow-x-auto scroll-smooth pb-2 [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          {featuredPosts.map((post) => (
            <ClickableCard
              class="anim-featured-card shrink-0 basis-full translate-y-4 snap-start opacity-0 lg:basis-[85%]"
              href={`/blog/${post.slug}/`}
              label={post.title}
            >
              <BlogFeaturedCard data={post} />
            </ClickableCard>
          ))}
        </div>
      </section>
    )
  }

  <section class="mb-12" data-manual-card-anim>
    <h2
      class="anim-all-title mb-8 translate-y-4 border-b border-border/50 pb-2 font-sans text-xl font-medium tracking-wider uppercase opacity-0 md:text-2xl"
    >
      {activeCategory ? activeCategory.title : "All Posts"}
    </h2>
    <FilterChips
      label="Filter posts by category"
      allHref={categoryPath("/blog")}
      options={categories.map((category) => ({
        href: categoryPath("/blog", category.slug),
        label: category.title,
        count: category.count,
        active: category.slug === activeCategory?.slug,
      }))}
    />
    {
      page.data.length > 0 ? (
        <>
          <PostGrid
            posts={page.data}
            cardClass="anim-regular-card opacity-0 translate-y-4"
          />
          <div class="anim-pagination mt-16 flex justify-center opacity-0">
            <Pagination
              url={page.url}
              class="font-mono text-sm tracking-widest uppercase"
            />
          </div>
        </>
      ) : (
        <div class="anim-empty-state flex scale-95 flex-col items-center justify-center rounded-xl border border-dashed border-border/60 bg-secondary/5 py-8 text-center opacity-0">
          <div class="mb-4 rounded-full bg-secondary p-4">
            <IconMoodEmpty class="size-8 text-muted-foreground" />
          </div>
          <h3 class="mb-2 font-sans text-xl font-medium">No posts found</h3>
          <p class="mx-auto max-w-xs text-muted-foreground">
            We haven't published any regular articles yet. Check back soon or
            explore our featured stories above.
          </p>
        </div>
      )
    }
  </section>
</PageLayout>

<script>
  import { gsap, SplitText } from "@/utils/gsap-init";
  import { initCardSplitTextAnimation } from "@/utils/animations/cards-split-text-animation";
  let ctx: gsap.Context | undefined;
  function initBlogPage() {
    ctx = gsap.context(() => {
      const mainTl = gsap.timeline({
        defaults: { ease: "power3.out" },
      });

      const titleSplit = SplitText.create(".anim-header-title", {
        type: "lines, words",
        linesClass: "overflow-hidden",
      });

      mainTl
        .to(".anim-header-badge", {
          scale: 1,
          opacity: 1,
          duration: 0.6,
          ease: "back.out(1.5)",
        })
        .set(".anim-header-title", { autoAlpha: 1 }, "-=0.3")
        .from(
          titleSplit.words,
          {
            yPercent: 100,
            opacity: 0,
            duration: 0.8,
            stagger: 0.04,
            ease: "power4.out",
          },
          "<",
        );

      if (document.querySelector(".anim-featured-title")) {
        mainTl
          .to(
            ".anim-featured-title",
            {
              y: 0,
              opacity: 1,
              duration: 0.5,
            },
            "-=0.6",
          )
          .to(
            ".anim-featured-card",
            {
              y: 0,
              opacity: 1,
              duration: 0.6,
              stagger: 0.1,
            },
            "-=0.3",
          )
          .add(() => {
            initCardSplitTextAnimation({ cardSelector: ".anim-featured-card" });
          }, "<");
      }

      const featuredCarousel = document.querySelector(
        ".anim-featured-carousel",
      );
      const prevBtn = document.querySelector(".featured-prev");
      const nextBtn = document.querySelector(".featured-next");

      if (featuredCarousel && prevBtn && nextBtn) {
        const cards = featuredCarousel.querySelectorAll(".anim-featured-card");

        const scrollByCard = (direction: 1 | -1) => {
          const card = cards[0] as HTMLElement;
          const gap = parseFloat(
            getComputedStyle(featuredCarousel).columnGap || "0",
          );
          const amount =
            (card?.offsetWidth ?? featuredCarousel.clientWidth) + gap;
          featuredCarousel.scrollBy({
            left: amount * direction,
            behavior: "smooth",
          });
        };

        const updateButtons = () => {
          const maxScroll =
            featuredCarousel.scrollWidth - featuredCarousel.clientWidth;
          prevBtn.toggleAttribute("disabled", featuredCarousel.scrollLeft <= 4);
          nextBtn.toggleAttribute(
            "disabled",
            featuredCarousel.scrollLeft >= maxScroll - 4,
          );
        };

        prevBtn.addEventListener("click", () => scrollByCard(-1));
        nextBtn.addEventListener("click", () => scrollByCard(1));
        featuredCarousel.addEventListener("scroll", updateButtons, {
          passive: true,
        });
        updateButtons();
      }

      const regularPostOffset = document.querySelector(".anim-featured-title")
        ? "-=0.3"
        : "-=0.6";

      mainTl.to(
        ".anim-all-title",
        {
          y: 0,
          opacity: 1,
          duration: 0.5,
        },
        regularPostOffset,
      );

      if (document.querySelector(".anim-regular-card")) {
        mainTl
          .to(
            ".anim-regular-card",
            {
              y: 0,
              opacity: 1,
              duration: 0.5,
              stagger: 0.08,
              ease: "power2.out",
            },
            "-=0.3",
          )
          .add(() => {
            initCardSplitTextAnimation({ cardSelector: ".anim-regular-card" });
          }, "<");
      }

      if (document.querySelector(".anim-pagination")) {
        mainTl.to(
          ".anim-pagination",
          {
            opacity: 1,
            duration: 0.5,
          },
          "-=0.2",
        );
      }

      if (document.querySelector(".anim-empty-state")) {
        mainTl.to(
          ".anim-empty-state",
          {
            scale: 1,
            opacity: 1,
            duration: 0.6,
            ease: "back.out(1.2)",
          },
          "-=0.3",
        );
      }
    });
  }
  document.addEventListener("astro:page-load", initBlogPage);
  document.addEventListener("astro:before-swap", () => ctx?.revert());
</script>
