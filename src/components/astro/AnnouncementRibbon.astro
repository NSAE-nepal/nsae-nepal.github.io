---
import { IconX } from "@tabler/icons-astro";

export interface Announcement {
  label?: string;
  message: string;
  href?: string;
  linkText?: string;
}

interface Props {
  id?: string;
  announcements: Announcement[];
  rotationInterval?: number; // seconds
  dismissible?: boolean;
  dismissDuration?: number; // hours
  style?: "default" | "prominent" | "subtle";
  class?: string;
}

const {
  id = "global-announcement",
  announcements,
  rotationInterval = 5,
  dismissible = true,
  dismissDuration = 24,
  style = "default",
  class: className,
} = Astro.props;

const items = announcements ?? [];

const hashContent = (str: string) => {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = (hash << 5) - hash + str.charCodeAt(i);
    hash |= 0;
  }
  return Math.abs(hash).toString(36);
};

const contentSignature = items
  .map((a) => `${a.label ?? ""}-${a.message}`)
  .join("|");
const storageKey = `announcement-dismissed-${id}-${hashContent(contentSignature)}`;
---

{
  items.length > 0 && (
    <div
      role="region"
      aria-label="Announcements"
      aria-roledescription="carousel"
      id={id}
      data-storage-key={storageKey}
      data-rotation-interval={rotationInterval}
      class:list={[
        "announcement-ribbon mb-4 flex items-center gap-2 rounded-md bg-foreground px-4 py-2 text-sm text-background transition-opacity duration-300 md:py-1.5",
        {
          "font-bold": style === "prominent",
          "opacity-70": style === "subtle",
        },
        className,
      ]}
    >
      {dismissible && (
        <button
          type="button"
          aria-label="Close announcement"
          class="close-ribbon-btn mr-4 shrink-0 cursor-pointer transition-opacity hover:opacity-70 md:mr-8"
        >
          <IconX class="h-3 w-3" />
        </button>
      )}

      <div class="flex-1 overflow-hidden">
        <div class="announcement-content flex flex-wrap items-baseline gap-1 transition-all duration-300 ease-in-out md:gap-2">
          <span class="announcement-label font-mono text-xs tracking-widest uppercase opacity-80">
            {items[0].label ?? "Announcement"}:
          </span>
          <span class="announcement-message line-clamp-1 overflow-hidden font-medium">
            {items[0].message}
          </span>
          {items[0].href && (
            <a
              class="announcement-link ml-1 italic underline decoration-1 underline-offset-2 transition-colors hover:opacity-80"
              href={items[0].href}
            >
              {items[0].linkText ?? "Learn more"}
            </a>
          )}
        </div>
      </div>

      {items.length > 1 && (
        <div class="announcement-dots flex shrink-0 gap-1">
          {items.map((_, index) => (
            <button
              type="button"
              aria-label={`Go to announcement ${index + 1}`}
              data-index={index}
              class:list={[
                "announcement-dot h-1.5 w-1.5 rounded-full transition-all duration-300",
                index === 0
                  ? "scale-110 bg-background opacity-100"
                  : "scale-100 bg-background/40 opacity-60 hover:opacity-80",
              ]}
            />
          ))}
        </div>
      )}
    </div>
  )
}

{
  /*
   * Hide a dismissed ribbon before first paint. It sits outside the conditional
   * above because prettier-plugin-astro 0.14 can't parse scripts inside template
   * expressions; it is a no-op when there is no ribbon. define:vars already
   * wraps the code in a function.
   */
}
<script is:inline data-astro-rerun define:vars={{ id, storageKey }}>
  const dismissedAt = localStorage.getItem(storageKey);
  if (dismissedAt && Date.now() < parseInt(dismissedAt, 10)) {
    const ribbon = document.getElementById(id);
    if (ribbon) ribbon.style.display = "none";
  } else if (dismissedAt) {
    localStorage.removeItem(storageKey);
  }
</script>

<script
  define:vars={{ id, storageKeyClient: storageKey, items, dismissDuration }}
>
  function checkDismissed(ribbon) {
    const dismissedAt = localStorage.getItem(storageKeyClient);

    if (dismissedAt && Date.now() < parseInt(dismissedAt, 10)) {
      ribbon.style.display = "none";
      return true;
    }

    if (dismissedAt) {
      localStorage.removeItem(storageKeyClient);
    }

    ribbon.style.display = "";
    return false;
  }

  // Stops this page's ribbon (rotation, pending transitions, listeners). The
  // ribbon is on the home page only, so it is torn down on every swap.
  let teardown = null;

  function initRibbon() {
    const ribbon = document.getElementById(id);
    if (!ribbon) return;

    if (checkDismissed(ribbon)) return;

    if (ribbon.dataset.initialized === "true") return;
    ribbon.dataset.initialized = "true";

    const contentEl = ribbon.querySelector(".announcement-content");
    const labelEl = ribbon.querySelector(".announcement-label");
    const messageEl = ribbon.querySelector(".announcement-message");
    const dots = Array.from(ribbon.querySelectorAll(".announcement-dot"));
    const closeBtn = ribbon.querySelector(".close-ribbon-btn");
    const rotationIntervalMs =
      parseFloat(ribbon.dataset.rotationInterval || "5") * 1000;

    let currentIndex = 0;
    let isTransitioning = false;
    let timer = null;
    const timeouts = new Set();
    const controller = new AbortController();
    const { signal } = controller;

    const later = (fn, ms) => {
      const handle = setTimeout(() => {
        timeouts.delete(handle);
        fn();
      }, ms);
      timeouts.add(handle);
    };

    function renderIndex(index) {
      const item = items[index];
      if (!item || !contentEl) return;

      if (labelEl) labelEl.textContent = `${item.label ?? "Announcement"}:`;
      if (messageEl) messageEl.textContent = item.message;

      const existingLink = contentEl.querySelector(".announcement-link");
      if (existingLink) existingLink.remove();

      if (item.href) {
        const link = document.createElement("a");
        link.href = item.href;
        link.className =
          "announcement-link italic underline decoration-1 underline-offset-2 ml-1 transition-colors hover:opacity-80";
        link.textContent = item.linkText ?? "Learn more";
        contentEl.appendChild(link);
      }

      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-background", i === index);
        dot.classList.toggle("opacity-100", i === index);
        dot.classList.toggle("scale-110", i === index);
        dot.classList.toggle("bg-background/40", i !== index);
        dot.classList.toggle("opacity-60", i !== index);
        dot.classList.toggle("scale-100", i !== index);
      });
    }

    function goTo(index, direction = "next") {
      if (isTransitioning || index === currentIndex || !contentEl) return;
      isTransitioning = true;

      contentEl.classList.add(
        "opacity-0",
        direction === "next" ? "-translate-x-4" : "translate-x-4",
      );

      later(() => {
        renderIndex(index);
        currentIndex = index;

        contentEl.classList.remove("-translate-x-4", "translate-x-4");
        void contentEl.offsetWidth;
        contentEl.classList.remove("opacity-0");

        later(() => {
          isTransitioning = false;
        }, 50);
      }, 300);
    }

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    let isPaused = false;

    function startRotation() {
      if (items.length <= 1 || reduceMotion || isPaused) return;
      stopRotation();
      timer = setInterval(() => {
        goTo((currentIndex + 1) % items.length, "next");
      }, rotationIntervalMs);
    }

    function stopRotation() {
      if (timer) clearInterval(timer);
      timer = null;
    }

    dots.forEach((dot) => {
      dot.addEventListener(
        "click",
        () => {
          const index = parseInt(dot.dataset.index || "0", 10);
          goTo(index, index > currentIndex ? "next" : "prev");
          startRotation();
        },
        { signal },
      );
    });

    if (closeBtn) {
      closeBtn.addEventListener(
        "click",
        () => {
          const expirationTime = Date.now() + dismissDuration * 60 * 60 * 1000;
          localStorage.setItem(storageKeyClient, expirationTime.toString());
          stopRotation();
          ribbon.remove();
        },
        { signal },
      );
    }

    // Pause auto-rotation while the user is reading or interacting with it.
    const pause = () => {
      isPaused = true;
      stopRotation();
    };
    const resume = () => {
      isPaused = false;
      startRotation();
    };
    ribbon.addEventListener("mouseenter", pause, { signal });
    ribbon.addEventListener("mouseleave", resume, { signal });
    ribbon.addEventListener("focusin", pause, { signal });
    ribbon.addEventListener(
      "focusout",
      (event) => {
        if (!ribbon.contains(event.relatedTarget)) resume();
      },
      { signal },
    );

    teardown = () => {
      stopRotation();
      timeouts.forEach(clearTimeout);
      timeouts.clear();
      controller.abort();
      delete ribbon.dataset.initialized;
    };

    startRotation();
  }

  initRibbon();
  document.addEventListener("astro:page-load", initRibbon);
  document.addEventListener("astro:before-swap", () => {
    teardown?.();
    teardown = null;
  });
</script>
