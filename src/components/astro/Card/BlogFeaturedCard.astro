---
import { IconArrowNarrowRight } from "@tabler/icons-astro";
import Image from "astro/components/Image.astro";
import Categories from "@/components/Categories.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import NewBadge from "@/components/NewBadge.astro";
import { cn, formatReadingTime } from "@/lib/utils";
import type { Post } from "@/sanity/lib/queries/posts";
import AvatarGroup from "../AvatarGroup.astro";
import Separator from "../Separator";
import { sanityImage } from "@/sanity/lib/url-for-image";

type Props = {
  data: Post;
  class?: string;
};
const { data, class: className } = Astro.props;
const {
  title,
  subtitle,
  publishedAt,
  categories,
  authors,
  heroImage,
  heroImageAlt,
} = data;
const readingTime = formatReadingTime(data.readingMinutes);
---

<article
  class={cn(
    "split-card group grid cursor-pointer grid-cols-1 gap-4 gap-x-6 rounded-2xl bg-secondary p-0 text-secondary-foreground md:grid-cols-2 md:p-0",
    className,
  )}
>
  <div
    class="order-2 col-span-1 flex min-h-64 flex-col gap-2 p-4 md:order-1 md:p-6"
  >
    <div class="flex flex-row flex-wrap items-center justify-between gap-2">
      {
        categories?.length > 0 ? (
          <Categories
            badgeVariant={"outline"}
            categories={categories}
            basePath="/blog"
          />
        ) : (
          <div />
        )
      }

      {
        publishedAt && (
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs tracking-wider text-muted-foreground uppercase">
            <NewBadge date={publishedAt} />
            <FormattedDate date={new Date(publishedAt)} />
            {readingTime && <span aria-hidden="true">·</span>}
            {readingTime && <span>{readingTime}</span>}
          </p>
        )
      }
    </div>
    <div class="flex grow flex-col gap-2">
      <a
        class="split-target pb-1 font-sans text-2xl leading-snug font-medium first-letter:capitalize md:text-3xl"
        href={`/blog/${data.slug}`}
      >
        {title}
      </a>
      {
        subtitle && (
          <span class="font-sans text-sm text-muted-foreground first-letter:capitalize">
            {subtitle}
          </span>
        )
      }
    </div>
    <Separator class={"my-4"} />
    <div class="flex flex-row items-center justify-between">
      <a
        class="flex flex-row items-center gap-2 font-mono text-xs tracking-widest uppercase transition-colors hover:text-primary"
        href={`/blog/${data.slug}`}
      >
        Read more <IconArrowNarrowRight class="h-4 w-4" />
      </a>
      {authors?.length > 0 && <AvatarGroup data={authors} />}
    </div>
  </div>
  {
    heroImage && (
      <div class="order-1 col-span-1 max-h-64 overflow-hidden rounded-t-xl md:order-2 md:rounded-l-none md:rounded-r-xl lg:min-h-80">
        <Image
          inferSize
          class="h-full w-full object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
          src={sanityImage(heroImage, { width: 1200 })}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          alt={heroImageAlt ?? ""}
        />
      </div>
    )
  }
</article>
