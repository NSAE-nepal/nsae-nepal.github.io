---
import { Image } from "astro:assets";
import {
  IconArrowNarrowRight,
  IconBook2,
  IconClock,
  IconSchool,
} from "@tabler/icons-astro";
import Badge from "@/components/astro/Badge.astro";
import NewBadge from "@/components/NewBadge.astro";
import CourseProgress from "@/components/pages/courses/CourseProgress.astro";
import {
  courseLessons,
  courseStats,
  formatDuration,
  LEVEL_LABELS,
} from "@/lib/courses";
import { cn } from "@/lib/utils";
import type { Course } from "@/sanity/lib/queries/courses";
import { sanityImage } from "@/sanity/lib/url-for-image";

interface Props {
  data: Course;
  class?: string;
}

const { data, class: className } = Astro.props;
const { lessonCount, totalMinutes } = courseStats(data);
const lessonIds = courseLessons(data).map((lesson) => lesson._id);
---

<article
  class={cn("flex h-full flex-col overflow-hidden rounded-2xl", className)}
>
  <div class="relative aspect-[16/9] overflow-hidden bg-secondary">
    {
      data.coverImage ? (
        <Image
          inferSize
          src={sanityImage(data.coverImage, { width: 800, height: 450 })}
          widths={[400, 800]}
          sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
          alt={data.coverImageAlt ?? ""}
          class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        />
      ) : (
        <div
          class="flex size-full items-center justify-center"
          aria-hidden="true"
        >
          <IconSchool class="size-14 text-muted-foreground/40" />
        </div>
      )
    }
    <div class="absolute top-3 left-3 flex flex-wrap gap-2">
      <Badge class="font-mono text-[10px] tracking-widest uppercase">
        {LEVEL_LABELS[data.level] ?? data.level}
      </Badge>
      <NewBadge date={data.publishedAt} />
    </div>
  </div>

  <div class="flex grow flex-col gap-3 p-5">
    <h3 class="font-sans text-xl leading-snug font-medium">{data.title}</h3>
    <p class="line-clamp-3 text-sm text-muted-foreground">{data.summary}</p>

    <p
      class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-2 font-mono text-xs tracking-wider text-muted-foreground uppercase"
    >
      <span class="inline-flex items-center gap-1.5">
        <IconBook2 class="size-3.5" aria-hidden="true" />
        {lessonCount} lesson{lessonCount === 1 ? "" : "s"}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <IconClock class="size-3.5" aria-hidden="true" />
        {formatDuration(totalMinutes)}
      </span>
    </p>

    <CourseProgress
      courseId={data._id}
      lessonIds={lessonIds}
      hideUntilStarted
    />

    <span
      class="inline-flex items-center gap-1 font-mono text-xs tracking-widest text-foreground uppercase transition-colors group-hover:text-primary"
    >
      View course
      <IconArrowNarrowRight
        class="size-4 transition-transform group-hover:translate-x-1"
      />
    </span>
  </div>
</article>
