---
import {
  IconArrowNarrowRight,
  IconMapPin,
  IconPoint,
} from "@tabler/icons-astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { cn } from "@/lib/utils";
import { type Minutes, minutesTypeLabel } from "@/sanity/lib/queries/minutes";
import Badge from "../Badge.astro";

type Props = {
  data: Minutes;
  class?: string;
};
const { data, class: className } = Astro.props;

const formatType = minutesTypeLabel;
---

<article
  class={cn(
    "split-card relative z-10 flex cursor-pointer flex-col space-y-2 p-4",
    className,
  )}
>
  <div class="flex flex-row items-center justify-between">
    <Badge
      variant={"secondary"}
      size={"xs"}
      class={"font-mono text-xs uppercase tracking-wider flex items-center gap-1.5"}
    >
      <IconPoint class="h-2.5 w-2.5 fill-destructive text-destructive" />
      {formatType(data.type)}
    </Badge>
    <span class="flex items-center gap-1 font-medium text-muted-foreground">
      <FormattedDate date={new Date(data.pubDate)} />
    </span>
  </div>

  <div class="space-y-3">
    <h3
      class="split-target font-sans text-2xl leading-snug font-medium md:text-3xl"
    >
      {data.title}
    </h3>

    <div class="mt-4 flex flex-row items-center justify-between">
      <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
        <IconMapPin class="size-4" />
        <span>{data.location}</span>
      </div>
      <a
        class="inline-flex items-center gap-2 font-mono text-xs leading-none tracking-widest uppercase transition-colors hover:text-primary"
        href={`/minutes/${data.slug}/`}
      >
        Read minutes <IconArrowNarrowRight class="h-4 w-4" />
      </a>
    </div>
  </div>
</article>
<script>
  import { initCardSplitTextAnimation } from "@/utils/animations/cards-split-text-animation";

  if (typeof window !== "undefined") {
    window.addEventListener("load", () => {
      if (!document.querySelector("[data-manual-card-anim]")) {
        initCardSplitTextAnimation();
      }
    });
  }
</script>
