---
import { Image } from "astro:assets";
import {
  IconArrowNarrowRight,
  IconArrowUpRight,
  IconCalendarEvent,
  IconMapPin,
  IconPhoto,
  IconVideo,
} from "@tabler/icons-astro";
import Badge from "@/components/astro/Badge.astro";
import Button from "@/components/astro/Button/Button.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import type { Event } from "@/sanity/lib/queries/events";
import { getEventStatus } from "@/utils/datetime";
import { sanityImage } from "@/sanity/lib/url-for-image";

type Props = {
  data: Event;
  class?: string;
};

const { data } = Astro.props;
const formatEventType = (type: string) => {
  return type
    .split("_")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
};
const isOnline =
  data.location?.type === "online" || data.location?.type === "hybrid";
const { hasEnded, isRegistrationOpen } = getEventStatus(data);
---

<article
  class="split-card group grid grid-cols-1 gap-6 rounded-2xl p-6 md:grid-cols-3 md:p-8 lg:grid-cols-4"
>
  <div class="flex flex-col gap-4 md:col-span-2 lg:col-span-1">
    <div class="flex items-center justify-between">
      <Badge
        variant="outline"
        class="border-border/50 bg-background/50 font-mono text-xs tracking-widest uppercase"
      >
        {formatEventType(data.eventType)}
      </Badge>
      <span class="font-mono text-xs text-muted-foreground uppercase md:hidden">
        <FormattedDate date={new Date(data.eventStart)} />
      </span>
    </div>

    <div class="flex grow flex-col gap-2">
      <h3
        class="split-target pb-1 font-sans text-2xl leading-snug font-medium md:text-3xl"
      >
        {data.title}
      </h3>
      {
        data.subtitle && (
          <p class="line-clamp-3 font-sans text-sm text-muted-foreground">
            {data.subtitle}
          </p>
        )
      }
    </div>

    <div
      class="mt-auto hidden items-center gap-1 pt-4 font-mono text-xs tracking-widest text-foreground uppercase transition-colors hover:text-primary md:flex"
    >
      <span>View Details</span>
      <IconArrowNarrowRight
        class="h-4 w-4 transition-transform group-hover:translate-x-1"
      />
    </div>
  </div>

  <div
    class="flex flex-col justify-center gap-6 border-border/50 md:col-span-1 lg:border-l lg:pl-6"
  >
    <div class="flex items-start gap-3">
      <div
        class="shrink-0 rounded-lg border border-border/50 bg-secondary/50 p-2"
      >
        <IconCalendarEvent class="h-5 w-5 text-primary" />
      </div>
      <div>
        <p class="font-sans text-sm font-medium">Date</p>
        <p class="font-mono text-sm text-foreground">
          <FormattedDate date={new Date(data.eventStart)} />
          {
            new Date(data.eventEnd) > new Date(data.eventStart) && (
              <>
                {" "}
                - <FormattedDate date={new Date(data.eventEnd)} />
              </>
            )
          }
        </p>
      </div>
    </div>

    <div class="flex items-start gap-3">
      <div
        class="shrink-0 rounded-lg border border-border/50 bg-secondary/50 p-2"
      >
        {
          isOnline ? (
            <IconVideo class="h-5 w-5 text-primary" />
          ) : (
            <IconMapPin class="h-5 w-5 text-primary" />
          )
        }
      </div>
      <div class="min-w-0">
        <p class="font-sans text-sm font-medium">
          {isOnline ? "Online" : "Location"}
        </p>
        <p class="truncate font-mono text-sm text-foreground">
          {
            data.location?.type === "in_person"
              ? data.location.venueName
              : "Join via Link"
          }
        </p>
        {
          (data.location?.address ||
            data.location?.city ||
            data.location?.state) && (
            <p class="font-mono text-xs tracking-wide text-muted-foreground/70">
              {[data.location.address, data.location.city, data.location.state]
                .filter(Boolean)
                .join(", ")}
            </p>
          )
        }
      </div>
    </div>

    {
      isRegistrationOpen ? (
        <div class="pt-2">
          <Button
            href={data.registrationLink}
            target="_blank"
            rel="noopener noreferrer"
            class="font-sans font-medium"
          >
            Register Now
            <IconArrowUpRight class={"ml-2 size-4"} />
          </Button>
        </div>
      ) : (
        (hasEnded || data.registrationLink) && (
          <div class="flex flex-wrap gap-2 pt-2">
            <Badge
              variant="outline"
              class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
            >
              {hasEnded ? "Event ended" : "Registration closed"}
            </Badge>
            {hasEnded && data.hasRecap && (
              <Badge
                variant="secondary"
                class="font-mono text-xs tracking-widest uppercase"
              >
                <IconPhoto aria-hidden="true" /> Recap
              </Badge>
            )}
          </div>
        )
      )
    }
  </div>

  {
    data.coverImage && (
      <div class="relative min-h-[250px] overflow-hidden rounded-2xl md:col-span-3 lg:col-span-2 lg:h-auto">
        <Image
          inferSize
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          src={sanityImage(data.coverImage, { width: 1200 })}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          alt={data.title ?? ""}
        />
      </div>
    )
  }
</article>

<style is:global>
  .split-word {
    position: relative;
    display: inline-block;
    margin-right: 0.25em;
    --underline-scale: 0;
    --transform-origin: right center;
  }
  .split-word::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transform: scaleX(var(--underline-scale));
    transform-origin: var(--transform-origin);
  }
</style>

<script>
  import { initCardSplitTextAnimation } from "@/utils/animations/cards-split-text-animation";

  if (typeof window !== "undefined") {
    window.addEventListener("load", () => {
      if (!document.querySelector("[data-manual-card-anim]")) {
        initCardSplitTextAnimation();
      }
    });
  }
</script>
