---
import {
  IconArrowNarrowRight,
  IconCoin,
  IconMapPin,
  IconPoint,
} from "@tabler/icons-astro";
import FormattedDate from "@/components/FormattedDate.astro";
import NewBadge from "@/components/NewBadge.astro";
import { opportunityPath, opportunityTypeLabel } from "@/lib/opportunities";
import type { Vacancy } from "@/sanity/lib/queries/careers";
import { getOpportunityStatus } from "@/utils/datetime";
import Badge from "../Badge.astro";

type Props = {
  data: Vacancy;
  class?: string;
};

const { data } = Astro.props;
const { isClosed, isClosingSoon } = getOpportunityStatus(data);
const closingDate = data.closingDate ? new Date(data.closingDate) : null;
// Jobs show their employment type ("Full-time"); everything else its kind.
const kind =
  data.opportunityType === "job" && data.type
    ? data.type
    : opportunityTypeLabel(data.opportunityType);
---

<article
  class="split-card relative z-10 flex cursor-pointer flex-col space-y-2 p-4"
>
  <div class="flex flex-row items-center justify-between">
    <div class="flex flex-wrap justify-items-start gap-2">
      <Badge
        size={"xs"}
        variant={"secondary"}
        class={"tracking-wide first-letter:capitalize"}
      >
        {kind}
      </Badge>
      <Badge variant="outline">
        {data.company.name}
      </Badge>
      {
        isClosingSoon && (
          <Badge
            variant="outline"
            class="border-destructive/50 text-destructive"
          >
            Closing soon
          </Badge>
        )
      }
      {!isClosed && <NewBadge date={data.postedDate} />}
    </div>
    {
      closingDate && !isClosed && (
        <span class="flex items-center gap-1 font-medium text-muted-foreground italic">
          <IconPoint class="h-3 w-3 fill-destructive text-destructive" />
          Closes: <FormattedDate date={closingDate} />
        </span>
      )
    }
    {isClosed && <Badge variant={"destructive"}>Closed</Badge>}
  </div>

  <h3
    class="split-target font-sans text-2xl leading-snug font-medium md:text-3xl"
  >
    {data.title}
  </h3>

  <div class="flex flex-row items-center justify-between">
    <div
      class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground"
    >
      {
        data.location && (
          <span class="flex items-center gap-1.5">
            <IconMapPin class="size-4" />
            {data.location}
          </span>
        )
      }
      {
        data.value && (
          <span class="flex items-center gap-1.5">
            <IconCoin class="size-4" />
            {data.value}
          </span>
        )
      }
    </div>
    <a
      class="inline-flex items-center gap-2 font-mono text-xs leading-none tracking-widest uppercase transition-colors hover:text-primary"
      href={opportunityPath(data)}
    >
      <span class="translate-y-[1px]">Learn more</span>
      <IconArrowNarrowRight class="h-4 w-4 shrink-0" />
    </a>
  </div>
</article>

<script>
  import { initCardSplitTextAnimation } from "@/utils/animations/cards-split-text-animation";

  if (typeof window !== "undefined") {
    window.addEventListener("load", () => {
      initCardSplitTextAnimation();
    });
  }
</script>
