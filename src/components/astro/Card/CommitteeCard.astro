---
import { IconArrowNarrowRight, IconUserCircle, IconUsersGroup } from "@tabler/icons-astro";
import AvatarGroup from "@/components/astro/AvatarGroup.astro";
import Badge from "@/components/astro/Badge.astro";
import { cn, formatName, ordinal } from "@/lib/utils";
import { type Committee, officeBearers, positionLabel } from "@/sanity/lib/queries/committee";
import { sanityImage } from "@/sanity/lib/url-for-image";

/**
 * Full-width committee card for the past-committee listing: term and title
 * on the left, the office bearers with photos on the right (hidden on phones,
 * where the card stays compact). Meant to sit in a ClickableCard.
 */
interface Props {
  data: Committee;
  /** The most recent committee gets a "Current" badge. */
  isCurrent?: boolean;
  class?: string;
}

const { data, isCurrent = false, class: className } = Astro.props;
const { members, memberCount } = data;
const bearers = officeBearers(members);
const others = memberCount - bearers.length;

---

<article
  class={cn(
    "grid gap-8 p-6 md:p-8 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-12",
    className,
  )}
>
  <div class="flex flex-col gap-5">
    <div class="flex items-center gap-3">
      <span class="font-sans text-5xl md:text-6xl font-medium leading-none tracking-tighter text-primary">
        {ordinal(data.committeeIteration)}
      </span>
      {
        isCurrent && (
          <Badge size="xs" class="font-mono uppercase tracking-widest">
            Current
          </Badge>
        )
      }
    </div>

    <h3
      class="font-sans text-2xl md:text-3xl font-medium leading-snug tracking-tight transition-colors group-hover:text-primary"
    >
      {data.title}
    </h3>

    <div class="mt-auto flex flex-wrap items-center justify-between gap-4 border-t border-border/50 pt-5">
      <div class="flex items-center gap-3">
        {
          members.length > 0 && (
            <AvatarGroup
              data={members.map((member) => ({
                _id: member._key,
                name: member.name,
                profileImage: member.profileImage,
              }))}
              visibleAvatarCount={4}
            />
          )
        }
        <span class="flex items-center gap-1.5 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          <IconUsersGroup class="size-4" aria-hidden="true" />
          {memberCount} member{memberCount === 1 ? "" : "s"}
        </span>
      </div>
      <span
        class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest transition-colors group-hover:text-primary"
        aria-hidden="true"
      >
        View committee
        <IconArrowNarrowRight class="size-4 transition-transform group-hover:translate-x-1" />
      </span>
    </div>
  </div>

  {
    bearers.length > 0 && (
      <div class="hidden sm:block">
        <p class="mb-4 font-mono text-xs uppercase tracking-widest text-muted-foreground">
          Office bearers
        </p>
        <ul class="grid grid-cols-3 gap-x-4 gap-y-6 md:grid-cols-5" role="list">
          {bearers.map((member) => (
            <li class="flex flex-col items-center gap-3 text-center">
              <span class="flex size-20 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-border bg-muted">
                {member.profileImage ? (
                  <img
                    src={sanityImage(member.profileImage, { width: 160, height: 160 })}
                    alt=""
                    width="80"
                    height="80"
                    loading="lazy"
                    decoding="async"
                    class="size-full object-cover"
                  />
                ) : (
                  <IconUserCircle class="size-10 text-muted-foreground" aria-hidden="true" />
                )}
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-medium leading-snug">
                  {formatName(member.name, member.prefix)}
                </span>
                <span class="mt-1 block font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
                  {positionLabel(member.position ?? "member")}
                </span>
              </span>
            </li>
          ))}
        </ul>
        {others > 0 && (
          <p class="mt-6 text-sm text-muted-foreground">
            + {others} more committee member{others === 1 ? "" : "s"}
          </p>
        )}
      </div>
    )
  }
</article>
