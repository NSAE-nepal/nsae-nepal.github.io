---
import { IconArrowNarrowRight } from "@tabler/icons-astro";

import Categories from "@/components/Categories.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import NewBadge from "@/components/NewBadge.astro";
import { formatReadingTime } from "@/lib/utils";
import AvatarGroup from "../AvatarGroup.astro";

const { data, href } = Astro.props;
const { title, subtitle, publishedAt, categories, authors, slug } = data;
const readingTime = formatReadingTime(data.readingMinutes);
---

<article
  class="split-card relative z-10 flex cursor-pointer flex-col space-y-2 p-4"
>
  <div class="flex flex-row items-center justify-between">
    {
      categories?.length > 0 ? (
        <Categories
          categories={categories}
          basePath={data.type === "notice" ? "/notices" : "/blog"}
        />
      ) : (
        <div />
      )
    }

    {
      publishedAt && (
        <p class="flex flex-wrap items-center justify-end gap-x-2 gap-y-1 font-mono text-xs tracking-wider text-muted-foreground uppercase">
          <NewBadge date={publishedAt} />
          <FormattedDate date={new Date(publishedAt)} />
          {readingTime && <span aria-hidden="true">·</span>}
          {readingTime && <span>{readingTime}</span>}
        </p>
      )
    }
  </div>

  <div class="flex grow flex-col gap-2">
    <a
      class="split-target font-sans text-xl leading-snug font-medium first-letter:capitalize md:text-2xl"
      href={href ? href : `/blog/${slug}`}
    >
      {title}
    </a>
    {
      subtitle && (
        <span class="font-sans text-sm text-muted-foreground first-letter:capitalize">
          {subtitle}
        </span>
      )
    }
    <div class="mt-auto flex flex-row items-center justify-between pt-4 pb-0">
      <a
        class="flex flex-row items-center gap-2 font-mono text-xs tracking-widest uppercase transition-colors hover:text-primary"
        href={href ? href : `/blog/${slug}`}
      >
        Read more <IconArrowNarrowRight class="h-4 w-4" />
      </a>
      {authors?.length > 0 && <AvatarGroup data={authors} />}
    </div>
  </div>
</article>

<script>
  import { initCardSplitTextAnimation } from "@/utils/animations/cards-split-text-animation";

  if (typeof window !== "undefined") {
    window.addEventListener("load", () => {
      if (!document.querySelector("[data-manual-card-anim]")) {
        initCardSplitTextAnimation();
      }
    });
  }
</script>
