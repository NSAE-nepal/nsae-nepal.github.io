---
import { IconArrowNarrowRight, IconDownload, IconExternalLink } from "@tabler/icons-astro";
import Badge from "@/components/astro/Badge.astro";
import NewBadge from "@/components/NewBadge.astro";
import ResourceIcon from "@/components/pages/resources/ResourceIcon.astro";
import { downloadUrl, resourceTypeLabel } from "@/lib/resources";
import { cn } from "@/lib/utils";
import { type Resource, resourceFormat } from "@/sanity/lib/queries/resources";

/**
 * Resource library card. Meant to sit in a ClickableCard (to the detail
 * page); the download / open link stays clickable on its own.
 */
interface Props {
  data: Resource;
  class?: string;
}

const { data, class: className } = Astro.props;
const byline = [data.publisher, data.year].filter(Boolean).join(" · ");
// One item: act on it straight from the card. Several: open the page.
const only = data.attachments.length === 1 ? data.attachments[0] : undefined;
const action = "inline-flex shrink-0 items-center gap-1.5 text-primary hover:underline";
---

<article class={cn("flex h-full flex-col gap-4 p-5", className)}>
  <div class="flex items-start gap-4">
    <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
      <ResourceIcon type={data.resourceType} class="size-5" />
    </span>
    <div class="min-w-0 flex-1 space-y-2">
      <div class="flex flex-wrap items-center gap-2">
        <Badge variant="secondary" size="xs" class="font-mono uppercase tracking-wider">
          {resourceTypeLabel(data.resourceType)}
        </Badge>
        <NewBadge date={data.publishedAt} />
      </div>
      <h3 class="font-sans text-lg font-medium leading-snug">{data.title}</h3>
      {byline && <p class="text-sm text-muted-foreground">{byline}</p>}
    </div>
  </div>

  {data.description && <p class="line-clamp-3 text-sm text-muted-foreground">{data.description}</p>}

  {
    data.categories.length > 0 && (
      <ul class="flex flex-wrap gap-1.5" aria-label="Topics">
        {data.categories.map((category) => (
          <li class="rounded-full border border-border/60 px-2 py-0.5 text-xs text-muted-foreground">
            {category.title}
          </li>
        ))}
      </ul>
    )
  }

  <div class="mt-auto flex items-center justify-between gap-3 border-t border-border/50 pt-4 font-mono text-xs uppercase tracking-wider">
    <span class="text-muted-foreground">{resourceFormat(data)}</span>
    {
      only?._type === "resourceFile" ? (
        <a href={downloadUrl(only.url, only.filename)} class={action}>
          <IconDownload class="size-4" aria-hidden="true" />
          Download<span class="sr-only">: {data.title}</span>
        </a>
      ) : only ? (
        <a href={only.url} target="_blank" rel="noopener noreferrer" class={action}>
          <IconExternalLink class="size-4" aria-hidden="true" />
          Open<span class="sr-only">: {data.title} (opens in a new tab)</span>
        </a>
      ) : (
        <span class="inline-flex shrink-0 items-center gap-1.5 text-primary" aria-hidden="true">
          View all
          <IconArrowNarrowRight class="size-4" />
        </span>
      )
    }
  </div>
</article>
