---
import { IconMoodEmpty } from "@tabler/icons-astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div
  class="flex flex-col items-center justify-center rounded-xl border border-dashed border-border/60 bg-secondary/5 py-8 text-center"
>
  <div class="mb-4 rounded-full bg-secondary p-4">
    <slot name="icon">
      <IconMoodEmpty class="size-8 text-muted-foreground" />
    </slot>
  </div>
  <h3 class="mb-2 font-sans text-xl font-medium">{title}</h3>
  <p class="mx-auto max-w-xs text-muted-foreground">
    {description}
  </p>
  <slot />
</div>
