---
import { getImage } from "astro:assets";
import { IconArrowUpRight } from "@tabler/icons-astro";
import type { Banner } from "@/sanity/lib/queries/banner";
import Button from "./Button/Button.astro";
import { sanityImage } from "@/sanity/lib/url-for-image";

type Props = {
  banner: Banner;
};
const { banner } = Astro.props;

const optimizedImage = await getImage({
  src: sanityImage(banner.backgroundImage, { width: 2000 }),
  inferSize: true,
});

const contentBoxClasses = [
  "flex",
  "flex-col",
  "max-w-4xl",
  "p-8 md:p-12",
  banner.contentPosition === "left"
    ? "mr-auto items-start text-left"
    : "ml-auto items-end text-right",
];
const baseOverlayColor = "15, 23, 42";

const gradientDirection =
  banner.contentPosition === "left" ? "to right" : "to left";

const directionalScrim = `linear-gradient(
  ${gradientDirection},
  rgba(${baseOverlayColor}, 0.98) 0%,
  rgba(${baseOverlayColor}, 0.92) 15%,
  rgba(${baseOverlayColor}, 0.75) 30%,
  rgba(${baseOverlayColor}, 0.40) 50%,
  rgba(${baseOverlayColor}, 0.10) 75%,
  transparent 100%
)`;

const subtleVignette = `radial-gradient(
  circle at center,
  transparent 40%,
  rgba(${baseOverlayColor}, 0.4) 100%
)`;
---

<section class="pt-4">
  <div
    class="relative flex min-h-[400px] items-center overflow-hidden rounded-xl bg-cover bg-center text-white shadow-sm lg:min-h-[500px]"
    style={`background-image: ${directionalScrim}, ${subtleVignette}, url(${optimizedImage.src})`}
  >
    <div class:list={contentBoxClasses}>
      {
        banner.countdownTarget && (
          <div
            class="countdown my-4 flex items-start gap-x-4 border-b border-white/20 pb-4 font-mono text-3xl font-medium tracking-tighter md:gap-x-6 md:text-5xl"
            data-target-date={banner.countdownTarget}
          />
        )
      }
      {
        banner.subtitle && (
          <p class="mb-3 font-mono text-xs tracking-widest text-white/80 uppercase">
            {banner.subtitle}
          </p>
        )
      }

      <h2
        class="my-2 font-sans text-4xl leading-[0.9] font-medium tracking-tighter uppercase md:text-6xl lg:text-7xl"
      >
        {banner.title}
      </h2>
      {
        banner.description && (
          <p class="mb-8 max-w-prose font-sans text-lg leading-relaxed text-white/90">
            {banner.description}
          </p>
        )
      }
      <Button
        href={banner.buttonLink}
        class="h-12 rounded-full px-5! font-sans text-base font-medium shadow-sm transition-all hover:shadow-md"
      >
        {banner.buttonText}
        <IconArrowUpRight class={"ml-2 size-5"} />
      </Button>
    </div>
  </div>
</section>

<script>
  // Countdown banners live on the home page only. One interval per countdown,
  // all cleared before the page is swapped out.
  const intervals: Array<ReturnType<typeof setInterval>> = [];

  const UNITS = ["Days", "Hrs", "Min", "Sec"] as const;
  const DAY = 24 * 60 * 60 * 1000;
  const HOUR = 60 * 60 * 1000;
  const MINUTE = 60 * 1000;

  // Builds the markup once; each tick only updates the four numbers.
  function buildCountdown(container: HTMLElement): HTMLElement[] {
    container.replaceChildren();
    return UNITS.map((unit, i) => {
      if (i > 0) {
        const separator = document.createElement("span");
        separator.className = "mt-1 text-2xl opacity-50 md:mt-2 md:text-4xl";
        separator.setAttribute("aria-hidden", "true");
        separator.textContent = ":";
        container.append(separator);
      }
      const cell = document.createElement("div");
      cell.className = "text-center";
      const value = document.createElement("span");
      const label = document.createElement("span");
      label.className =
        "mt-1 block font-mono text-[10px] tracking-widest uppercase opacity-70";
      label.textContent = unit;
      cell.append(value, label);
      container.append(cell);
      return value;
    });
  }

  function startCountdown(container: HTMLElement) {
    const target = new Date(container.dataset.targetDate ?? "").getTime();
    if (!Number.isFinite(target)) return;

    const values = buildCountdown(container);
    let intervalId: ReturnType<typeof setInterval> | undefined;

    const tick = () => {
      const distance = target - Date.now();
      if (distance < 0) {
        clearInterval(intervalId);
        container.textContent = "EVENT STARTED";
        return false;
      }
      const parts = [
        Math.floor(distance / DAY),
        Math.floor((distance % DAY) / HOUR),
        Math.floor((distance % HOUR) / MINUTE),
        Math.floor((distance % MINUTE) / 1000),
      ];
      parts.forEach((part, i) => {
        values[i].textContent = String(part).padStart(2, "0");
      });
      return true;
    };

    if (tick()) {
      intervalId = setInterval(tick, 1000);
      intervals.push(intervalId);
    }
  }

  function stopCountdowns() {
    intervals.splice(0).forEach(clearInterval);
  }

  // astro:page-load also fires on the first load.
  document.addEventListener("astro:page-load", () => {
    stopCountdowns();
    document
      .querySelectorAll<HTMLElement>(".countdown[data-target-date]")
      .forEach(startCountdown);
  });
  document.addEventListener("astro:before-swap", stopCountdowns);
</script>
