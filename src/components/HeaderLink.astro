---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");

const hrefString = href?.toString() ?? "";

const currentSubpath = pathname.match(/[^/]+/g);
const currentRoot = currentSubpath?.[0];

const hrefSubpath = hrefString
  .replace(import.meta.env.BASE_URL, "")
  .match(/[^/]+/g);
const hrefRoot = hrefSubpath?.[0];

const isActive =
  hrefString === pathname ||
  hrefString === "/" + (currentRoot || "") ||
  (currentRoot && hrefRoot === currentRoot);

const baseClasses =
  "relative rounded-full px-2.5 py-1 text-sm transition-colors duration-300 ease-out " +
  "hover:bg-background/50 dark:hover:text-foreground";
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  class={cn(
    baseClasses,
    isActive && "text-background hover:text-background!",
    className,
  )}
  {...props}
>
  {
    isActive && (
      <span
        transition:name="active-pill"
        class="absolute inset-0 rounded-full bg-primary"
        aria-hidden="true"
      />
    )
  }
  <span class="relative"><slot /></span>
</a>
