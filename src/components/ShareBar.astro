---
import {
  IconBrandFacebook,
  IconBrandLinkedin,
  IconBrandWhatsapp,
  IconBrandX,
  IconCheck,
  IconLink,
  IconShare,
} from "@tabler/icons-astro";
import { cn } from "@/lib/utils";

/**
 * Share actions for a detail page: the native share sheet where supported
 * (mobile; covers Viber, Messenger, etc.), plus direct links and "Copy link".
 * No third-party scripts; plain URLs only.
 */
interface Props {
  title: string;
  /** Short text that accompanies the link (defaults to the title). */
  text?: string;
  /** Path or absolute URL; defaults to the current page. */
  url?: string;
  label?: string;
  class?: string;
}

const {
  title,
  text = title,
  url = Astro.url.pathname,
  label = "Share",
  class: className,
} = Astro.props;

const shareUrl = new URL(url, Astro.site ?? Astro.url).toString();
const encodedUrl = encodeURIComponent(shareUrl);
const message = `${text} ${shareUrl}`;

const links = [
  {
    name: "WhatsApp",
    href: `https://wa.me/?text=${encodeURIComponent(message)}`,
    icon: IconBrandWhatsapp,
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: IconBrandFacebook,
  },
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: IconBrandLinkedin,
  },
  {
    name: "X",
    href: `https://x.com/intent/post?text=${encodeURIComponent(text)}&url=${encodedUrl}`,
    icon: IconBrandX,
  },
];

const iconButton =
  "inline-flex size-9 items-center justify-center rounded-full border border-border/60 bg-background text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 cursor-pointer";
---

<div
  class={cn("share-bar flex flex-wrap items-center gap-2", className)}
  data-share-bar
  data-share-title={title}
  data-share-text={text}
  data-share-url={shareUrl}
  data-pagefind-ignore
>
  <span class="mr-1 font-mono text-xs uppercase tracking-widest text-muted-foreground">
    {label}
  </span>

  <button
    type="button"
    class={cn(iconButton, "hidden")}
    data-share-native
    aria-label="Share via…"
    title="Share via…"
  >
    <IconShare class="size-4" />
  </button>

  {
    links.map(({ name, href, icon: Icon }) => (
      <a
        class={iconButton}
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Share on ${name}`}
        title={`Share on ${name}`}
      >
        <Icon class="size-4" />
      </a>
    ))
  }

  <button
    type="button"
    class={iconButton}
    data-share-copy
    aria-label="Copy link"
    title="Copy link"
  >
    <IconLink class="size-4" data-copy-idle />
    <IconCheck class="size-4 hidden text-primary" data-copy-done />
  </button>
  <span class="sr-only" role="status" aria-live="polite" data-share-status></span>
</div>

<script>
  // Delegated, so it works across view transitions without per-page setup.
  const setUpNativeShare = () => {
    if (typeof navigator.share !== "function") return;
    document
      .querySelectorAll<HTMLElement>("[data-share-native]")
      .forEach((button) => button.classList.remove("hidden"));
  };

  document.addEventListener("astro:page-load", setUpNativeShare);

  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;
    const bar = target.closest<HTMLElement>("[data-share-bar]");
    if (!bar) return;
    const { shareTitle = "", shareText = "", shareUrl = "" } = bar.dataset;

    if (target.closest("[data-share-native]")) {
      try {
        await navigator.share({ title: shareTitle, text: shareText, url: shareUrl });
      } catch {
        // Dismissed by the user; nothing to do.
      }
      return;
    }

    const copyButton = target.closest<HTMLElement>("[data-share-copy]");
    if (!copyButton) return;
    const status = bar.querySelector<HTMLElement>("[data-share-status]");
    try {
      await navigator.clipboard.writeText(shareUrl);
    } catch {
      if (status) status.textContent = "Couldn't copy the link";
      return;
    }
    const idle = copyButton.querySelector("[data-copy-idle]");
    const done = copyButton.querySelector("[data-copy-done]");
    idle?.classList.add("hidden");
    done?.classList.remove("hidden");
    if (status) status.textContent = "Link copied";
    window.setTimeout(() => {
      idle?.classList.remove("hidden");
      done?.classList.add("hidden");
      if (status) status.textContent = "";
    }, 2000);
  });
</script>
