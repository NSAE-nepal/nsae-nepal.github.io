---
import {
  IconArrowLeft,
  IconArrowUpRight,
  IconDeviceMobileDown,
  IconDots,
  IconSearch,
} from "@tabler/icons-astro";

import Button from "./astro/Button/Button.astro";
import HeaderLink from "./HeaderLink.astro";

// Secondary destinations, reachable at every screen size via "More".
// `hideFrom` hides an entry once the bar itself shows that link.
const moreLinks = [
  { href: "/about", label: "About us", hideFrom: "xs:hidden" },
  { href: "/blog/page/1", label: "Blog", hideFrom: "lg:hidden" },
  { href: "/courses/page/1", label: "Courses" },
  { href: "/resources/page/1", label: "Resources" },
  { href: "/careers/page/1", label: "Opportunities" },
  { href: "/spotlight/page/1", label: "Member Spotlight" },
  { href: "/minutes/page/1", label: "Minutes" },
  { href: "/past-committee/page/1", label: "Past Committee" },
  { href: "/donate", label: "Donate" },
  { href: "/contact", label: "Contact", hideFrom: "xs:hidden" },
];

const currentRoot = Astro.url.pathname.split("/")[1] ?? "";
const isCurrent = (href: string) =>
  currentRoot !== "" && href.split("/")[1] === currentRoot;

const pillButton =
  "rounded-full items-center bg-foreground text-background hover:bg-foreground cursor-pointer h-9 px-3 py-2";
---

<header
  class="fixed bottom-4 left-1/2 z-40 flex -translate-x-1/2 flex-row items-center gap-2 select-none"
  data-pagefind-ignore="all"
>
  <!-- The installed app has no browser toolbar, so it gets its own back button. -->
  <Button
    type="button"
    data-history-back
    aria-label="Go back"
    class={`${pillButton} hidden standalone:flex`}
  >
    <IconArrowLeft class="h-4 w-4 shrink-0" />
  </Button>

  <nav
    aria-label="Main"
    class="flex flex-nowrap items-center gap-1 rounded-full bg-foreground p-2 whitespace-nowrap text-background"
  >
    <HeaderLink href="/">Home</HeaderLink>
    <HeaderLink class="hidden xs:block" href="/about">About us</HeaderLink>
    <HeaderLink href="/notices/page/1">Notices</HeaderLink>
    <HeaderLink class="hidden lg:block" href="/blog/page/1">Blog</HeaderLink>
    <HeaderLink href="/events/page/1">Events</HeaderLink>
  </nav>

  <Button
    type="button"
    popovertarget="more-menu"
    aria-label="More pages"
    class={`${pillButton} flex`}
  >
    <IconDots class="h-4 w-4 shrink-0" />
  </Button>

  <Button
    class="hidden h-fit items-center rounded-full bg-foreground pr-2 hover:bg-foreground xs:flex"
    href={"/contact"}
  >
    Contact
    <span class="rounded-full bg-primary p-1 text-primary-foreground">
      <IconArrowUpRight class="h-4 w-4 shrink-0" />
    </span>
  </Button>

  <Button
    type="button"
    data-search-trigger
    aria-label="Search (Ctrl+K)"
    aria-keyshortcuts="Control+K Meta+K"
    class={`${pillButton} flex`}
  >
    <IconSearch class="h-4 w-4 shrink-0" />
  </Button>
</header>

<!--
  Native popover: no JS, closes on outside click / Escape. It renders in the
  top layer, so it is positioned above the fixed bottom bar explicitly.
-->
<nav
  id="more-menu"
  popover
  aria-label="More pages"
  data-pagefind-ignore="all"
  class="inset-auto bottom-20 left-1/2 m-0 w-[min(20rem,calc(100vw-2rem))] -translate-x-1/2 rounded-2xl border border-border bg-popover p-2 text-popover-foreground shadow-lg select-none"
>
  <ul class="grid gap-1">
    {
      moreLinks.map(({ href, label, hideFrom }) => (
        <li class={hideFrom}>
          <a
            href={href}
            aria-current={isCurrent(href) ? "page" : undefined}
            class="block rounded-xl px-4 py-2.5 text-sm transition-colors hover:bg-secondary aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground"
          >
            {label}
          </a>
        </li>
      ))
    }
    <!-- Shown by src/scripts/install-app.ts when this browser can install. -->
    <li data-install-app hidden>
      <button
        type="button"
        data-install-trigger
        class="flex w-full cursor-pointer items-center gap-2 rounded-xl px-4 py-2.5 text-left text-sm transition-colors hover:bg-secondary"
      >
        <IconDeviceMobileDown class="size-4 text-primary" aria-hidden="true" />
        Install the app
      </button>
    </li>
  </ul>
</nav>

<script>
  // The React search dialog is only downloaded when someone actually searches.
  // These listeners live on `document`, so they survive client-side navigation.
  const loadSearch = () => import("@/components/search/mount");
  const openSearch = () => loadSearch().then((m) => m.openSearch());

  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    if (target.closest("[data-search-trigger]")) {
      openSearch();
    } else if (target.closest("[data-history-back]")) {
      // Opened straight from the home screen: nothing to go back to.
      if (history.length > 1) history.back();
      else location.assign("/");
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey)) {
      event.preventDefault();
      openSearch();
    }
  });

  // Warm the chunk as soon as intent is likely (hover or keyboard focus).
  for (const type of ["pointerover", "focusin"]) {
    document.addEventListener(type, (event) => {
      if ((event.target as Element).closest?.("[data-search-trigger]")) {
        loadSearch();
      }
    });
  }
</script>
