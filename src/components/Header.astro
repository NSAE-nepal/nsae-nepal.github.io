---
import { IconArrowUpRight, IconSearch } from "@tabler/icons-astro";

import Button from "./astro/Button/Button.astro";
import HeaderLink from "./HeaderLink.astro";
---

<header
  class="fixed bottom-4 left-1/2 -translate-x-1/2 z-40 flex flex-row gap-2 items-center"
  data-pagefind-ignore="all"
>
  <nav
    class="flex flex-nowrap whitespace-nowrap gap-1 items-center bg-foreground text-background rounded-full p-2"
  >
    <HeaderLink href="/">Home</HeaderLink>
    <HeaderLink href="/about">About us</HeaderLink>
    <HeaderLink href="/notices/page/1">Notices</HeaderLink>
    <HeaderLink class={"hidden lg:block"} href="/blog/page/1">Blog</HeaderLink>
    <HeaderLink href="/events/page/1">Events</HeaderLink>
  </nav>
  <Button
    class="rounded-full items-center pr-2 bg-foreground hover:bg-foreground h-fit hidden xs:flex"
    href={"/contact"}
  >
    Contact
    <span class="bg-primary text-primary-foreground rounded-full p-1">
      <IconArrowUpRight class="w-4 h-4 shrink-0" />
    </span>
  </Button>

  <Button
    type="button"
    data-search-trigger
    aria-label="Search (Ctrl+K)"
    aria-keyshortcuts="Control+K Meta+K"
    class="rounded-full items-center bg-foreground hover:bg-foreground hidden xs:flex cursor-pointer h-9 px-3 py-2"
  >
    <IconSearch class="w-4 h-4 shrink-0" />
  </Button>
</header>

<script>
  // The React search dialog is only downloaded when someone actually searches.
  // These listeners live on `document`, so they survive client-side navigation.
  const loadSearch = () => import("@/components/search/mount");
  const openSearch = () => loadSearch().then((m) => m.openSearch());

  document.addEventListener("click", (event) => {
    if ((event.target as Element).closest("[data-search-trigger]")) {
      openSearch();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key.toLowerCase() === "k" && (event.metaKey || event.ctrlKey)) {
      event.preventDefault();
      openSearch();
    }
  });

  // Warm the chunk as soon as intent is likely (hover or keyboard focus).
  for (const type of ["pointerover", "focusin"]) {
    document.addEventListener(type, (event) => {
      if ((event.target as Element).closest?.("[data-search-trigger]")) {
        loadSearch();
      }
    });
  }
</script>
