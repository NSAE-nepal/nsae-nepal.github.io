---
import { IconArrowRight, IconPlus } from "@tabler/icons-astro";
import { getFaqDetails } from "@/sanity/lib/queries/faq";
import Badge from "../astro/Badge.astro";

const data = await getFaqDetails();
const faqItems = data?.items ?? [];
---

<section data-section="faq" id="faq-section" class="py-24 md:py-32">
  <div class="header-content mb-12 flex flex-col gap-4">
    <Badge
      variant="secondary"
      size="sm"
      class={"font-mono text-xs uppercase tracking-widest faq-badge opacity-0 translate-y-8"}
    >
      FAQ
    </Badge>

    <h1
      class="translate-y-8 font-sans text-4xl font-medium tracking-tighter text-balance opacity-0 md:text-5xl"
    >
      Frequently Asked Questions
    </h1>
  </div>

  {
    faqItems.length > 0 ? (
      <div class="space-y-4">
        {faqItems.map((faq) => (
          <details
            class="group translate-y-8 overflow-hidden rounded-xl border border-border/50 bg-secondary/50 p-6 opacity-0 [&_summary::-webkit-details-marker]:hidden"
            name="faq-accordion"
          >
            <summary class="faq-summary relative z-10 flex cursor-pointer items-center justify-between gap-4 font-sans text-lg font-medium text-foreground select-none marker:content-none">
              <span class="question-text transition-colors duration-300">
                {faq.question}
              </span>

              <span class="relative flex size-8 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-muted-foreground transition-colors duration-300 group-hover:border-primary">
                <div class="relative size-4 transition-transform duration-400 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-open:rotate-45">
                  <IconPlus class="absolute inset-0 size-4" />
                </div>
              </span>
            </summary>

            <div class="faq-answer mt-4 border-t border-border pt-4 font-sans leading-relaxed text-muted-foreground">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    ) : (
      <div class="p-12 text-center font-sans text-muted-foreground">
        <p>No questions currently available.</p>
      </div>
    )
  }

  <div
    class="cta-content mt-12 flex translate-y-8 flex-col items-center gap-3 text-center opacity-0"
  >
    <p class="font-sans text-lg text-balance text-muted-foreground">
      Need a personalized answer?
    </p>
    <a
      href="/contact"
      class="inline-flex items-center gap-2 font-mono text-xs tracking-widest text-primary uppercase transition-colors hover:text-primary/80"
    >
      Contact our team <IconArrowRight class="size-4" />
    </a>
  </div>
</section>

<style>
  /* Native exclusive accordion (<details name>): works without JavaScript and
     with the keyboard. Where ::details-content is supported, open/close
     animates the height (interpolate-size lets it transition to auto). */
  #faq-section {
    interpolate-size: allow-keywords;
  }
  #faq-section details::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      content-visibility 0.5s allow-discrete;
  }
  #faq-section details[open]::details-content {
    block-size: auto;
  }
  .faq-answer {
    opacity: 0;
    translate: 0 1rem;
    transition:
      opacity 0.4s ease-out 0.1s,
      translate 0.4s ease-out 0.1s;
  }
  details[open] .faq-answer {
    opacity: 1;
    translate: 0 0;
  }
</style>

<script>
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-section="faq"]', ({ root }) => {
    gsap
      .timeline({ scrollTrigger: { trigger: root, start: "top 80%" } })
      .to(".header-content > *", {
        y: 0,
        opacity: 1,
        duration: 1,
        stagger: 0.1,
        ease: "power3.out",
      })
      .to(
        "details",
        { y: 0, opacity: 1, duration: 0.8, stagger: 0.05, ease: "power2.out" },
        "-=0.6",
      )
      .to(
        ".cta-content",
        { y: 0, opacity: 1, duration: 1, ease: "power3.out" },
        "-=0.4",
      );
  });
</script>
