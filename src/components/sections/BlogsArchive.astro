---
import { Image } from "astro:assets";
import { IconArrowRight } from "@tabler/icons-astro";
import { getPosts } from "@/sanity/lib/queries/posts";
import Badge from "../astro/Badge.astro";
import BlogCard from "../astro/Card/BlogCard.astro";
import BlogFeaturedCard from "../astro/Card/BlogFeaturedCard.astro";
import ClickableCard from "../astro/Card/ClickableCard.astro";
import { sanityImage } from "@/sanity/lib/url-for-image";

const allPublishedPosts = (await getPosts("blog")) || [];

const featuredPosts = allPublishedPosts.filter((post) => post.featured);

const nonFeaturedPosts = allPublishedPosts.filter((post) => !post.featured);

// The first featured post leads; the next three (remaining featured, then
// the rest) fill the side list.
const mainFeature = featuredPosts[0] ?? null;
const sideListPosts = [...featuredPosts.slice(1), ...nonFeaturedPosts].slice(
  0,
  3,
);
---

{
  allPublishedPosts.length > 0 && (
    <section
      data-section="blogs"
      class="blog-section pt-24 md:pt-32"
      data-manual-card-anim
    >
      <div class="mb-12 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div class="anim-blog-header translate-y-8 space-y-4 opacity-0">
          <Badge
            variant="secondary"
            size="sm"
            class="font-mono text-xs tracking-widest uppercase"
          >
            Blog & Articles
          </Badge>
          <h2 class="font-sans text-4xl font-medium tracking-tighter md:text-5xl">
            Latest Updates
          </h2>
        </div>

        <a
          href="/blog/page/1"
          class="anim-blog-header group flex translate-y-8 items-center gap-2 font-mono text-xs tracking-widest text-muted-foreground uppercase opacity-0 transition-colors hover:text-primary"
        >
          View All Archives
          <IconArrowRight class="size-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {mainFeature && (
          <div class="anim-blog-card col-span-2 translate-y-12 rounded-2xl border border-border/50 bg-secondary p-4 opacity-0 lg:col-span-1">
            <ClickableCard
              href={`/blog/${mainFeature.slug}/`}
              label={mainFeature.title}
            >
              <BlogFeaturedCard class="md:grid-cols-1" data={mainFeature} />
            </ClickableCard>
          </div>
        )}

        <div
          class:list={[
            "anim-blog-card translate-y-12 opacity-0",
            "col-span-2",
            mainFeature ? "lg:col-span-1" : "grid grid-cols-1 gap-4",
          ]}
        >
          {sideListPosts.map((post) => (
            <ClickableCard
              class="group relative overflow-hidden border-b border-border transition-colors duration-300 last:border-b-0 hover:bg-secondary/60"
              href={`/blog/${post.slug}/`}
              label={post.title}
            >
              <BlogCard data={post} />
              {post.heroImage && (
                <Image
                  inferSize
                  class={
                    "absolute top-0 right-0 z-0 hidden h-full w-1/4 object-cover opacity-40 grayscale transition-opacity duration-500 group-hover:block group-hover:grayscale-0"
                  }
                  src={sanityImage(post.heroImage, { width: 480 })}
                  alt={post.heroImageAlt ?? ""}
                />
              )}
            </ClickableCard>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  import { startCardHover } from "@/utils/animations/cards-split-text-animation";
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-section="blogs"]', (scope) => {
    gsap
      .timeline({
        scrollTrigger: {
          trigger: scope.root,
          start: "top 75%",
        },
      })
      .to(".anim-blog-header", {
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.1,
        ease: "power3.out",
      })
      .to(
        ".anim-blog-card",
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.2,
          ease: "power2.out",
        },
        "-=0.4",
      )
      .add(startCardHover(scope), "<");
  });
</script>
