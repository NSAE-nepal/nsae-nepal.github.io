---
import { Image } from "astro:assets";
import {
  IconArrowRight,
  IconPlayerPause,
  IconPlayerPlay,
  IconPlus,
} from "@tabler/icons-astro";
import MissionPlaceholder3 from "src/assets/pages/mission-placeholder-3.avif";
import Badge from "@/components/astro/Badge.astro";
import type { Home } from "@/sanity/lib/queries/home";
import { sanityImage } from "@/sanity/lib/url-for-image";

const { objective, bylaws } = Astro.props as {
  objective: Home["objective"];
  bylaws: Home["bylaws"];
};
---

<section
  id="mission-brief"
  data-section="mission-brief"
  class="mission-section relative space-y-12 overflow-hidden bg-background pt-24 text-foreground md:pt-32"
>
  <div
    class="mission-text flex flex-col items-start justify-between gap-8 border-b border-border/50 pb-12 lg:flex-row lg:items-center"
  >
    <div class="max-w-3xl">
      <div class="mb-4 flex items-center gap-4">
        <Badge class="font-mono text-xs tracking-widest uppercase" size="sm"
          >( 02 )</Badge
        >
        <span
          class="font-mono text-xs tracking-widest text-muted-foreground uppercase"
          >Mission Brief</span
        >
      </div>
      <h1
        class="font-sans text-5xl leading-[0.9] font-medium tracking-tighter md:text-8xl js:translate-y-8 js:opacity-0"
      >
        Objectives of the <br />
        <span class="font-serif text-muted-foreground italic">Society.</span>
      </h1>
    </div>
    <div class="max-w-xl lg:max-w-3xl">
      <p
        class="font-sans text-base leading-relaxed text-muted-foreground md:text-lg js:translate-y-8 js:opacity-0"
      >
        <span class="mb-2 block font-mono text-xs text-primary"
          >[ SUMMARIZED OBJECTIVE ]</span
        >
        {objective.summaryText}
      </p>
    </div>
  </div>

  <div
    class="grid grid-cols-1 gap-4 md:grid-cols-[1fr_1fr] lg:grid-cols-[2fr_3fr]"
    data-mission-cards
  >
    <div
      class="mission-card group relative min-h-[400px] overflow-hidden rounded-2xl border border-border/50 bg-secondary lg:min-h-[600px] js:translate-y-12 js:scale-95 js:opacity-0"
    >
      <Image
        alt={objective.imagePrimary.alt || ""}
        src={sanityImage(objective.imagePrimary.url, { width: 1200 })}
        inferSize
        class="absolute top-0 left-0 h-full w-full object-cover grayscale transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-60"
      >
      </div>

      <div class="absolute bottom-0 left-0 z-10 w-full p-6 text-white md:p-8">
        <div
          class="flex items-end justify-between border-t border-white/20 pt-6"
        >
          <div>
            <h3
              class="mb-2 font-mono text-xs tracking-widest text-white/70 uppercase"
            >
              Objective
            </h3>
            <h1 class="font-sans text-3xl leading-none font-medium md:text-4xl">
              Uplifting professionalism
            </h1>
          </div>
          <IconArrowRight
            class="h-6 w-6 text-white/50 transition-colors group-hover:text-white"
          />
        </div>
      </div>
    </div>

    <div class="grid h-full grid-cols-1 gap-4 md:grid-cols-2">
      <div
        class="mission-card group flex min-h-[200px] flex-col justify-between rounded-2xl border border-border/50 bg-secondary p-6 transition-colors hover:border-foreground/20 md:p-8 js:translate-y-12 js:scale-95 js:opacity-0"
      >
        <div class="flex items-start justify-between">
          <IconPlus class="h-5 w-5 text-muted-foreground" />
          <span class="font-mono text-xs text-muted-foreground"
            >( {objective.metric1.name} )</span
          >
        </div>
        <div>
          <h3
            class="mb-2 font-sans text-5xl font-medium tracking-tight md:text-6xl"
          >
            {objective.metric1.value}
          </h3>
          <p
            class="font-mono text-xs tracking-wider text-muted-foreground uppercase"
          >
            {objective.metric1.subtitle}
          </p>
        </div>
      </div>

      <div
        class="mission-card group relative min-h-[200px] overflow-hidden rounded-2xl border border-border/50 bg-secondary js:translate-y-12 js:scale-95 js:opacity-0"
      >
        <Image
          alt={objective.imageSecondary.alt || ""}
          src={sanityImage(objective.imageSecondary.url, { width: 1000 })}
          inferSize
          class="absolute top-0 left-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
        <div
          class="absolute inset-0 bg-black/20 transition-colors group-hover:bg-transparent"
        >
        </div>
      </div>

      <div
        class="mission-card group flex min-h-[200px] flex-col justify-between rounded-2xl border border-border/50 bg-secondary p-6 transition-colors hover:border-foreground/20 md:p-8 js:translate-y-12 js:scale-95 js:opacity-0"
      >
        <div class="flex items-start justify-between">
          <IconPlus class="h-5 w-5 text-muted-foreground" />
          <span class="font-mono text-xs text-muted-foreground"
            >( {objective.metric2.name} )</span
          >
        </div>
        <div>
          <h3
            class="mb-2 font-sans text-5xl font-medium tracking-tight md:text-6xl"
          >
            {objective.metric2.value}
          </h3>
          <p
            class="font-mono text-xs tracking-wider text-muted-foreground uppercase"
          >
            {objective.metric2.subtitle}
          </p>
        </div>
      </div>

      <div
        class="mission-card relative col-span-1 min-h-[250px] overflow-hidden rounded-2xl border border-border/50 bg-black md:col-span-2 lg:col-span-1 xl:col-span-1 js:translate-y-12 js:scale-95 js:opacity-0"
      >
        <video
          autoplay
          class="js-mission-video absolute top-0 left-0 h-full w-full object-cover opacity-80"
          loop
          muted
          playsinline
        >
          <source src={objective.videoPrimary} type="video/mp4" />
        </video>
        <div class="absolute right-4 bottom-4 z-20">
          <button
            class="js-video-btn rounded-full border border-white/20 bg-white/10 p-2 backdrop-blur-md transition-all hover:bg-white hover:text-black"
            aria-label="Toggle Video Playback"
          >
            <span class="js-pause-icon block">
              <IconPlayerPause class="h-4 w-4" />
            </span>
            <span class="js-play-icon hidden">
              <IconPlayerPlay class="h-4 w-4" />
            </span>
          </button>
        </div>
      </div>
    </div>

    <div
      class="mission-card group relative flex min-h-[350px] items-center overflow-hidden rounded-2xl border border-border/50 bg-secondary md:col-span-2 lg:col-span-2 js:translate-y-12 js:scale-95 js:opacity-0"
    >
      <Image
        alt="Background"
        src={MissionPlaceholder3}
        width="1200"
        class="absolute top-0 left-0 h-full w-full object-cover object-[0%_30%] opacity-40 transition-opacity duration-700 group-hover:opacity-20"
      />
      <div
        class="absolute inset-0 z-0 bg-gradient-to-r from-black via-black/50 to-transparent"
      >
      </div>

      <div class="relative z-10 w-full p-8 text-white md:w-2/3 md:p-12">
        <div class="mb-6">
          <Badge class="border-white/30 font-mono capitalize">( Bylaws )</Badge>
        </div>
        <h3
          class="mb-6 font-sans text-3xl leading-tight font-light md:text-5xl"
        >
          By Laws of <span class="font-serif text-gray-400 italic">NSAE</span>
        </h3>
        <p
          class="mb-8 max-w-lg font-sans text-lg leading-relaxed text-gray-300"
        >
          {bylaws.description}
        </p>

        <a
          href={bylaws.file}
          target="_blank"
          class="group/btn flex items-center gap-4 font-mono text-xs tracking-widest uppercase transition-colors hover:text-primary"
        >
          Read the Full bylaws <IconArrowRight
            class="h-4 w-4 transition-transform group-hover/btn:translate-x-2"
          />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-section="mission-brief"]', ({ root, signal }) => {
    gsap
      .timeline({
        scrollTrigger: {
          trigger: ".mission-text",
          start: "top 80%",
          end: "top 50%",
          toggleActions: "play none none reverse",
        },
      })
      .to(".mission-text h1, .mission-text p", {
        y: 0,
        opacity: 1,
        duration: 1,
        stagger: 0.1,
        ease: "power3.out",
      });

    gsap
      .timeline({
        scrollTrigger: {
          trigger: "[data-mission-cards]",
          start: "top 85%",
          end: "top 60%",
          toggleActions: "play none none reverse",
        },
      })
      .to(".mission-card", {
        y: 0,
        opacity: 1,
        scale: 1,
        stagger: 0.15,
        duration: 0.8,
        ease: "power2.out",
      });

    const videoBtn = root.querySelector(".js-video-btn");
    const video = root.querySelector<HTMLVideoElement>(".js-mission-video");
    const pauseIcon = root.querySelector(".js-pause-icon");
    const playIcon = root.querySelector(".js-play-icon");

    if (videoBtn && video && pauseIcon && playIcon) {
      videoBtn.addEventListener(
        "click",
        () => {
          if (video.paused) {
            video.play();
            playIcon.classList.add("hidden");
            pauseIcon.classList.remove("hidden");
          } else {
            video.pause();
            playIcon.classList.remove("hidden");
            pauseIcon.classList.add("hidden");
          }
        },
        { signal },
      );
    }
  });
</script>
