---
import { Image } from "astro:assets";
import { IconArrowRight, IconPlus } from "@tabler/icons-astro";
import LifeMemberImg from "src/assets/pages/membership-placeholder-1.jpeg";
import GeneralMemberImg from "src/assets/pages/mission-placeholder-3.avif";
import type { Home } from "@/sanity/lib/queries/home";
import Badge from "../astro/Badge.astro";

const { membership } = Astro.props as {
  membership: Home["membership"];
};
---

<div
  id="cursor"
  class="pointer-events-none fixed top-0 left-0 z-[9999] hidden h-4 w-4 rounded-full bg-white opacity-0 mix-blend-difference transition-opacity duration-300 md:block"
>
</div>

<section
  class="relative min-h-screen cursor-none overflow-hidden bg-background text-foreground"
  id="membership-container"
  data-section="memberships"
>
  <div class="relative border-b border-border px-6 pt-32 pb-10 md:px-12">
    <div class="overflow-hidden">
      <h1
        class="reveal-text translate-y-full text-[12vw] leading-[0.85] font-black tracking-tighter text-foreground uppercase opacity-0"
      >
        Join
      </h1>
    </div>
    <div
      class="flex items-center justify-between gap-4 overflow-hidden md:gap-12"
    >
      <h1
        class="stroke-text reveal-text translate-y-full text-[12vw] leading-[0.85] font-black tracking-tighter text-transparent uppercase opacity-0"
      >
        Us
      </h1>
      <p
        class="reveal-opacity mt-4 hidden max-w-sm font-mono text-sm leading-relaxed text-muted-foreground opacity-0 md:block md:text-base"
      >
        [ EST. 1990 ] <br />
        We are an enclave of thinkers and doers. Select your level of access to the
        collective.
      </p>
    </div>
  </div>

  <div class="relative grid min-h-screen grid-cols-1 lg:grid-cols-2">
    <div
      class="absolute top-0 bottom-0 left-1/2 z-10 hidden w-[1px] origin-top scale-y-0 bg-border lg:block"
      id="center-line"
    >
    </div>

    <div
      class="group hover-trigger relative flex h-[80vh] translate-y-20 flex-col justify-between border-b border-border bg-background p-6 opacity-0 md:p-12 lg:h-auto lg:border-b-0"
    >
      <div
        class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-700 ease-out group-hover:opacity-10"
      >
        <Image
          src={GeneralMemberImg}
          alt=""
          class="h-full w-full object-cover grayscale"
        />
      </div>

      <div class="relative z-10">
        <div class="mb-20 flex items-center justify-between">
          <span class="font-mono text-xs text-muted-foreground md:text-sm"
            >( 01 )</span
          >
          <Badge
            class="rounded-full border px-3 py-1 font-mono text-xs md:text-sm"
          >
            ANNUAL
          </Badge>
        </div>

        <h2
          class="mb-6 border-b border-border pb-6 text-5xl font-medium tracking-tight md:text-7xl"
        >
          General<br />Membership
        </h2>

        <ul class="space-y-4 font-mono text-sm text-muted-foreground">
          {
            membership.general.benefits.map((benefit) => (
              <li class="flex items-center gap-3">
                <IconPlus class="h-3 w-3" />
                {benefit}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="relative z-10 pt-12">
        <a
          href={membership.general.joinUrl}
          target="_blank"
          class="inline-flex items-center gap-4 text-lg tracking-widest text-foreground uppercase transition-all duration-500 group-hover:text-primary hover:gap-8"
        >
          Join Us <IconArrowRight class="h-5 w-5" />
        </a>
      </div>
    </div>

    <div
      class="group hover-trigger relative h-[80vh] translate-y-20 overflow-hidden bg-black p-0 opacity-0 lg:h-auto"
    >
      <div class="absolute inset-0 h-full w-full overflow-hidden">
        <Image
          src={LifeMemberImg}
          alt="Life Member"
          width={1200}
          class="h-full w-full object-cover opacity-60 grayscale transition-transform duration-1000 ease-[0.25,1,0.5,1] group-hover:scale-110 group-hover:grayscale-0"
        />
        <div
          class="absolute inset-0 bg-black/40 transition-colors duration-700 group-hover:bg-black/60"
        >
        </div>
      </div>

      <div
        class="relative z-10 flex h-full flex-col justify-between p-6 text-white md:p-12"
      >
        <div class="flex items-center justify-between">
          <span
            class="font-mono text-xs text-white/80 mix-blend-difference md:text-sm"
          >
            ( 02 )
          </span>
          <span
            class="rounded-full border-none bg-primary px-3 py-1 font-mono text-xs font-bold text-primary-foreground md:text-sm"
          >
            LIFETIME
          </span>
        </div>

        <div
          class="transition-all duration-700 ease-out lg:translate-y-8 lg:opacity-0 lg:group-hover:translate-y-0 lg:group-hover:opacity-100"
        >
          <h2
            class="mb-2 text-5xl font-medium tracking-tight text-white mix-blend-difference md:text-7xl"
          >
            Life Membership
          </h2>
          <p
            class="max-w-md text-lg leading-relaxed text-gray-300 mix-blend-difference"
          >
            Be a part of NSAE as Permanent member for developing agricultural
            engineering profession.
          </p>
          <ul class="space-y-4 pt-4 font-mono text-sm text-gray-300 uppercase">
            {
              membership.lifetime.benefits.map((benefit) => (
                <li class="flex items-center gap-3">
                  <IconPlus class="h-3 w-3" />
                  {benefit}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex items-end justify-end">
          <div
            class="ease-back-out relative m-4 flex scale-100 items-center justify-center transition-transform duration-500 group-hover:scale-100 lg:scale-0"
          >
            <div
              class="animate-spin-slow pointer-events-none absolute h-32 w-32 select-none"
            >
              <svg viewBox="0 0 100 100" class="h-full w-full overflow-visible">
                <path
                  id="circlePath"
                  d="M 50, 50 m -36, 0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0"
                  fill="none"></path>
                <text
                  class="fill-white font-mono text-[9.5px] font-bold tracking-[0.2em] uppercase"
                >
                  <textPath href="#circlePath" startOffset="0%">
                    Join Us • Join Us • Join Us •
                  </textPath>
                </text>
              </svg>
            </div>

            <a
              href={membership.lifetime.joinUrl}
              target="_blank"
              class="relative z-10 flex h-16 w-16 items-center justify-center rounded-full bg-primary text-primary-foreground transition-transform duration-300 hover:scale-110"
            >
              <IconArrowRight class="h-6 w-6 -rotate-45" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    class="flex overflow-hidden border-t border-border bg-background py-6 whitespace-nowrap"
  >
    <div
      class="animate-marquee flex items-center gap-12 font-mono text-sm text-muted-foreground uppercase"
    >
      <span>Legacy Defined</span>
      <span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span>
      <span>Uncompromising Quality</span>
      <span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span>
      <span>Global Community</span>
      <span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span>
      <span>Legacy Defined</span>
      <span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span>
      <span>Uncompromising Quality</span>
      <span class="h-2 w-2 rounded-full bg-muted-foreground/30"></span>
      <span>Global Community</span>
    </div>
  </div>
</section>

<style>
  .stroke-text {
    -webkit-text-stroke: 1px black;
    color: transparent;
  }
  :global(.dark) .stroke-text {
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.8);
  }
  .ease-back-out {
    transition-timing-function: cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .animate-marquee {
    animation: marquee 20s linear infinite;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  .animate-spin-slow {
    animation: spin 12s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
</style>
<script>
  import { gsap } from "@/utils/gsap-init";
  import { onPage } from "@/utils/page-script";

  onPage('[data-section="memberships"]', ({ root: section, signal }) => {
    // The custom cursor sits outside the section (it is position: fixed).
    const cursor = document.getElementById("cursor");

    if (cursor) {
      gsap.set(cursor, { xPercent: -50, yPercent: -50 });

      window.addEventListener(
        "mousemove",
        (e) => {
          gsap.to(cursor, {
            x: e.clientX,
            y: e.clientY,
            duration: 0.1,
            ease: "power2.out",
            overwrite: "auto",
          });
        },
        { signal },
      );

      section.addEventListener(
        "mouseenter",
        () =>
          gsap.to(cursor, { autoAlpha: 1, duration: 0.2, ease: "power2.out" }),
        { signal },
      );
      section.addEventListener(
        "mouseleave",
        () =>
          gsap.to(cursor, { autoAlpha: 0, duration: 0.2, ease: "power2.out" }),
        { signal },
      );

      section.querySelectorAll(".hover-trigger").forEach((trigger) => {
        trigger.addEventListener(
          "mouseenter",
          () => gsap.to(cursor, { scale: 4, duration: 0.3 }),
          { signal },
        );
        trigger.addEventListener(
          "mouseleave",
          () => gsap.to(cursor, { scale: 1, duration: 0.3 }),
          { signal },
        );
      });
    }

    gsap
      .timeline({
        scrollTrigger: {
          trigger: section,
          start: "top 50%",
          toggleActions: "play none none reverse",
        },
      })
      .to(".reveal-text", {
        y: 0,
        opacity: 1,
        duration: 1.2,
        stagger: 0.1,
        ease: "power4.out",
      })
      .to(
        ".reveal-opacity",
        { opacity: 1, duration: 1, ease: "power2.out" },
        "-=0.8",
      )
      .to(
        "#center-line",
        { scaleY: 1, duration: 1.2, ease: "power3.inOut" },
        "-=0.5",
      );

    gsap
      .timeline({
        scrollTrigger: {
          trigger: ".grid.grid-cols-1.lg\\:grid-cols-2",
          start: "top 95%",
          end: "top 70%",
          toggleActions: "play none none reverse",
        },
      })
      .to(".hover-trigger", {
        y: 0,
        opacity: 1,
        stagger: 0.2,
        duration: 1,
        ease: "power3.out",
      });
  });
</script>
