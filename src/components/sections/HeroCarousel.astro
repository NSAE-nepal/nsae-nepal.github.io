---
import { Image } from "astro:assets";
import {
  IconArrowDown,
  IconChevronLeft,
  IconChevronRight,
} from "@tabler/icons-astro";
import Badge from "../astro/Badge.astro";
import Button from "../astro/Button/Button.astro";
import { sanityImage } from "@/sanity/lib/url-for-image";

export interface HeroSlide {
  image: string;
  alt: string;
}

interface Props {
  slides: HeroSlide[];
  autoplayDelay?: number;
  regdNumber?: string;
  title?: string;
  badgeLabel?: string;
  subtitleLines?: string[];
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  exploreHref?: string;
}

const {
  slides,
  autoplayDelay = 4000,
  regdNumber = "Regd.No.29/046/047",
  title = "NSAE",
  badgeLabel = "EST. 1990",
  subtitleLines = ["Nepalese Society of", "Agricultural Engineers"],
  description = "NSAE connects leading engineers, scientists, and students dedicated to creating practical solutions for real‑world agricultural challenges.",
  ctaLabel = "Get in Touch",
  ctaHref = "/contact",
  exploreHref = "#mission-brief",
} = Astro.props;
---

<section
  class="home-hero-section invisible relative flex min-h-[85vh] items-center overflow-hidden rounded-2xl px-6 py-20 md:px-12 md:py-32"
  data-hero-carousel
  data-section="hero"
  data-autoplay-delay={autoplayDelay}
>
  <div
    class="home-hero-redg-text absolute top-42 left-6 z-20 hidden -translate-y-4 opacity-0 md:left-12 md:block"
  >
    <span
      class="vertical-lr font-mono text-sm tracking-widest text-white/60 uppercase"
    >
      [ {regdNumber} ]
    </span>
  </div>

  <div
    class="home-hero-text relative z-20 mt-22 flex max-w-5xl flex-col gap-8 md:gap-10"
  >
    <h2
      class="font-sans text-[3.5rem] leading-[0.9] font-medium tracking-tighter text-white md:text-[7rem]"
    >
      <div class="relative inline-block">
        <div class="inline-block overflow-hidden pb-4 align-bottom">
          <span
            class="engineering-text-anim invisible inline-block font-bold italic underline decoration-white/30 decoration-2 underline-offset-12"
          >
            {title}
          </span>
        </div>
        <Badge
          class="badge-anim-wrapper absolute -top-8 -right-24 rotate-12 border-white/40 font-mono text-xs tracking-wide opacity-0"
          size="sm"
        >
          {badgeLabel}
        </Badge>
      </div>

      {
        subtitleLines.map((line) => (
          <>
            <br />
            <span class="subtitle-lines invisible inline-block pb-3 text-white/80">
              {line}
            </span>
          </>
        ))
      }
    </h2>

    <p
      class="hero-desc-anim max-w-xl translate-y-4 font-sans text-lg leading-relaxed text-white/70 opacity-0"
    >
      {description}
    </p>

    <div
      class="hero-actions-anim dark mt-4 flex translate-y-4 items-center gap-6 opacity-0"
    >
      <Button
        href={ctaHref}
        size={"lg"}
        class="rounded-full px-8 py-4 font-sans font-medium"
      >
        {ctaLabel}
      </Button>

      <a
        href={exploreHref}
        class="flex items-center gap-2 font-mono text-sm tracking-widest text-white/60 uppercase transition-colors hover:text-white"
      >
        ( Explore ) <IconArrowDown class="h-3 w-3" />
      </a>
    </div>
  </div>

  <div
    class="scroll-indicator absolute right-12 bottom-10 z-20 hidden items-center gap-4 opacity-0 md:flex"
  >
    <span class="font-mono text-sm text-white/50 uppercase">
      Scroll to explore
    </span>
    <div class="scroll-line h-[1px] w-0 bg-white/30"></div>
  </div>

  <div class="absolute inset-0 z-10">
    <div
      class="absolute inset-0 z-20 rounded-2xl bg-linear-to-r from-black/80 via-black/50 to-transparent"
    >
    </div>

    <div
      class="hero-image-wrapper absolute inset-0 z-10 rounded-2xl bg-black/40"
    >
    </div>

    {
      slides.map((slide, index) => (
        <div
          class="hero-carousel-slide absolute inset-0 will-change-[opacity]"
          data-index={index}
          style={`opacity:${index === 0 ? 1 : 0}; z-index:${index === 0 ? 1 : 0};`}
        >
          <Image
            class="hero-image-anim absolute inset-0 h-full w-full scale-110 rounded-2xl object-cover will-change-transform"
            alt={slide.alt}
            inferSize
            src={sanityImage(slide.image, { width: 2000 })}
            widths={[640, 1024, 1600, 2000]}
            sizes="100vw"
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
            decoding="async"
          />
        </div>
      ))
    }

    {
      slides.length > 1 && (
        <div class="hero-carousel-controls absolute bottom-8 left-1/2 z-30 flex -translate-x-1/2 gap-4 md:right-12 md:bottom-0 md:left-auto md:translate-x-0">
          <button
            type="button"
            class="hero-carousel-prev inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-white/20 bg-black/20 text-white transition-colors hover:bg-black/40"
            aria-label="Previous slide"
          >
            <IconChevronLeft class="h-4 w-4" />
          </button>
          <button
            type="button"
            class="hero-carousel-next inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-white/20 bg-black/20 text-white transition-colors hover:bg-black/40"
            aria-label="Next slide"
          >
            <IconChevronRight class="h-4 w-4" />
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion, SplitText } from "@/utils/gsap-init";
  import { onPage, type PageScope } from "@/utils/page-script";

  function initCarousel({ root: section, signal, onCleanup }: PageScope) {
    const reduceMotion = prefersReducedMotion();
    const slides = Array.from(
      section.querySelectorAll<HTMLElement>(".hero-carousel-slide"),
    );
    if (slides.length === 0) return;

    const images = slides.map((slide) =>
      slide.querySelector<HTMLImageElement>(".hero-image-anim"),
    );
    const prevBtn = section.querySelector<HTMLButtonElement>(
      ".hero-carousel-prev",
    );
    const nextBtn = section.querySelector<HTMLButtonElement>(
      ".hero-carousel-next",
    );
    const delay = Number(section.dataset.autoplayDelay) || 4000;
    const revealDuration = Math.max(delay / 1000 + 2, 4);

    let current = 0;
    let timerId: ReturnType<typeof setInterval> | undefined;

    function showSlide(targetIndex: number) {
      const nextIndex =
        ((targetIndex % slides.length) + slides.length) % slides.length;
      if (nextIndex === current) return;

      const outgoing = slides[current];
      const incoming = slides[nextIndex];
      const incomingImg = images[nextIndex];

      gsap.set(incoming, { zIndex: 1 });
      gsap.set(outgoing, { zIndex: 0 });

      if (reduceMotion) {
        gsap.set(outgoing, { opacity: 0 });
        gsap.set(incoming, { opacity: 1 });
      } else {
        gsap.to(outgoing, { opacity: 0, duration: 1, ease: "power2.inOut" });
        gsap.to(incoming, { opacity: 1, duration: 1, ease: "power2.inOut" });

        if (incomingImg) {
          gsap.fromTo(
            incomingImg,
            { scale: 1.1 },
            { scale: 1, duration: revealDuration, ease: "expo.out" },
          );
        }
      }

      current = nextIndex;
    }

    const next = () => showSlide(current + 1);
    const prev = () => showSlide(current - 1);

    function stopAutoplay() {
      clearInterval(timerId);
      timerId = undefined;
    }
    function startAutoplay() {
      stopAutoplay();
      if (slides.length > 1 && !reduceMotion) {
        timerId = setInterval(next, delay);
      }
    }

    nextBtn?.addEventListener(
      "click",
      () => {
        next();
        startAutoplay();
      },
      { signal },
    );
    prevBtn?.addEventListener(
      "click",
      () => {
        prev();
        startAutoplay();
      },
      { signal },
    );
    section.addEventListener("mouseenter", stopAutoplay, { signal });
    section.addEventListener("mouseleave", startAutoplay, { signal });

    if (images[0] && !reduceMotion) {
      gsap.fromTo(
        images[0],
        { scale: 1.1 },
        { scale: 1, duration: revealDuration, ease: "expo.out", delay: 0.2 },
      );
    }

    startAutoplay();
    onCleanup(stopAutoplay);
  }

  onPage('[data-section="hero"]', (scope) => {
    const { root } = scope;
    gsap.set(root, { autoAlpha: 1 });

    const subtitleInner = SplitText.create(".subtitle-lines", {
      type: "lines",
      linesClass: "line-inner will-change-transform",
    });

    const tl = gsap.timeline({
      defaults: { ease: "power3.out" },
      scrollTrigger: {
        trigger: root,
        start: "top 75%",
        end: "top 20%",
        toggleActions: "play none none reverse",
      },
    });

    tl.to(
      ".home-hero-redg-text",
      { y: 0, opacity: 1, duration: 1.5, ease: "power3.out" },
      0.2,
    );

    tl.set(".engineering-text-anim", { autoAlpha: 1 }, 0.3);
    tl.from(
      ".engineering-text-anim",
      {
        yPercent: 100,
        rotation: 2,
        opacity: 0,
        duration: 1.2,
        ease: "power4.out",
      },
      0.3,
    );

    tl.to(
      ".badge-anim-wrapper",
      {
        opacity: 1,
        scale: 1,
        rotation: 12,
        startAt: { scale: 0, rotation: 0 },
        duration: 0.8,
        ease: "back.out(1.7)",
      },
      0.8,
    );

    tl.set(".subtitle-lines", { autoAlpha: 1 }, 0.5);
    tl.from(
      subtitleInner.lines,
      {
        yPercent: 100,
        opacity: 0,
        duration: 1.1,
        stagger: 0.1,
        ease: "power4.out",
      },
      0.5,
    );

    tl.to(
      [".hero-desc-anim", ".hero-actions-anim"],
      { y: 0, opacity: 1, stagger: 0.1, duration: 0.5 },
      "-=1",
    );
    tl.to(".scroll-indicator", { opacity: 1, duration: 1 }, "-=1");
    tl.to(
      ".scroll-line",
      { width: 48, duration: 1, ease: "expo.out" },
      "-=0.5",
    );

    gsap.to(".hero-image-anim", {
      yPercent: 20,
      ease: "none",
      scrollTrigger: {
        trigger: root,
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });

    initCarousel(scope);
  });
</script>
