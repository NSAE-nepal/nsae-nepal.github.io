---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import "@/utils/animations/cards-split-text-animation.css";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { sanityImage } from "@/sanity/lib/url-for-image";
import FallbackImage from "../assets/nsae-logo.png";
import { SITE_TITLE } from "../consts";

interface Props {
  title: string;
  description: string;
  /** Local image, or a remote (Sanity CDN) image URL such as a post's hero image. */
  image?: ImageMetadata | string;
  type?: "website" | "article";
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title: pageTitle,
  description,
  image = FallbackImage,
  type = "website",
} = Astro.props;

const title =
  pageTitle === SITE_TITLE || pageTitle.endsWith(`| ${SITE_TITLE}`)
    ? pageTitle
    : `${pageTitle} | ${SITE_TITLE}`;

// Social previews: crop remote images to the 1.91:1 card size; downscale local ones.
const socialImage =
  typeof image === "string"
    ? new URL(sanityImage(image, { width: 1200, height: 630 }), Astro.url)
    : new URL(
        (await getImage({ src: image, width: 600, format: "png" })).src,
        Astro.url,
      );
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preload (regular only; italic is rarely above the fold) -->
<link
  rel="preload"
  href="/fonts/SourceSans3-VariableFont_wght.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<script>
  import Lenis from "lenis";
  import { gsap, ScrollTrigger } from "@/utils/gsap-init";

  let lenis: Lenis | null = null;

  // A single, stable callback so it can actually be removed again.
  // GSAP's ticker reports seconds; Lenis expects milliseconds.
  const raf = (time: number) => lenis?.raf(time * 1000);

  function lenisScroll() {
    if (lenis) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    lenis = new Lenis();
    lenis.on("scroll", ScrollTrigger.update);
    gsap.ticker.add(raf);
    gsap.ticker.lagSmoothing(0);
  }

  function cleanup() {
    ScrollTrigger.getAll().forEach((t) => t.kill());
    gsap.ticker.remove(raf);
    lenis?.destroy();
    lenis = null;
  }

  lenisScroll();
  document.addEventListener("astro:before-swap", cleanup);
  document.addEventListener("astro:after-swap", lenisScroll);
</script>

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };

  window.__applyTheme = () => {
    const isDark = getThemePreference() === "dark";
    document.documentElement.classList[isDark ? "add" : "remove"]("dark");
  };

  window.__applyTheme();
</script>

<script is:inline>
  document.addEventListener("astro:after-swap", () => {
    window.__applyTheme?.();
  });
</script>
