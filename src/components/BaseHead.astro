---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import "lenis/dist/lenis.css";
import "@/utils/animations/cards-split-text-animation.css";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { sanityImage } from "@/sanity/lib/url-for-image";
import { SITE_TITLE } from "../consts";

/** Generated by src/pages/og/[...path].png.ts. */
const SITE_CARD = "/og/site.png";

interface Props {
  title: string;
  description: string;
  /**
   * Social preview image: a local import, a Sanity CDN URL (e.g. a post's
   * hero image) or a generated /og/... card. Defaults to the site card.
   */
  image?: ImageMetadata | string;
  /** Alt text for the social image; defaults to the page title. */
  imageAlt?: string;
  type?: "website" | "article" | "profile";
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title: pageTitle,
  description,
  image = SITE_CARD,
  imageAlt,
  type = "website",
} = Astro.props;

const title =
  pageTitle === SITE_TITLE || pageTitle.endsWith(`| ${SITE_TITLE}`)
    ? pageTitle
    : `${pageTitle} | ${SITE_TITLE}`;

// Social previews: remote images are cropped to the 1.91:1 card size (the
// generated /og/ cards already are); local ones are downscaled.
let socialImage: URL;
let socialWidth = 1200;
let socialHeight = 630;
if (typeof image === "string") {
  socialImage = new URL(
    sanityImage(image, { width: socialWidth, height: socialHeight }),
    Astro.url,
  );
} else {
  const local = await getImage({
    src: image,
    width: Math.min(image.width, 1200),
    format: "png",
  });
  socialImage = new URL(local.src, Astro.url);
  socialWidth = Number(local.attributes.width);
  socialHeight = Number(local.attributes.height);
}
const socialImageAlt =
  imageAlt ||
  (image === SITE_CARD
    ? "NSAE, the Nepalese Society of Agricultural Engineers"
    : pageTitle);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preload (regular only; italic is rarely above the fold) -->
<link
  rel="preload"
  href="/fonts/SourceSans3-VariableFont_wght.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

<!--
  Content waiting for a GSAP entrance animation is hidden with `js:` classes
  (js:opacity-0, js:invisible, js:translate-y-4, …), which only apply once
  this marks <html class="js">, so without JavaScript nothing is hidden. If
  the animations haven't started 3 s after a page loads (onPage() sets
  html.anim-ready), or a script fails to load, html.no-anim reveals it all.
-->
<script is:inline>
  (() => {
    const html = document.documentElement;
    let timer;
    const arm = () => {
      html.classList.add("js");
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (
          !html.classList.contains("anim-ready") &&
          document.querySelector('[class*="js:"]')
        ) {
          html.classList.add("no-anim");
        }
      }, 3000);
    };
    arm();
    // ClientRouter copies <html> attributes from the next page on each swap.
    document.addEventListener("astro:after-swap", arm);
    // A script that fails to load, e.g. the GSAP chunk.
    addEventListener(
      "error",
      (event) => {
        if (event.target instanceof HTMLScriptElement) {
          html.classList.add("no-anim");
        }
      },
      true,
    );
  })();
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content={String(socialWidth)} />
<meta property="og:image:height" content={String(socialHeight)} />
<meta property="og:image:alt" content={socialImageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />

<script>
  import { ScrollTrigger } from "@/utils/gsap-init";
  import { destroyLenis, startLenis } from "@/utils/lenis";

  function cleanup() {
    // Safety net: every page script reverts its own context through onPage(),
    // which kills its ScrollTriggers. This catches any that slipped past (a
    // script outside onPage, or one that threw) before the DOM is swapped.
    ScrollTrigger.getAll().forEach((t) => t.kill());
    destroyLenis();
  }

  startLenis();
  document.addEventListener("astro:before-swap", cleanup);
  document.addEventListener("astro:after-swap", startLenis);
</script>

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };

  window.__applyTheme = () => {
    const isDark = getThemePreference() === "dark";
    document.documentElement.classList[isDark ? "add" : "remove"]("dark");
  };

  window.__applyTheme();
</script>

<script is:inline>
  document.addEventListener("astro:after-swap", () => {
    window.__applyTheme?.();
  });
</script>
