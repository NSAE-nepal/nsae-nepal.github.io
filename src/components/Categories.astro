---
import { IconPoint } from "@tabler/icons-astro";
import { categoryPath, categorySlug } from "@/lib/categories";
import type { Category } from "@/sanity/lib/queries/posts";
import type { BadgeVariantProps } from "./astro/Badge.astro";
import Badge from "./astro/Badge.astro";

type BadgeVariant = BadgeVariantProps["variant"];
type BadgeSize = BadgeVariantProps["size"];

type Props = {
  categories: Category[];
  visibleCategoriesCount?: number;
  showAll?: boolean;
  badgeVariant?: BadgeVariant;
  badgeSize?: BadgeSize;
  /** Section listing ("/blog", "/notices"); when set, badges link to that section's category page. */
  basePath?: string;
};

const {
  categories,
  visibleCategoriesCount = 3,
  showAll = false,
  badgeVariant = "secondary",
  badgeSize = "xs",
  basePath,
} = Astro.props;

const totalCount = categories.length;

const categoriesToDisplay = showAll
  ? categories
  : categories.slice(0, visibleCategoriesCount);
const shouldShowBadge = !showAll && totalCount > visibleCategoriesCount;
const remainingCount = totalCount - visibleCategoriesCount;
---

<div class="flex flex-row gap-2 font-mono flex-wrap">
  {
    categoriesToDisplay.map((item) => {
      const badge = (
        <Badge variant={badgeVariant} size={badgeSize} class="capitalize">
          <IconPoint class="fill-destructive text-destructive w-4 h-4" />
          {item.title}
        </Badge>
      );
      const slug = item?.title ? categorySlug(item) : "";
      return basePath && slug ? (
        <a
          href={categoryPath(basePath, slug)}
          class="rounded-full transition-opacity hover:opacity-80"
          aria-label={`More in ${item.title}`}
        >
          {badge}
        </a>
      ) : (
        badge
      );
    })
  }
  {
    shouldShowBadge && (
      <span class="text-xs bg-secondary text-secondary-foreground border rounded-3xl px-2 py-1 capitalize">
        +{remainingCount}
      </span>
    )
  }
</div>
